 ("SELECT hex(root) FROM p_segdir;" :rows ("hex(root)")
  (("0007636F6E6E6563740401060300000372616E030105000102756E040102030003036E657203010400")))
)
("fts3.test:fts4-errors"
 ("CREATE VIRTUAL TABLE t USING fts4(a, order=sideways);" :error "unrecognized order: sideways")
 ("CREATE VIRTUAL TABLE t USING fts4(a, foo=bar);" :error "unrecognized parameter: foo=bar")
 ("CREATE VIRTUAL TABLE t USING fts4(a, notindexed=zz);" :error "no such column: zz")
 ("CREATE VIRTUAL TABLE t USING fts4(a, prefix='x');" :error "error parsing prefix parameter: x")
 ("CREATE VIRTUAL TABLE t USING fts4(a, compress=zip);" :error "missing uncompress parameter in fts4 constructor")
 ("CREATE VIRTUAL TABLE t USING fts4(a, matchinfo=fts5);" :error "unrecognized matchinfo: fts5")
 ("CREATE VIRTUAL TABLE t USING fts3(a, prefix=2);" :ok)
 ("PRAGMA table_info(t);" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk")
  ((0 "a" "" 0 :null 0)
   (1 "prefix" "" 0 :null 0)))
 ("CREATE VIRTUAL TABLE t2 USING fts4;" :ok)
 ("PRAGMA table_info(t2);" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk")
  ((0 "content" "" 0 :null 0)))
 ("CREATE VIRTUAL TABLE t3 USING fts4(\"a b\" TEXT, [c d], 'e f');" :ok)
 ("PRAGMA table_info(t3);" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk")
  ((0 "a b" "" 0 :null 0)
   (1 "c d" "" 0 :null 0)
   (2 "e f" "" 0 :null 0)))
 ("SELECT sql FROM sqlite_master WHERE name='t3_content';" :rows ("sql")
  (("CREATE TABLE 't3_content'(docid INTEGER PRIMARY KEY, 'c0a b', 'c1c d', 'c2e f')")))
 ("INSERT INTO t2(t2) VALUES('nonsense');" :error "SQL logic error")
 ("INSERT INTO t2(t2) VALUES('merge=');" :error "SQL logic error")
 ("INSERT INTO t2(t2) VALUES('merge=5,1');" :error "SQL logic error")
 ("INSERT INTO t2(content, __langid) VALUES('x', -1);" :error "constraint failed")
 ("INSERT INTO t2(docid, content) VALUES(1, 'a');" :ok)
 ("INSERT INTO t2(docid, content) VALUES(1, 'b');" :error "constraint failed")
 ("INSERT OR IGNORE INTO t2(docid, content) VALUES(1, 'b');" :ok)
 ("INSERT OR REPLACE INTO t2(docid, content) VALUES(1, 'c');" :ok)
 ("SELECT docid, content FROM t2;" :rows ("docid" "content")
  ((1 "c")))
 ("INSERT INTO t2(rowid, content) VALUES('abc', 'x');" :error "datatype mismatch")
 ("INSERT INTO t2(docid, content) VALUES(2.5, 'x');" :error "datatype mismatch")
 ("INSERT INTO t2(docid, content) VALUES('7', 'x');" :ok)
 ("INSERT INTO t2(rowid, docid, content) VALUES(8, 9, 'x');" :error "SQL logic error")
 ("SELECT docid, content FROM t2;" :rows ("docid" "content")
  ((1 "c")
   (7 "x")))
 ("SELECT offsets(1);" :error "unable to use function offsets in the requested context")
 ("SELECT matchinfo(1, 2);" :error "unable to use function matchinfo in the requested context")
 ("SELECT docid FROM t2 WHERE content MATCH 'x' AND t2 MATCH 'c';" :error "unable to use function MATCH in the requested context")
)
("fts3.test:fts4-merge-basic"
 ("CREATE VIRTUAL TABLE t USING fts4(a);" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<25) INSERT INTO t SELECT 'banana delta epsilon mango eta omega delta' || ' w' || (i*3 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<37) INSERT INTO t SELECT 'gamma zeta date cherry epsilon pi zeta date delta' || ' w' || (i*4 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<57) INSERT INTO t SELECT 'omicron delta banana delta omicron gamma' || ' w' || (i*5 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<40) INSERT INTO t SELECT 'tau cherry kappa mango theta upsilon mu' || ' w' || (i*6 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<11) INSERT INTO t SELECT 'omega eta epsilon delta xi honeydew mango date phi' || ' w' || (i*7 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<34) INSERT INTO t SELECT 'omega upsilon pi mu pi zeta upsilon lemon honeydew chi elder tau epsilon theta kiwi cherry lambda' || ' w' || (i*8 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<53) INSERT INTO t SELECT 'kappa honeydew cherry gamma epsilon phi chi psi honeydew fig epsilon zeta sigma' || ' w' || (i*9 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<35) INSERT INTO t SELECT 'delta upsilon elder tau apple' || ' w' || (i*10 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<47) INSERT INTO t SELECT 'beta fig psi lambda theta honeydew delta xi tau iota pi banana banana honeydew' || ' w' || (i*11 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<10) INSERT INTO t SELECT 'elder banana sigma iota date sigma cherry psi' || ' w' || (i*12 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<48) INSERT INTO t SELECT 'omicron kappa zeta mu kappa omicron omicron alpha honeydew mu rho tau alpha kappa cherry' || ' w' || (i*13 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<39) INSERT INTO t SELECT 'phi iota kiwi delta fig banana banana banana banana eta grape banana delta nu' || ' w' || (i*14 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<9) INSERT INTO t SELECT 'elder lambda theta chi delta eta alpha kappa mango' || ' w' || (i*15 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<11) INSERT INTO t SELECT 'beta epsilon xi apple kappa rho psi omega grape theta theta honeydew fig grape' || ' w' || (i*16 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<35) INSERT INTO t SELECT 'zeta kappa eta chi rho grape lambda lemon beta xi lemon omega' || ' w' || (i*17 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<14) INSERT INTO t SELECT 'beta lemon upsilon zeta rho lemon omega lambda psi omicron mango mango kiwi chi omicron nu pi banana omicron nu' || ' w' || (i*18 % 50) FROM c;" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<38) INSERT INTO t SELECT 'psi beta beta sigma grape rho nu psi elder psi omega zeta omicron eta omicron grape nu chi' || ' w' || (i*19 % 50) FROM c;" :ok)
