)
("json.test:json-extract"
 ("SELECT json_extract('{\"a\":{\"b\":[10,20,{\"c\":\"x\"}]}}', '$.a.b[2].c'), json_extract('[1,2,3]', '$[#-1]'), json_extract('{\"a\":1}', '$.x');" :rows ("json_extract('{\"a\":{\"b\":[10,20,{\"c\":\"x\"}]}}', '$.a.b[2].c')" "json_extract('[1,2,3]', '$[#-1]')" "json_extract('{\"a\":1}', '$.x')")
  (("x" 3 :null)))
 ("SELECT json_extract('{\"a\":1.5,\"b\":\"s\",\"c\":null,\"d\":true,\"e\":[1]}', '$.a', '$.b', '$.c', '$.d', '$.e');" :rows ("json_extract('{\"a\":1.5,\"b\":\"s\",\"c\":null,\"d\":true,\"e\":[1]}', '$.a', '$.b', '$.c', '$.d', '$.e')")
  (("[1.5,\"s\",null,true,[1]]")))
 ("SELECT json_extract('{\"a\":-0}', '$.a'), json_extract('{\"a\":12345678901234567890}', '$.a'), json_extract('{\"a b\":1}', '$.\"a b\"');" :rows ("json_extract('{\"a\":-0}', '$.a')" "json_extract('{\"a\":12345678901234567890}', '$.a')" "json_extract('{\"a b\":1}', '$.\"a b\"')")
  ((0 (:f "1.2345678901234567e+19") 1)))
 ("SELECT json_extract('\"é\\/\"', '$'), typeof(json_extract('{\"a\":[]}', '$.a')), json_extract('{\"a\":true}', '$.a'), json_extract('[[1]]', '$[0][0]');" :rows ("json_extract('\"é\\/\"', '$')" "typeof(json_extract('{\"a\":[]}', '$.a'))" "json_extract('{\"a\":true}', '$.a')" "json_extract('[[1]]', '$[0][0]')")
  (("é/" "text" 1 1)))
 ("SELECT json_extract('{\"a\":1,\"a\":2}', '$.a'), json('{\"a\":1,\"a\":2}');" :rows ("json_extract('{\"a\":1,\"a\":2}', '$.a')" "json('{\"a\":1,\"a\":2}')")
  ((1 "{\"a\":1,\"a\":2}")))
 ("SELECT json_extract('[1]', 'a');" :error "JSON path error near 'a'")
 ("SELECT '{\"a\":[1,2]}' -> '$.a', '{\"a\":[1,2]}' ->> 'a', '[5,6]' -> 1, '{\"a\":\"x\"}' -> 'a', '{\"a\":\"x\"}' ->> 'a', '{\"a\":{\"b\":3}}' -> 'a' ->> 'b';" :rows ("'{\"a\":[1,2]}' -> '$.a'" "'{\"a\":[1,2]}' ->> 'a'" "'[5,6]' -> 1" "'{\"a\":\"x\"}' -> 'a'" "'{\"a\":\"x\"}' ->> 'a'" "'{\"a\":{\"b\":3}}' -> 'a' ->> 'b'")
  (("[1,2]" "[1,2]" "6" "\"x\"" "x" 3)))
)
("json.test:json-build"
 ("SELECT json_array(1, 'x', NULL, 2.5, json('[3]'), '[4]'), json_object('a', 1, 'b', json_array(2)), json_object('k', 1.0), json_array(1e100, -0.0, 0.1);" :rows ("json_array(1, 'x', NULL, 2.5, json('[3]'), '[4]')" "json_object('a', 1, 'b', json_array(2))" "json_object('k', 1.0)" "json_array(1e100, -0.0, 0.1)")
  (("[1,\"x\",null,2.5,[3],\"[4]\"]" "{\"a\":1,\"b\":[2]}" "{\"k\":1.0}" "[1.0e+100,0.0,0.1]")))
 ("SELECT json_array(json_extract('{\"a\":[1]}', '$.a')), json_array('{\"a\":1}' -> '$'), json_object('n', json('null'));" :rows ("json_array(json_extract('{\"a\":[1]}', '$.a'))" "json_array('{\"a\":1}' -> '$')" "json_object('n', json('null'))")
  (("[[1]]" "[{\"a\":1}]" "{\"n\":null}")))
 ("SELECT json_array(x'01');" :error "JSON cannot hold BLOB values")
 ("SELECT json_group_array(x) FROM (SELECT 1 x UNION ALL SELECT 'a' UNION ALL SELECT NULL);" :rows ("json_group_array(x)")
  (("[1,\"a\",null]")))
 ("SELECT json_group_object(k, v) FROM (SELECT 'a' k, 1 v UNION ALL SELECT 'b', 2);" :rows ("json_group_object(k, v)")
  (("{\"a\":1,\"b\":2}")))
)
("json.test:json-modify"
 ("SELECT json_insert('{\"a\":1}', '$.b', 2, '$.a', 9), json_replace('{\"a\":1}', '$.a', 'x', '$.c', 3), json_set('{\"a\":1}', '$.a', 2, '$.c[0]', 3);" :rows ("json_insert('{\"a\":1}', '$.b', 2, '$.a', 9)" "json_replace('{\"a\":1}', '$.a', 'x', '$.c', 3)" "json_set('{\"a\":1}', '$.a', 2, '$.c[0]', 3)")
  (("{\"a\":1,\"b\":2}" "{\"a\":\"x\"}" "{\"a\":2,\"c\":[3]}")))
 ("SELECT json_set('[1,2]', '$[#]', 3), json_remove('[1,2,3]', '$[1]'), json_remove('{\"a\":1,\"b\":2}', '$.a'), json_set('{}', '$.a.b', 1), json_insert('[]', '$[5]', 1);" :rows ("json_set('[1,2]', '$[#]', 3)" "json_remove('[1,2,3]', '$[1]')" "json_remove('{\"a\":1,\"b\":2}', '$.a')" "json_set('{}', '$.a.b', 1)" "json_insert('[]', '$[5]', 1)")
  (("[1,2,3]" "[1,3]" "{\"b\":2}" "{\"a\":{\"b\":1}}" "[]")))
 ("SELECT json_patch('{\"a\":1,\"b\":{\"c\":2}}', '{\"b\":{\"c\":null,\"d\":4},\"e\":5}'), json_patch('[1]', '{\"a\":1}'), json_patch('{\"a\":1}', '[2]');" :rows ("json_patch('{\"a\":1,\"b\":{\"c\":2}}', '{\"b\":{\"c\":null,\"d\":4},\"e\":5}')" "json_patch('[1]', '{\"a\":1}')" "json_patch('{\"a\":1}', '[2]')")
  (("{\"a\":1,\"b\":{\"d\":4},\"e\":5}" "{\"a\":1}" "[2]")))
 ("SELECT json_type('{\"a\":1.5}', '$.a'), json_type('[1]'), json_type('{\"a\":1}', '$.b'), json_type('{\"a\":\"s\",\"b\":null,\"c\":false,\"d\":7}', '$.c'), json_array_length('[1,2,3]'), json_array_length('{\"a\":[1,2]}', '$.a'), json_array_length('5');" :rows ("json_type('{\"a\":1.5}', '$.a')" "json_type('[1]')" "json_type('{\"a\":1}', '$.b')" "json_type('{\"a\":\"s\",\"b\":null,\"c\":false,\"d\":7}', '$.c')" "json_array_length('[1,2,3]')" "json_array_length('{\"a\":[1,2]}', '$.a')" "json_array_length('5')")
  (("real" "array" :null "false" 3 2 0)))
)
("json.test:json-each-tree"
 ("SELECT * FROM json_each('{\"a\":1,\"b\":[2,3],\"c\":{\"d\":null}}');" :rows ("key" "value" "type" "atom" "id" "parent" "fullkey" "path")
  (("a" 1 "integer" 1 2 :null "$.a" "$")
   ("b" "[2,3]" "array" :null 4 :null "$.b" "$")
   ("c" "{\"d\":null}" "object" :null 8 :null "$.c" "$")))
 ("SELECT key, value, type, atom, id, parent, fullkey, path FROM json_tree('{\"a\":1,\"b\":[2,{\"x\":\"y\"}]}');" :rows ("key" "value" "type" "atom" "id" "parent" "fullkey" "path")
  ((:null "{\"a\":1,\"b\":[2,{\"x\":\"y\"}]}" "object" :null 0 :null "$" "$")
   ("a" 1 "integer" 1 2 0 "$.a" "$")
   ("b" "[2,{\"x\":\"y\"}]" "array" :null 4 0 "$.b" "$")
   (0 2 "integer" 2 5 4 "$.b[0]" "$.b")
   (1 "{\"x\":\"y\"}" "object" :null 6 4 "$.b[1]" "$.b")
   ("x" "y" "text" "y" 8 6 "$.b[1].x" "$.b[1]")))
 ("SELECT key, value FROM json_each('{\"a\":{\"b\":[7,8]}}', '$.a.b');" :rows ("key" "value")
  ((0 7)
   (1 8)))
 ("SELECT key, value FROM json_each('5');" :rows ("key" "value")
  ((:null 5)))
 ("CREATE TABLE doc(id INTEGER PRIMARY KEY, body TEXT);" :ok)
 ("INSERT INTO doc VALUES (1, '{\"tags\":[\"a\",\"b\"],\"n\":1}'), (2, '{\"tags\":[\"c\"],\"n\":2}'), (3, '{\"n\":3}');" :ok)
 ("SELECT doc.id, j.value FROM doc, json_each(doc.body, '$.tags') AS j ORDER BY doc.id, j.key;" :rows ("id" "value")
  ((1 "a")
   (1 "b")
   (2 "c")))
 ("SELECT id FROM doc WHERE EXISTS (SELECT 1 FROM json_each(doc.body, '$.tags') WHERE value = 'c');" :rows ("id")
  ((2)))
 ("SELECT body ->> '$.n' AS n, json_array_length(body, '$.tags') FROM doc ORDER BY n;" :rows ("n" "json_array_length(body, '$.tags')")
  ((1 2)
   (2 1)
   (3 :null)))
 ("SELECT count(*) FROM doc, json_tree(doc.body);" :rows ("count(*)")
  ((11)))
)
("select.test:setup-and-where"
 ("CREATE TABLE emp(id INTEGER PRIMARY KEY, name TEXT, dept TEXT, salary INTEGER, mgr INTEGER);" :ok)
 ("INSERT INTO emp VALUES (1,'Ann','eng',120,NULL),(2,'Bob','eng',100,1),(3,'Cid','ops',90,1),(4,'Dee','ops',95,3),(5,'Eve','hr',70,1),(6,'Fay','eng',NULL,2);" :ok)
 ("SELECT name FROM emp WHERE salary > 90 ORDER BY name;" :rows ("name")
  (("Ann")
   ("Bob")
   ("Dee")))
 ("SELECT name FROM emp WHERE dept = 'eng' AND salary >= 100 ORDER BY id;" :rows ("name")
  (("Ann")
   ("Bob")))
 ("SELECT name FROM emp WHERE dept = 'hr' OR salary IS NULL ORDER BY id;" :rows ("name")
  (("Eve")
   ("Fay")))
 ("SELECT name FROM emp WHERE NOT (dept = 'eng') ORDER BY id;" :rows ("name")
  (("Cid")
   ("Dee")
   ("Eve")))
 ("SELECT name FROM emp WHERE name LIKE '%e%' ORDER BY id;" :rows ("name")
  (("Dee")
   ("Eve")))
 ("SELECT id FROM emp WHERE id IN (2, 4, 99) ORDER BY id;" :rows ("id")
  ((2)
   (4)))
 ("SELECT id FROM emp WHERE id BETWEEN 2 AND 4 ORDER BY id DESC;" :rows ("id")
  ((4)
   (3)
   (2)))
)
("select.test:order-limit"
 ("CREATE TABLE t(a, b);" :ok)
 ("INSERT INTO t VALUES (3,'c'),(1,'a'),(2,'b'),(NULL,'n'),(2,'bb'),(5, NULL);" :ok)
 ("SELECT a, b FROM t ORDER BY a, b;" :rows ("a" "b")
  ((:null "n")
   (1 "a")
   (2 "b")
   (2 "bb")
   (3 "c")
   (5 :null)))
 ("SELECT a, b FROM t ORDER BY a DESC, b;" :rows ("a" "b")
  ((5 :null)
   (3 "c")
   (2 "b")
   (2 "bb")
   (1 "a")
   (:null "n")))
 ("SELECT a FROM t ORDER BY a NULLS LAST;" :rows ("a")
  ((1)
   (2)
   (2)
   (3)
   (5)
   (:null)))
 ("SELECT a FROM t ORDER BY a DESC NULLS FIRST;" :rows ("a")
  ((:null)
   (5)
   (3)
   (2)
   (2)
   (1)))
 ("SELECT a, b FROM t ORDER BY 2 DESC;" :rows ("a" "b")
  ((:null "n")
   (3 "c")
   (2 "bb")
   (2 "b")
   (1 "a")
   (5 :null)))
 ("SELECT a AS x FROM t ORDER BY x LIMIT 3;" :rows ("x")
  ((:null)
   (1)
   (2)))
 ("SELECT a FROM t ORDER BY a LIMIT 2 OFFSET 2;" :rows ("a")
  ((2)
   (2)))
 ("SELECT a FROM t ORDER BY a LIMIT 2, 3;" :rows ("a")
  ((2)
   (2)
   (3)))
 ("SELECT a FROM t ORDER BY a LIMIT -1 OFFSET 4;" :rows ("a")
  ((3)
   (5)))
 ("SELECT a FROM t ORDER BY a LIMIT 0;" :rows ("a")
  ())
 ("SELECT b FROM t ORDER BY b COLLATE NOCASE DESC;" :rows ("b")
  (("n")
   ("c")
   ("bb")
   ("b")
   ("a")
   (:null)))
 ("SELECT a * -1 AS neg FROM t WHERE a IS NOT NULL ORDER BY neg;" :rows ("neg")
  ((-5)
   (-3)
   (-2)
   (-2)
   (-1)))
 ("SELECT a FROM t ORDER BY 3;" :error "1st ORDER BY term out of range - should be between 1 and 1")
)
("select.test:distinct"
 ("CREATE TABLE t(a, b);" :ok)
 ("INSERT INTO t VALUES (1,'x'),(1,'x'),(2,'y'),(1,'X'),(NULL,NULL),(NULL,NULL),(1.0,'x');" :ok)
 ("SELECT DISTINCT a FROM t ORDER BY a;" :rows ("a")
