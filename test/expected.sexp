("select.test:aggregates"
 ("CREATE TABLE t(g, v);" :ok)
 ("INSERT INTO t VALUES ('a',1),('a',2),('b',3),('b',NULL),('c',NULL),('a',3.5),('b','7');" :ok)
 ("SELECT g, count(*), count(v), sum(v), total(v), avg(v), min(v), max(v) FROM t GROUP BY g ORDER BY g;" :rows ("g" "count(*)" "count(v)" "sum(v)" "total(v)" "avg(v)" "min(v)" "max(v)")
  (("a" 3 3 (:f "6.5") (:f "6.5") (:f "2.1666666666666665") 1 (:f "3.5"))
   ("b" 3 2 10 (:f "10.0") (:f "5.0") 3 "7")
   ("c" 1 0 :null (:f "0.0") :null :null :null)))
 ("SELECT g, group_concat(v), group_concat(v, '|') FROM t GROUP BY g ORDER BY g;" :rows ("g" "group_concat(v)" "group_concat(v, '|')")
  (("a" "1,2,3.5" "1|2|3.5")
   ("b" "3,7" "3|7")
   ("c" :null :null)))
 ("SELECT count(*), sum(v), max(g) FROM t;" :rows ("count(*)" "sum(v)" "max(g)")
  ((7 (:f "16.5") "c")))
 ("SELECT g FROM t GROUP BY g HAVING count(v) > 1 ORDER BY g;" :rows ("g")
  (("a")
   ("b")))
 ("SELECT g, sum(v) AS s FROM t GROUP BY g HAVING s > 3 ORDER BY s DESC;" :rows ("g" "s")
  (("b" 10)
   ("a" (:f "6.5"))))
 ("SELECT sum(v) FILTER (WHERE g = 'a'), count(*) FILTER (WHERE v IS NULL) FROM t;" :rows ("sum(v) FILTER (WHERE g = 'a')" "count(*) FILTER (WHERE v IS NULL)")
  (((:f "6.5") 2)))
 ("SELECT g, max(v) FROM t GROUP BY 1 ORDER BY 1;" :rows ("g" "max(v)")
  (("a" (:f "3.5"))
   ("b" "7")
   ("c" :null)))
 ("SELECT count(*) FROM t WHERE 0;" :rows ("count(*)")
  ((0)))
 ("SELECT sum(x) FROM (SELECT 9223372036854775807 AS x UNION ALL SELECT 1);" :error "integer overflow")
 ("SELECT sum(1.5), avg(2), total(NULL), sum(NULL);" :rows ("sum(1.5)" "avg(2)" "total(NULL)" "sum(NULL)")
  (((:f "1.5") (:f "2.0") (:f "0.0") :null)))
)
("select.test:group-by-expressions"
 ("CREATE TABLE t(n);" :ok)
 ("INSERT INTO t VALUES (1),(2),(3),(4),(5),(6),(7);" :ok)
 ("SELECT n % 3 AS r, count(*), sum(n) FROM t GROUP BY n % 3 ORDER BY r;" :rows ("r" "count(*)" "sum(n)")
  ((0 2 9)
   (1 3 12)
   (2 2 7)))
 ("SELECT n > 3, count(*) FROM t GROUP BY 1 ORDER BY 1;" :rows ("n > 3" "count(*)")
  ((0 3)
   (1 4)))
 ("SELECT count(*) AS c FROM t GROUP BY n % 2 HAVING c > 3;" :rows ("c")
  ((4)))
 ("SELECT max(n), n FROM t;" :rows ("max(n)" "n")
  ((7 7)))
 ("SELECT min(n), n FROM t;" :rows ("min(n)" "n")
  ((1 1)))
)
("select.test:joins"
 ("CREATE TABLE a(id INTEGER PRIMARY KEY, x TEXT);" :ok)
 ("CREATE TABLE b(id INTEGER PRIMARY KEY, a_id INTEGER, y TEXT);" :ok)
 ("INSERT INTO a VALUES (1,'one'),(2,'two'),(3,'three');" :ok)
 ("INSERT INTO b VALUES (10,1,'p'),(11,1,'q'),(12,2,'r'),(13,9,'s');" :ok)
 ("SELECT a.x, b.y FROM a JOIN b ON a.id = b.a_id ORDER BY b.id;" :rows ("x" "y")
  (("one" "p")
   ("one" "q")
   ("two" "r")))
 ("SELECT a.x, b.y FROM a, b WHERE a.id = b.a_id ORDER BY b.id;" :rows ("x" "y")
  (("one" "p")
   ("one" "q")
   ("two" "r")))
 ("SELECT a.x, b.y FROM a LEFT JOIN b ON a.id = b.a_id ORDER BY a.id, b.id;" :rows ("x" "y")
  (("one" "p")
   ("one" "q")
   ("two" "r")
   ("three" :null)))
 ("SELECT a.x, b.y FROM a LEFT JOIN b ON a.id = b.a_id WHERE b.y IS NULL;" :rows ("x" "y")
  (("three" :null)))
 ("SELECT a.x, b.y FROM a LEFT JOIN b ON a.id = b.a_id AND b.y = 'q' ORDER BY a.id;" :rows ("x" "y")
  (("one" "q")
   ("two" :null)
   ("three" :null)))
 ("SELECT count(*) FROM a CROSS JOIN b;" :rows ("count(*)")
  ((12)))
 ("SELECT a.x, count(b.id) FROM a LEFT JOIN b ON b.a_id = a.id GROUP BY a.id ORDER BY a.id;" :rows ("x" "count(b.id)")
  (("one" 2)
   ("two" 1)
   ("three" 0)))
 ("SELECT t1.x, t2.x FROM a t1 JOIN a t2 ON t1.id < t2.id ORDER BY 1, 2;" :rows ("x" "x")
  (("one" "three")
   ("one" "two")
   ("two" "three")))
 ("SELECT * FROM a JOIN b ON a.id = b.a_id WHERE a.id = 1 ORDER BY b.id;" :rows ("id" "x" "id" "a_id" "y")
  ((1 "one" 10 1 "p")
   (1 "one" 11 1 "q")))
)
("select.test:join-using-natural"
 ("CREATE TABLE p(k, v1);" :ok)
 ("CREATE TABLE q(k, v2);" :ok)
 ("INSERT INTO p VALUES (1,'a'),(2,'b'),(3,'c');" :ok)
 ("INSERT INTO q VALUES (1,'x'),(3,'y'),(4,'z');" :ok)
 ("SELECT * FROM p JOIN q USING (k) ORDER BY k;" :rows ("k" "v1" "v2")
  ((1 "a" "x")
   (3 "c" "y")))
