("fts3.test:fts4-aux-tables"
 ("CREATE VIRTUAL TABLE t USING fts4(a, b);" :ok)
 ("INSERT INTO t VALUES('alpha beta alpha', 'gamma');" :ok)
 ("INSERT INTO t VALUES('beta', 'alpha delta alpha');" :ok)
 ("INSERT INTO t VALUES('epsilon', NULL);" :ok)
 ("CREATE VIRTUAL TABLE v USING fts4aux(t);" :ok)
 ("SELECT * FROM v;" :rows ("term" "col" "documents" "occurrences")
  (("alpha" "*" 2 4)
   ("alpha" 0 1 2)
   ("alpha" 1 1 2)
   ("beta" "*" 2 2)
   ("beta" 0 2 2)
   ("delta" "*" 1 1)
   ("delta" 1 1 1)
   ("epsilon" "*" 1 1)
   ("epsilon" 0 1 1)
   ("gamma" "*" 1 1)
   ("gamma" 1 1 1)))
 ("SELECT * FROM v WHERE term = 'alpha';" :rows ("term" "col" "documents" "occurrences")
  (("alpha" "*" 2 4)
   ("alpha" 0 1 2)
   ("alpha" 1 1 2)))
 ("SELECT * FROM v WHERE term >= 'b' AND term <= 'd';" :rows ("term" "col" "documents" "occurrences")
  (("beta" "*" 2 2)
   ("beta" 0 2 2)))
 ("SELECT * FROM v WHERE term > 'beta';" :rows ("term" "col" "documents" "occurrences")
  (("delta" "*" 1 1)
   ("delta" 1 1 1)
   ("epsilon" "*" 1 1)
   ("epsilon" 0 1 1)
   ("gamma" "*" 1 1)
   ("gamma" 1 1 1)))
 ("SELECT term, col, documents, occurrences, languageid FROM v WHERE term < 'c';" :rows ("term" "col" "documents" "occurrences" "languageid")
  (("alpha" "*" 2 4 0)
   ("alpha" 0 1 2 0)
   ("alpha" 1 1 2 0)
   ("beta" "*" 2 2 0)
   ("beta" 0 2 2 0)))
 ("DELETE FROM t WHERE docid = 2;" :ok)
 ("SELECT * FROM v;" :rows ("term" "col" "documents" "occurrences")
  (("alpha" "*" 1 2)
   ("alpha" 0 1 2)
   ("beta" "*" 1 1)
   ("beta" 0 1 1)
   ("epsilon" "*" 1 1)
   ("epsilon" 0 1 1)
   ("gamma" "*" 1 1)
   ("gamma" 1 1 1)))
 ("CREATE VIRTUAL TABLE v2 USING fts4aux(main, t);" :error "invalid arguments to fts4aux constructor")
 ("CREATE VIRTUAL TABLE v3 USING fts4aux(nosuch);" :ok)
 ("SELECT * FROM v3;" :error "SQL logic error")
 ("INSERT INTO v VALUES('x', 1, 2, 3);" :error "table v may not be modified")
 ("CREATE VIRTUAL TABLE tk USING fts3tokenize(porter);" :ok)
 ("SELECT token, start, \"end\", position FROM tk WHERE input = 'Running connections quickly';" :rows ("token" "start" "end" "position")
  (("run" 0 7 0)
   ("connect" 8 19 1)
   ("quickli" 20 27 2)))
 ("SELECT * FROM tk WHERE input = 'a b';" :rows ("input" "token" "start" "end" "position")
  (("a b" "a" 0 1 0)
   ("a b" "b" 2 3 1)))
 ("SELECT * FROM tk;" :error "SQL logic error")
 ("CREATE VIRTUAL TABLE tk2 USING fts3tokenize('unicode61', 'remove_diacritics=0');" :ok)
 ("SELECT token FROM tk2 WHERE input = 'Café Über';" :rows ("token")
  (("café")
   ("über")))
 ("CREATE VIRTUAL TABLE tk3 USING fts3tokenize(nosuch);" :error "unknown tokenizer: nosuch")
 ("CREATE VIRTUAL TABLE tk4 USING fts3tokenize;" :ok)
 ("SELECT token FROM tk4 WHERE input = 'Hello, World';" :rows ("token")
  (("hello")
   ("world")))
)
("fts3.test:fts4-rename-drop"
 ("CREATE VIRTUAL TABLE t USING fts4(a);" :ok)
 ("INSERT INTO t VALUES('one two');" :ok)
 ("ALTER TABLE t RENAME TO u;" :ok)
 ("SELECT type, name, tbl_name, sql FROM sqlite_master ORDER BY name;" :rows ("type" "name" "tbl_name" "sql")
  (("index" "sqlite_autoindex_u_segdir_1" "u_segdir" :null)
   ("table" "u" "u" "CREATE VIRTUAL TABLE \"u\" USING fts4(a)")
   ("table" "u_content" "u_content" "CREATE TABLE \"u_content\"(docid INTEGER PRIMARY KEY, 'c0a')")
   ("table" "u_docsize" "u_docsize" "CREATE TABLE \"u_docsize\"(docid INTEGER PRIMARY KEY, size BLOB)")
   ("table" "u_segdir" "u_segdir" "CREATE TABLE \"u_segdir\"(level INTEGER,idx INTEGER,start_block INTEGER,leaves_end_block INTEGER,end_block INTEGER,root BLOB,PRIMARY KEY(level, idx))")
   ("table" "u_segments" "u_segments" "CREATE TABLE \"u_segments\"(blockid INTEGER PRIMARY KEY, block BLOB)")
   ("table" "u_stat" "u_stat" "CREATE TABLE \"u_stat\"(id INTEGER PRIMARY KEY, value BLOB)")))
 ("SELECT docid FROM u WHERE u MATCH 'two';" :rows ("docid")
  ((1)))
 ("INSERT INTO u VALUES('three');" :ok)
 ("SELECT docid, snippet(u) FROM u WHERE u MATCH 'three';" :rows ("docid" "snippet(u)")
  ((2 "<b>three</b>")))
 ("DROP TABLE u;" :ok)
 ("SELECT name FROM sqlite_master;" :rows ("name")
  ())
 ("CREATE VIRTUAL TABLE t3 USING fts3(a);" :ok)
 ("INSERT INTO t3(t3) VALUES('merge=4,2');" :ok)
 ("SELECT name FROM sqlite_master ORDER BY name;" :rows ("name")
  (("sqlite_autoindex_t3_segdir_1")
   ("t3")
   ("t3_content")
   ("t3_segdir")
   ("t3_segments")
   ("t3_stat")))
 ("ALTER TABLE t3 RENAME TO t4;" :ok)
 ("SELECT name FROM sqlite_master ORDER BY name;" :rows ("name")
  (("sqlite_autoindex_t4_segdir_1")
   ("t4")
   ("t4_content")
   ("t4_segdir")
   ("t4_segments")
   ("t4_stat")))
 ("DROP TABLE t4;" :ok)
 ("SELECT name FROM sqlite_master;" :rows ("name")
  ())
)
("fts3.test:fts4-eqp"
 ("CREATE VIRTUAL TABLE t USING fts4(a, b);" :ok)
 ("CREATE VIRTUAL TABLE l USING fts4(a, languageid=lid);" :ok)
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE t MATCH 'x';" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t VIRTUAL TABLE INDEX 4:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE b MATCH 'x';" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t VIRTUAL TABLE INDEX 3:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE docid = 5;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t VIRTUAL TABLE INDEX 1:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE rowid = 5;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t VIRTUAL TABLE INDEX 1:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t VIRTUAL TABLE INDEX 0:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE docid > 5;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t VIRTUAL TABLE INDEX 131072:")))
