("select.test:star-join-names"
 ("CREATE TABLE a(x, y);" :ok)
 ("CREATE TABLE b(y, z);" :ok)
 ("INSERT INTO a VALUES (1, 2);" :ok)
 ("INSERT INTO b VALUES (2, 3);" :ok)
 ("SELECT * FROM a JOIN b ON a.y = b.y;" :rows ("x" "y" "y" "z")
  ((1 2 2 3)))
 ("SELECT a.*, b.z FROM a, b;" :rows ("x" "y" "z")
  ((1 2 3)))
)
("select.test:ambiguous"
 ("CREATE TABLE a(x);" :ok)
 ("CREATE TABLE b(x);" :ok)
 ("SELECT x FROM a, b;" :error "ambiguous column name: x")
 ("SELECT nosuch FROM a;" :error "no such column: nosuch")
 ("SELECT * FROM nosuch;" :error "no such table: nosuch")
)
("triggers.test:trigger-order-and-new"
 ("CREATE TABLE t(a);" :ok)
 ("CREATE TABLE log(m);" :ok)
 ("CREATE TRIGGER t1 AFTER INSERT ON t BEGIN INSERT INTO log VALUES ('t1 ' || new.a); END;" :ok)
 ("CREATE TRIGGER t2 AFTER INSERT ON t BEGIN INSERT INTO log VALUES ('t2 ' || new.a); END;" :ok)
 ("CREATE TRIGGER t0 BEFORE INSERT ON t BEGIN INSERT INTO log VALUES ('b ' || new.a || ' ' || new.rowid); END;" :ok)
 ("INSERT INTO t VALUES (1), (2);" :ok)
 ("SELECT m FROM log ORDER BY rowid;" :rows ("m")
  (("b 1 -1")
   ("t2 1")
   ("t1 1")
   ("b 2 -1")
   ("t2 2")
   ("t1 2")))
)
("triggers.test:trigger-update-delete"
 ("CREATE TABLE log(m);" :ok)
 ("CREATE TABLE u(x INTEGER PRIMARY KEY, y);" :ok)
 ("CREATE TRIGGER ub BEFORE UPDATE OF y ON u BEGIN INSERT INTO log VALUES ('ub ' || old.y || '->' || new.y); END;" :ok)
 ("CREATE TRIGGER ud AFTER DELETE ON u WHEN old.x > 1 BEGIN INSERT INTO log VALUES ('ud ' || old.x); END;" :ok)
 ("INSERT INTO u VALUES (1, 'a'), (2, 'b');" :ok)
 ("UPDATE u SET y = 'c';" :ok)
 ("UPDATE u SET x = x + 10 WHERE x = 1;" :ok)
 ("DELETE FROM u;" :ok)
 ("SELECT m FROM log ORDER BY rowid;" :rows ("m")
  (("ub a->c")
   ("ub b->c")
   ("ud 2")
   ("ud 11")))
)
("triggers.test:trigger-raise"
 ("CREATE TABLE t(a);" :ok)
 ("CREATE TRIGGER ri BEFORE INSERT ON t WHEN new.a < 0 BEGIN SELECT RAISE(ABORT, 'negative!'); END;" :ok)
 ("CREATE TRIGGER rg BEFORE INSERT ON t WHEN new.a = 0 BEGIN SELECT RAISE(IGNORE); END;" :ok)
 ("INSERT INTO t VALUES (1);" :ok)
 ("INSERT INTO t VALUES (2), (-1), (3);" :error "negative!")
 ("INSERT INTO t VALUES (0), (4);" :ok)
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (4)))
 ("SELECT RAISE(IGNORE);" :error "RAISE() may only be used within a trigger-program")
)
("triggers.test:trigger-maintains-summary"
 ("CREATE TABLE item(id INTEGER PRIMARY KEY, cat TEXT, price REAL);" :ok)
 ("CREATE TABLE total(cat TEXT PRIMARY KEY, n INTEGER, sum REAL);" :ok)
 ("CREATE TRIGGER ins AFTER INSERT ON item BEGIN
  INSERT INTO total VALUES (new.cat, 0, 0) ON CONFLICT(cat) DO NOTHING;
  UPDATE total SET n = n + 1, sum = sum + new.price WHERE cat = new.cat;
END;" :ok)
 ("CREATE TRIGGER del AFTER DELETE ON item BEGIN
  UPDATE total SET n = n - 1, sum = sum - old.price WHERE cat = old.cat;
  DELETE FROM total WHERE cat = old.cat AND n = 0;
END;" :ok)
 ("INSERT INTO item(cat, price) VALUES ('a', 1.5), ('b', 2), ('a', 3), ('c', 10);" :ok)
 ("DELETE FROM item WHERE cat = 'c' OR price = 1.5;" :ok)
 ("SELECT * FROM total ORDER BY cat;" :rows ("cat" "n" "sum")
  (("a" 1 (:f "3.0"))
   ("b" 1 (:f "2.0"))))
)
("triggers.test:instead-of-view"
 ("CREATE TABLE t(a);" :ok)
 ("CREATE VIEW v AS SELECT a FROM t;" :ok)
 ("CREATE TRIGGER vi INSTEAD OF INSERT ON v BEGIN INSERT INTO t VALUES (new.a * 100); END;" :ok)
 ("CREATE TRIGGER vd INSTEAD OF DELETE ON v BEGIN DELETE FROM t WHERE a = old.a; END;" :ok)
 ("CREATE TRIGGER vu INSTEAD OF UPDATE ON v BEGIN UPDATE t SET a = new.a WHERE a = old.a; END;" :ok)
 ("INSERT INTO v VALUES (7), (8);" :ok)
 ("UPDATE v SET a = a + 1 WHERE a = 700;" :ok)
 ("DELETE FROM v WHERE a = 800;" :ok)
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((701)))
 ("SELECT name, tbl_name FROM sqlite_schema WHERE type = 'trigger' ORDER BY name;" :rows ("name" "tbl_name")
  (("vd" "v")
   ("vi" "v")
   ("vu" "v")))
 ("DROP TRIGGER vi;" :ok)
 ("INSERT INTO v VALUES (9);" :error "cannot modify v because it is a view")
 ("DROP VIEW v;" :ok)
 ("SELECT count(*) FROM sqlite_schema WHERE type = 'trigger';" :rows ("count(*)")
  ((0)))
)
("triggers.test:partial-and-expression-index"
 ("CREATE TABLE t(a, b);" :ok)
 ("CREATE INDEX tp ON t(a) WHERE b > 0;" :ok)
 ("CREATE INDEX te ON t(lower(b), a + 1);" :ok)
 ("CREATE UNIQUE INDEX tu ON t(a) WHERE b = 'uniq';" :ok)
 ("INSERT INTO t VALUES (1, 5), (2, -1), (3, 'X'), (4, 'uniq');" :ok)
 ("INSERT INTO t VALUES (4, 'uniq');" :error "UNIQUE constraint failed: t.a")
 ("INSERT INTO t VALUES (4, 'other');" :ok)
 ("UPDATE t SET b = 'Y' WHERE a = 3;" :ok)
 ("DELETE FROM t WHERE a = 1;" :ok)
 ("SELECT * FROM t ORDER BY rowid;" :rows ("a" "b")
  ((2 -1)
   (3 "Y")
   (4 "uniq")
   (4 "other")))
 ("PRAGMA integrity_check;" :rows ("integrity_check")
  (("ok")))
)
("window.test:ranking"
 ("CREATE TABLE s(name, dept, pay);" :ok)
 ("INSERT INTO s VALUES ('a','x',10),('b','x',20),('c','x',20),('d','y',5),('e','y',7),('f','y',7),('g','z',1);" :ok)
 ("SELECT name, row_number() OVER (ORDER BY pay DESC, name) FROM s ORDER BY name;" :rows ("name" "row_number() OVER (ORDER BY pay DESC, name)")
  (("a" 3)
   ("b" 1)
   ("c" 2)
   ("d" 6)
   ("e" 4)
   ("f" 5)
   ("g" 7)))
 ("SELECT name, rank() OVER (ORDER BY pay), dense_rank() OVER (ORDER BY pay) FROM s ORDER BY name;" :rows ("name" "rank() OVER (ORDER BY pay)" "dense_rank() OVER (ORDER BY pay)")
  (("a" 5 4)
   ("b" 6 5)
   ("c" 6 5)
   ("d" 2 2)
   ("e" 3 3)
   ("f" 3 3)
   ("g" 1 1)))
 ("SELECT name, rank() OVER (PARTITION BY dept ORDER BY pay DESC) AS r FROM s ORDER BY dept, r, name;" :rows ("name" "r")
  (("b" 1)
   ("c" 1)
   ("a" 3)
   ("e" 1)
   ("f" 1)
   ("d" 3)
   ("g" 1)))
 ("SELECT name, percent_rank() OVER (ORDER BY pay), cume_dist() OVER (ORDER BY pay) FROM s ORDER BY name;" :rows ("name" "percent_rank() OVER (ORDER BY pay)" "cume_dist() OVER (ORDER BY pay)")
  (("a" (:f "0.6666666666666666") (:f "0.7142857142857143"))
   ("b" (:f "0.8333333333333334") (:f "1.0"))
   ("c" (:f "0.8333333333333334") (:f "1.0"))
   ("d" (:f "0.16666666666666666") (:f "0.2857142857142857"))
   ("e" (:f "0.3333333333333333") (:f "0.5714285714285714"))
   ("f" (:f "0.3333333333333333") (:f "0.5714285714285714"))
   ("g" (:f "0.0") (:f "0.14285714285714285"))))
 ("SELECT name, ntile(3) OVER (ORDER BY name) FROM s ORDER BY name;" :rows ("name" "ntile(3) OVER (ORDER BY name)")
  (("a" 1)
   ("b" 1)
   ("c" 1)
   ("d" 2)
   ("e" 2)
   ("f" 3)
   ("g" 3)))
 ("SELECT name, ntile(10) OVER (ORDER BY name) FROM s ORDER BY name;" :rows ("name" "ntile(10) OVER (ORDER BY name)")
  (("a" 1)
   ("b" 2)
   ("c" 3)
   ("d" 4)
   ("e" 5)
   ("f" 6)
   ("g" 7)))
 ("SELECT dept, row_number() OVER (PARTITION BY dept) FROM s ORDER BY dept, 2;" :rows ("dept" "row_number() OVER (PARTITION BY dept)")
  (("x" 1)
   ("x" 2)
   ("x" 3)
   ("y" 1)
   ("y" 2)
   ("y" 3)
   ("z" 1)))
)
("window.test:aggregates-over"
 ("CREATE TABLE t(g, v);" :ok)
 ("INSERT INTO t VALUES (1,1),(1,2),(1,3),(2,10),(2,20),(3,NULL);" :ok)
 ("SELECT g, v, sum(v) OVER (PARTITION BY g) FROM t ORDER BY g, v;" :rows ("g" "v" "sum(v) OVER (PARTITION BY g)")
  ((1 1 6)
   (1 2 6)
   (1 3 6)
   (2 10 30)
   (2 20 30)
   (3 :null :null)))
 ("SELECT g, v, sum(v) OVER (ORDER BY g, v) FROM t ORDER BY g, v;" :rows ("g" "v" "sum(v) OVER (ORDER BY g, v)")
  ((1 1 1)
   (1 2 3)
   (1 3 6)
   (2 10 16)
   (2 20 36)
   (3 :null 36)))
 ("SELECT g, v, sum(v) OVER (ORDER BY g) FROM t ORDER BY g, v;" :rows ("g" "v" "sum(v) OVER (ORDER BY g)")
  ((1 1 6)
   (1 2 6)
   (1 3 6)
   (2 10 36)
   (2 20 36)
   (3 :null 36)))
 ("SELECT g, v, count(*) OVER (), count(v) OVER (PARTITION BY g) FROM t ORDER BY g, v;" :rows ("g" "v" "count(*) OVER ()" "count(v) OVER (PARTITION BY g)")
  ((1 1 6 3)
   (1 2 6 3)
   (1 3 6 3)
   (2 10 6 2)
   (2 20 6 2)
   (3 :null 6 0)))
 ("SELECT g, v, avg(v) OVER (PARTITION BY g ORDER BY v ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) FROM t ORDER BY g, v;" :rows ("g" "v" "avg(v) OVER (PARTITION BY g ORDER BY v ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING)")
  ((1 1 (:f "1.5"))
   (1 2 (:f "2.0"))
   (1 3 (:f "2.5"))
   (2 10 (:f "15.0"))
   (2 20 (:f "15.0"))
   (3 :null :null)))
 ("SELECT v, sum(v) OVER (ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM t ORDER BY v;" :rows ("v" "sum(v) OVER (ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)")
  ((:null 36)
   (1 36)
   (2 36)
   (3 36)
   (10 36)
   (20 36)))
 ("SELECT v, max(v) OVER (ORDER BY v ROWS 2 PRECEDING), min(v) OVER (ORDER BY v ROWS BETWEEN CURRENT ROW AND 1 FOLLOWING) FROM t ORDER BY v;" :rows ("v" "max(v) OVER (ORDER BY v ROWS 2 PRECEDING)" "min(v) OVER (ORDER BY v ROWS BETWEEN CURRENT ROW AND 1 FOLLOWING)")
  ((:null :null 1)
   (1 1 1)
   (2 2 2)
   (3 3 3)
   (10 10 10)
   (20 20 20)))
 ("SELECT v, group_concat(v, '-') OVER (ORDER BY v) FROM t ORDER BY v;" :rows ("v" "group_concat(v, '-') OVER (ORDER BY v)")
  ((:null :null)
   (1 "1")
   (2 "1-2")
   (3 "1-2-3")
   (10 "1-2-3-10")
   (20 "1-2-3-10-20")))
 ("SELECT v, sum(v) OVER (ORDER BY v RANGE BETWEEN 5 PRECEDING AND 5 FOLLOWING) FROM t ORDER BY v;" :rows ("v" "sum(v) OVER (ORDER BY v RANGE BETWEEN 5 PRECEDING AND 5 FOLLOWING)")
  ((:null :null)
   (1 6)
   (2 6)
   (3 6)
   (10 10)
   (20 20)))
 ("SELECT v, count(*) OVER (ORDER BY g GROUPS BETWEEN 1 PRECEDING AND CURRENT ROW) FROM t ORDER BY g, v;" :rows ("v" "count(*) OVER (ORDER BY g GROUPS BETWEEN 1 PRECEDING AND CURRENT ROW)")
  ((1 3)
   (2 3)
   (3 3)
   (10 5)
   (20 5)
   (:null 3)))
)
("window.test:value-functions"
 ("CREATE TABLE t(x);" :ok)
 ("INSERT INTO t VALUES (5),(3),(8),(1),(9);" :ok)
 ("SELECT x, lag(x) OVER (ORDER BY x), lead(x) OVER (ORDER BY x), lag(x, 2, -1) OVER (ORDER BY x), lead(x, 3) OVER (ORDER BY x) FROM t ORDER BY x;" :rows ("x" "lag(x) OVER (ORDER BY x)" "lead(x) OVER (ORDER BY x)" "lag(x, 2, -1) OVER (ORDER BY x)" "lead(x, 3) OVER (ORDER BY x)")
  ((1 :null 3 -1 8)
   (3 1 5 -1 9)
   (5 3 8 1 :null)
   (8 5 9 3 :null)
   (9 8 :null 5 :null)))
 ("SELECT x, first_value(x) OVER (ORDER BY x), last_value(x) OVER (ORDER BY x), nth_value(x, 2) OVER (ORDER BY x) FROM t ORDER BY x;" :rows ("x" "first_value(x) OVER (ORDER BY x)" "last_value(x) OVER (ORDER BY x)" "nth_value(x, 2) OVER (ORDER BY x)")
  ((1 1 1 :null)
   (3 1 3 3)
   (5 1 5 3)
   (8 1 8 3)
   (9 1 9 3)))
 ("SELECT x, last_value(x) OVER (ORDER BY x ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) FROM t ORDER BY x;" :rows ("x" "last_value(x) OVER (ORDER BY x ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING)")
  ((1 9)
   (3 9)
   (5 9)
   (8 9)
   (9 9)))
)
("window.test:named-window-and-grouping"
 ("CREATE TABLE t(g, v);" :ok)
 ("INSERT INTO t VALUES ('a',1),('a',2),('b',3),('b',4),('b',5);" :ok)
 ("SELECT g, v, sum(v) OVER w, row_number() OVER w FROM t WINDOW w AS (PARTITION BY g ORDER BY v) ORDER BY g, v;" :rows ("g" "v" "sum(v) OVER w" "row_number() OVER w")
  (("a" 1 1 1)
   ("a" 2 3 2)
   ("b" 3 3 1)
   ("b" 4 7 2)
   ("b" 5 12 3)))
 ("SELECT g, sum(v), sum(sum(v)) OVER (), rank() OVER (ORDER BY sum(v) DESC) FROM t GROUP BY g ORDER BY g;" :rows ("g" "sum(v)" "sum(sum(v)) OVER ()" "rank() OVER (ORDER BY sum(v) DESC)")
  (("a" 3 15 2)
   ("b" 12 15 1)))
 ("SELECT g, v FROM (SELECT g, v, row_number() OVER (PARTITION BY g ORDER BY v DESC) AS rn FROM t) WHERE rn = 1 ORDER BY g;" :rows ("g" "v")
  (("a" 2)
   ("b" 5)))
 ("SELECT v, sum(v) OVER (ORDER BY v) AS run FROM t ORDER BY run DESC LIMIT 2;" :rows ("v" "run")
  ((5 15)
   (4 10)))
 ("SELECT DISTINCT g, count(*) OVER (PARTITION BY g) FROM t ORDER BY g;" :rows ("g" "count(*) OVER (PARTITION BY g)")
  (("a" 2)
   ("b" 3)))
 ("SELECT v FROM t WHERE row_number() OVER () > 1;" :error "misuse of window function row_number()")
 ("SELECT abs(v) OVER () FROM t;" :error "abs() may not be used as a window function")
)
