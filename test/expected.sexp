 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<3000) INSERT INTO t SELECT 'common word' || CASE WHEN i % 100 = 0 THEN ' rare' ELSE '' END || ' filler' || (i % 13) || CASE WHEN i % 250 = 0 THEN ' rarer common' ELSE '' END || CASE WHEN i IN (1234, 2345) THEN ' unique word common' ELSE '' END FROM c;" :ok)
