 ("SELECT * FROM g ORDER BY a;" :rows ("a" "b" "c" "d" "e")
  ((3 6 "x" "3x" 99)
   (4 8 "y" "4y" 100)))
 ("SELECT b, d FROM g WHERE b > 6;" :rows ("b" "d")
  ((8 "4y")))
 ("UPDATE g SET a = 10 WHERE a = 3;" :ok)
 ("SELECT * FROM g ORDER BY a;" :rows ("a" "b" "c" "d" "e")
  ((4 8 "y" "4y" 100)
   (10 20 "x" "10x" 99)))
 ("INSERT INTO g(a, b) VALUES (1, 2);" :error "cannot INSERT into generated column \"b\"")
 ("UPDATE g SET b = 1;" :error "cannot UPDATE generated column \"b\"")
 ("PRAGMA table_info(g);" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk")
  ((0 "a" "INTEGER" 0 :null 0)
   (1 "c" "TEXT" 0 :null 0)
   (2 "e" "" 0 :null 0)))
 ("PRAGMA table_xinfo(g);" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk" "hidden")
  ((0 "a" "INTEGER" 0 :null 0 0)
   (1 "b" "" 0 :null 0 2)
   (2 "c" "TEXT" 0 :null 0 0)
   (3 "d" "" 0 :null 0 3)
   (4 "e" "" 0 :null 0 0)))
 ("CREATE INDEX gb ON g(b);" :ok)
 ("SELECT a FROM g WHERE b = 8;" :rows ("a")
  ((4)))
 ("PRAGMA integrity_check;" :rows ("integrity_check")
  (("ok")))
)
("ddl.test:strict-tables"
 ("CREATE TABLE s(i INTEGER, r REAL, t TEXT, b BLOB, a ANY) STRICT;" :ok)
 ("INSERT INTO s VALUES (1, 2.5, 'x', x'00', 3);" :ok)
 ("INSERT INTO s VALUES ('1', 2, 3, x'00', 'z');" :ok)
 ("INSERT INTO s VALUES ('abc', 1, 1, 1, 1);" :error "cannot store TEXT value in INTEGER column s.i")
 ("INSERT INTO s VALUES (1.5, 1, 1, 1, 1);" :error "cannot store REAL value in INTEGER column s.i")
 ("INSERT INTO s VALUES (NULL, NULL, NULL, NULL, NULL);" :ok)
 ("SELECT typeof(i), i, typeof(r), r, typeof(t), t, typeof(a), a FROM s ORDER BY rowid;" :rows ("typeof(i)" "i" "typeof(r)" "r" "typeof(t)" "t" "typeof(a)" "a")
  (("integer" 1 "real" (:f "2.5") "text" "x" "integer" 3)
   ("integer" 1 "real" (:f "2.0") "text" "3" "text" "z")
   ("null" :null "null" :null "null" :null "null" :null)))
 ("UPDATE s SET i = 'nope';" :error "cannot store TEXT value in INTEGER column s.i")
 ("CREATE TABLE bad(x FOO) STRICT;" :error "unknown datatype for bad.x: \"FOO\"")
 ("CREATE TABLE bad2(x) STRICT;" :error "missing datatype for bad2.x")
)
("dml.test:update-basic"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, v, w);" :ok)
 ("INSERT INTO t VALUES (1, 'a', 10), (2, 'b', 20), (3, 'c', 30);" :ok)
 ("UPDATE t SET w = w + 1 WHERE id >= 2;" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v" "w")
  ((1 "a" 10)
   (2 "b" 21)
   (3 "c" 31)))
 ("UPDATE t SET v = upper(v), w = w * 2;" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v" "w")
  ((1 "A" 20)
   (2 "B" 42)
   (3 "C" 62)))
 ("UPDATE t SET id = id + 10 WHERE id = 1;" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v" "w")
  ((2 "B" 42)
   (3 "C" 62)
   (11 "A" 20)))
 ("UPDATE t SET v = 'z' WHERE 0;" :ok)
 ("SELECT changes();" :rows ("changes()")
  ((0)))
 ("UPDATE t SET w = NULL WHERE v = 'B';" :ok)
 ("SELECT changes(), total_changes();" :rows ("changes()" "total_changes()")
  ((1 10)))
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v" "w")
  ((2 "B" :null)
   (3 "C" 62)
   (11 "A" 20)))
)
("dml.test:delete-basic"
 ("CREATE TABLE t(a);" :ok)
 ("INSERT INTO t VALUES (1), (2), (3), (4), (5);" :ok)
 ("DELETE FROM t WHERE a % 2 = 0;" :ok)
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (3)
   (5)))
 ("SELECT changes();" :rows ("changes()")
  ((2)))
 ("DELETE FROM t;" :ok)
 ("SELECT count(*) FROM t;" :rows ("count(*)")
  ((0)))
 ("INSERT INTO t VALUES (9);" :ok)
 ("SELECT rowid, a FROM t;" :rows ("rowid" "a")
  ((1 9)))
)
("dml.test:not-null"
 ("CREATE TABLE t(a NOT NULL, b);" :ok)
 ("INSERT INTO t VALUES (1, 2);" :ok)
 ("INSERT INTO t VALUES (NULL, 2);" :error "NOT NULL constraint failed: t.a")
 ("INSERT OR IGNORE INTO t VALUES (NULL, 3);" :ok)
 ("SELECT * FROM t;" :rows ("a" "b")
  ((1 2)))
 ("UPDATE t SET a = NULL;" :error "NOT NULL constraint failed: t.a")
 ("SELECT * FROM t;" :rows ("a" "b")
  ((1 2)))
)
("dml.test:not-null-replace-default"
 ("CREATE TABLE t(a NOT NULL DEFAULT 'dflt', b);" :ok)
 ("INSERT OR REPLACE INTO t VALUES (NULL, 1);" :ok)
 ("SELECT * FROM t;" :rows ("a" "b")
  (("dflt" 1)))
)
("dml.test:unique"
 ("CREATE TABLE t(a UNIQUE, b);" :ok)
 ("INSERT INTO t VALUES (1, 'x'), (2, 'y');" :ok)
 ("INSERT INTO t VALUES (1, 'z');" :error "UNIQUE constraint failed: t.a")
 ("INSERT INTO t VALUES (NULL, 'n1'), (NULL, 'n2');" :ok)
 ("SELECT * FROM t ORDER BY rowid;" :rows ("a" "b")
  ((1 "x")
   (2 "y")
   (:null "n1")
   (:null "n2")))
 ("INSERT OR IGNORE INTO t VALUES (2, 'ignored'), (3, 'kept');" :ok)
 ("SELECT * FROM t ORDER BY rowid;" :rows ("a" "b")
  ((1 "x")
   (2 "y")
   (:null "n1")
   (:null "n2")
   (3 "kept")))
 ("INSERT OR REPLACE INTO t VALUES (1, 'replaced');" :ok)
 ("SELECT a, b FROM t ORDER BY a;" :rows ("a" "b")
  ((:null "n1")
   (:null "n2")
   (1 "replaced")
   (2 "y")
   (3 "kept")))
 ("UPDATE t SET a = 2 WHERE a = 3;" :error "UNIQUE constraint failed: t.a")
 ("UPDATE OR REPLACE t SET a = 2 WHERE a = 3;" :ok)
 ("SELECT a, b FROM t ORDER BY a;" :rows ("a" "b")
  ((:null "n1")
   (:null "n2")
   (1 "replaced")
   (2 "kept")))
)
("dml.test:multi-column-unique"
 ("CREATE TABLE t(a, b, c, UNIQUE(a, b));" :ok)
 ("INSERT INTO t VALUES (1, 1, 'x'), (1, 2, 'y');" :ok)
 ("INSERT INTO t VALUES (1, 1, 'dup');" :error "UNIQUE constraint failed: t.a, t.b")
 ("INSERT INTO t VALUES (1, NULL, 'n'), (1, NULL, 'n2');" :ok)
 ("SELECT * FROM t ORDER BY rowid;" :rows ("a" "b" "c")
  ((1 1 "x")
   (1 2 "y")
   (1 :null "n")
   (1 :null "n2")))
)
("dml.test:primary-key-text"
