 ("INSERT INTO q SELECT x FROM p;" :ok)
 ("INSERT INTO r SELECT x * 10, x FROM p;" :ok)
 ("DELETE FROM p WHERE x IN (1, 3);" :ok)
 ("DELETE FROM q WHERE x IN (1, 3);" :ok)
 ("DELETE FROM r WHERE x IN (1, 3);" :ok)
 ("VACUUM;" :ok)
 ("SELECT rowid, x FROM p;" :rows ("rowid" "x")
