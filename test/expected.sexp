("explain.test:eqp-joins-subqueries"
 ("CREATE TABLE t(a, b, c);" :ok)
 ("CREATE INDEX ta ON t(a);" :ok)
 ("CREATE TABLE u(id INTEGER PRIMARY KEY, x, y UNIQUE);" :ok)
 ("EXPLAIN QUERY PLAN SELECT * FROM t, u WHERE t.a = u.id;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SCAN t")
   (5 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t LEFT JOIN u ON u.id = t.b;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SCAN t")
   (5 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid=?) LEFT-JOIN")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t CROSS JOIN u;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SCAN t")
   (5 0 0 "SCAN u")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u JOIN t ON t.a = u.x;" :rows ("id" "parent" "notused" "detail")
  ((4 0 0 "SCAN u")
   (6 0 0 "SEARCH t USING INDEX ta (a=?)")))
 ("EXPLAIN QUERY PLAN SELECT 1;" :rows ("id" "parent" "notused" "detail")
  ((1 0 0 "SCAN CONSTANT ROW")))
 ("EXPLAIN QUERY PLAN VALUES (1), (2), (3);" :rows ("id" "parent" "notused" "detail")
  ((1 0 0 "SCAN 3 CONSTANT ROWS")))
 ("EXPLAIN QUERY PLAN VALUES (1);" :rows ("id" "parent" "notused" "detail")
  ((1 0 0 "SCAN CONSTANT ROW")))
 ("EXPLAIN QUERY PLAN SELECT * FROM (SELECT a, count(*) FROM t GROUP BY a);" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "CO-ROUTINE (subquery-1)")
   (8 2 0 "SCAN t USING COVERING INDEX ta")
   (36 0 0 "SCAN (subquery-1)")))
 ("EXPLAIN QUERY PLAN SELECT count(*) FROM (SELECT a FROM t GROUP BY a);" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "CO-ROUTINE (subquery-1)")
   (8 2 0 "SCAN t USING COVERING INDEX ta")
   (35 0 0 "SCAN (subquery-1)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM (SELECT x FROM u GROUP BY x) AS s, t WHERE s.x = t.a;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "MATERIALIZE s")
   (10 3 0 "SCAN u")
   (12 3 0 "USE TEMP B-TREE FOR GROUP BY")
   (50 0 0 "SCAN s")
   (52 0 0 "SEARCH t USING INDEX ta (a=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM (SELECT 1) JOIN (SELECT 2);" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "MATERIALIZE (subquery-1)")
   (5 3 0 "SCAN CONSTANT ROW")
   (13 0 0 "MATERIALIZE (subquery-2)")
   (15 13 0 "SCAN CONSTANT ROW")
   (23 0 0 "SCAN (subquery-1)")
   (27 0 0 "SCAN (subquery-2)")))
 ("EXPLAIN QUERY PLAN WITH q(n) AS (SELECT 1) SELECT * FROM q, q AS q2;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "MATERIALIZE q")
   (5 3 0 "SCAN CONSTANT ROW")
   (15 0 0 "SCAN q")
   (17 0 0 "SCAN q2")))
 ("EXPLAIN QUERY PLAN WITH q(n) AS (SELECT a FROM t GROUP BY a) SELECT * FROM q;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "CO-ROUTINE q")
   (8 2 0 "SCAN t USING COVERING INDEX ta")
   (34 0 0 "SCAN q")))
 ("EXPLAIN QUERY PLAN WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 5) SELECT * FROM n;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "CO-ROUTINE n")
   (5 2 0 "SETUP")
   (6 5 0 "SCAN CONSTANT ROW")
   (17 2 0 "RECURSIVE STEP")
   (18 17 0 "SCAN n")
   (28 0 0 "SCAN n")))
 ("EXPLAIN QUERY PLAN SELECT (SELECT max(x) FROM u), a FROM t;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t USING COVERING INDEX ta")
   (6 0 0 "SCALAR SUBQUERY 1")
   (11 6 0 "SEARCH u")))
 ("EXPLAIN QUERY PLAN SELECT (SELECT x FROM u WHERE u.id = t.a) FROM t;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t USING COVERING INDEX ta")
   (5 0 0 "CORRELATED SCALAR SUBQUERY 1")
   (9 5 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE a IN (SELECT x FROM u);" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING INDEX ta (a=?)")
   (7 0 0 "LIST SUBQUERY 1")
   (9 7 0 "SCAN u")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE EXISTS (SELECT 1 FROM u WHERE u.x = t.c);" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")
   (5 0 0 "CORRELATED SCALAR SUBQUERY 1")
   (9 5 0 "SCAN u")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t WHERE a IN (SELECT id FROM u WHERE x = t.b);" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")
   (5 0 0 "CORRELATED LIST SUBQUERY 1")
   (7 5 0 "SCAN u")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE b IN (SELECT x FROM u) AND c = (SELECT max(id) FROM u);" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")
   (7 0 0 "LIST SUBQUERY 1")
   (9 7 0 "SCAN u")
   (24 0 0 "SCALAR SUBQUERY 2")
   (29 24 0 "SEARCH u")))
 ("EXPLAIN QUERY PLAN SELECT (SELECT 1), (SELECT 2 FROM u), (SELECT (SELECT 3));" :rows ("id" "parent" "notused" "detail")
  ((1 0 0 "SCAN CONSTANT ROW")
   (4 0 0 "SCALAR SUBQUERY 1")
   (7 4 0 "SCAN CONSTANT ROW")
   (14 0 0 "SCALAR SUBQUERY 2")
   (18 14 0 "SCAN u USING COVERING INDEX sqlite_autoindex_u_1")
   (27 0 0 "SCALAR SUBQUERY 4")
   (30 27 0 "SCAN CONSTANT ROW")
   (33 27 0 "SCALAR SUBQUERY 3")
   (36 33 0 "SCAN CONSTANT ROW")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE a = (SELECT 1) AND b IN (SELECT x FROM (SELECT x FROM u GROUP BY x));" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING INDEX ta (a=?)")
   (6 0 0 "SCALAR SUBQUERY 1")
   (9 6 0 "SCAN CONSTANT ROW")
   (20 0 0 "LIST SUBQUERY 3")
   (22 20 0 "CO-ROUTINE (subquery-2)")
   (28 22 0 "SCAN u")
   (30 22 0 "USE TEMP B-TREE FOR GROUP BY")
   (62 20 0 "SCAN (subquery-2)")))
 ("EXPLAIN QUERY PLAN SELECT (SELECT max(x) FROM u) AS m, a FROM t ORDER BY c;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SCAN t")
   (7 0 0 "SCALAR SUBQUERY 1")
   (12 7 0 "SEARCH u")
   (28 0 0 "USE TEMP B-TREE FOR ORDER BY")))
 ("EXPLAIN QUERY PLAN SELECT c, (SELECT 1) FROM t GROUP BY c ORDER BY 2;" :rows ("id" "parent" "notused" "detail")
  ((7 0 0 "SCAN t")
   (9 0 0 "USE TEMP B-TREE FOR GROUP BY")
   (37 0 0 "SCALAR SUBQUERY 1")
   (40 37 0 "SCAN CONSTANT ROW")
   (51 0 0 "USE TEMP B-TREE FOR ORDER BY")))
 ("EXPLAIN QUERY PLAN SELECT DISTINCT c, (SELECT x FROM u WHERE id = t.a) FROM t ORDER BY b;" :rows ("id" "parent" "notused" "detail")
  ((4 0 0 "SCAN t")
   (8 0 0 "CORRELATED SCALAR SUBQUERY 1")
   (12 8 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid=?)")
   (26 0 0 "USE TEMP B-TREE FOR DISTINCT")
   (27 0 0 "USE TEMP B-TREE FOR ORDER BY")))
)
("explain.test:eqp-compound-dml-misc"
 ("CREATE TABLE t(a, b, c);" :ok)
 ("CREATE INDEX ta ON t(a);" :ok)
 ("CREATE TABLE u(id INTEGER PRIMARY KEY, x, y UNIQUE);" :ok)
 ("CREATE VIRTUAL TABLE r USING rtree(id, x0, x1, y0, y1);" :ok)
 ("CREATE VIEW v AS SELECT a, count(*) AS n FROM t GROUP BY a;" :ok)
 ("EXPLAIN QUERY PLAN SELECT a FROM t UNION SELECT x FROM u;" :rows ("id" "parent" "notused" "detail")
  ((1 0 0 "COMPOUND QUERY")
   (2 1 0 "LEFT-MOST SUBQUERY")
   (5 2 0 "SCAN t USING COVERING INDEX ta")
   (11 1 0 "UNION USING TEMP B-TREE")
   (13 11 0 "SCAN u")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t UNION ALL SELECT x FROM u;" :rows ("id" "parent" "notused" "detail")
  ((1 0 0 "COMPOUND QUERY")
   (2 1 0 "LEFT-MOST SUBQUERY")
   (4 2 0 "SCAN t USING COVERING INDEX ta")
   (9 1 0 "UNION ALL")
   (11 9 0 "SCAN u")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t EXCEPT SELECT x FROM u;" :rows ("id" "parent" "notused" "detail")
  ((1 0 0 "COMPOUND QUERY")
   (2 1 0 "LEFT-MOST SUBQUERY")
   (5 2 0 "SCAN t USING COVERING INDEX ta")
   (11 1 0 "EXCEPT USING TEMP B-TREE")
   (13 11 0 "SCAN u")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t INTERSECT SELECT x FROM u;" :rows ("id" "parent" "notused" "detail")
  ((1 0 0 "COMPOUND QUERY")
   (2 1 0 "LEFT-MOST SUBQUERY")
   (5 2 0 "SCAN t USING COVERING INDEX ta")
   (12 1 0 "INTERSECT USING TEMP B-TREE")
   (14 12 0 "SCAN u")))
 ("EXPLAIN QUERY PLAN SELECT * FROM r;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN r VIRTUAL TABLE INDEX 2:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM r WHERE x0 > 1;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN r VIRTUAL TABLE INDEX 2:E0")))
 ("EXPLAIN QUERY PLAN SELECT * FROM r WHERE x0 > 1 AND y1 < 5 AND x1 = 3;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN r VIRTUAL TABLE INDEX 2:E0C3A1")))
 ("EXPLAIN QUERY PLAN SELECT * FROM r WHERE id = 3;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN r VIRTUAL TABLE INDEX 1:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM json_each('[1]');" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN json_each VIRTUAL TABLE INDEX 1:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM json_each('[1]', '$');" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN json_each VIRTUAL TABLE INDEX 3:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM json_tree('[1]');" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN json_tree VIRTUAL TABLE INDEX 1:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t, json_each(t.c);" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SCAN t")
   (5 0 0 "SCAN json_each VIRTUAL TABLE INDEX 1:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM pragma_table_info('t');" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN pragma_table_info VIRTUAL TABLE INDEX 0:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM v;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "CO-ROUTINE v")
   (8 2 0 "SCAN t USING COVERING INDEX ta")
   (36 0 0 "SCAN v")))
 ("EXPLAIN QUERY PLAN DELETE FROM u WHERE id = 3;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid=?)")))
 ("EXPLAIN QUERY PLAN DELETE FROM t;" :rows ("id" "parent" "notused" "detail")
  ())
 ("EXPLAIN QUERY PLAN UPDATE u SET x = 1 WHERE id > 10;" :rows ("id" "parent" "notused" "detail")
  ((4 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid>?)")))
 ("EXPLAIN QUERY PLAN INSERT INTO t VALUES (1, 2, 3);" :rows ("id" "parent" "notused" "detail")
  ())
 ("EXPLAIN QUERY PLAN INSERT INTO t VALUES (1, 2, 3), (4, 5, 6);" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN 2 CONSTANT ROWS")))
 ("EXPLAIN QUERY PLAN INSERT INTO t SELECT 1, 2, 3;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN CONSTANT ROW")))
 ("EXPLAIN QUERY PLAN INSERT INTO t SELECT * FROM t WHERE a = 1;" :rows ("id" "parent" "notused" "detail")
  ((4 0 0 "SEARCH t USING INDEX ta (a=?)")))
 ("EXPLAIN QUERY PLAN CREATE TABLE z AS SELECT * FROM t;" :rows ("id" "parent" "notused" "detail")
  ((15 0 0 "SCAN t")))
 ("EXPLAIN QUERY PLAN CREATE TABLE z2(a);" :rows ("id" "parent" "notused" "detail")
  ())
 ("EXPLAIN QUERY PLAN PRAGMA table_info(t);" :rows ("id" "parent" "notused" "detail")
  ())
 ("EXPLAIN QUERY PLAN BEGIN;" :rows ("id" "parent" "notused" "detail")
  ())
 ("SELECT name FROM sqlite_master WHERE name LIKE 'z%';" :rows ("name")
  ())
 ("EXPLAIN QUERY PLAN SELECT * FROM nosuch;" :error "no such table: nosuch")
)
("explain.test:planner-paths-results"
 ("CREATE TABLE t(a, b TEXT, c INT, d COLLATE NOCASE);" :ok)
 ("CREATE INDEX tb ON t(b);" :ok)
 ("CREATE INDEX tc ON t(c DESC);" :ok)
 ("CREATE INDEX td ON t(d);" :ok)
 ("CREATE TABLE e(x);" :ok)
 ("CREATE INDEX ex ON e(x);" :ok)
 ("INSERT INTO t VALUES (1, '1', 1, 'a'), (2, '2', NULL, 'B'), (3, 'x', 3, 'b'), (4, NULL, 2, NULL), (5, '01', 5, 'A'), (6, '1.0', 1, 'c'), (7, 'X', -1, 'C');" :ok)
 ("INSERT INTO e VALUES (NULL), (NULL);" :ok)
 ("SELECT a FROM t WHERE rowid IN (3, 1, 3, '2', 2.0, 2.5, NULL, 99) ORDER BY a;" :rows ("a")
  ((1)
   (2)
   (3)))
 ("SELECT a FROM t WHERE a IN (SELECT c FROM t) ORDER BY a;" :rows ("a")
  ((1)
   (2)
   (3)
   (5)))
 ("SELECT a FROM t WHERE rowid IN (SELECT c FROM t WHERE c > 2);" :rows ("a")
  ((3)
   (5)))
 ("SELECT a FROM t WHERE b IN (1, '2', 'x', 1.0, NULL) ORDER BY a;" :rows ("a")
  ((1)
   (2)
   (3)
   (6)))
 ("SELECT a FROM t WHERE b IN ('X', 'x') ORDER BY a;" :rows ("a")
  ((3)
   (7)))
 ("SELECT a FROM t WHERE c IN ('1', 3, 3.0, '5', NULL) ORDER BY a;" :rows ("a")
  ((1)
   (3)
   (5)
   (6)))
 ("SELECT a FROM t WHERE d IN ('A', 'b') ORDER BY a;" :rows ("a")
  ((1)
   (2)
   (3)
   (5)))
 ("SELECT a FROM t WHERE d IN ('A' COLLATE BINARY) ORDER BY a;" :rows ("a")
  ((5)))
 ("SELECT a FROM t WHERE b IN (SELECT b FROM t WHERE a > 5) ORDER BY a;" :rows ("a")
  ((6)
   (7)))
 ("SELECT a FROM t WHERE c IN (SELECT a FROM t WHERE a < 4) ORDER BY a;" :rows ("a")
  ((1)
   (3)
   (4)
   (6)))
 ("SELECT a FROM t WHERE c NOT IN (1, 2) ORDER BY a;" :rows ("a")
  ((3)
   (5)
   (7)))
 ("SELECT a FROM t WHERE c IN () ORDER BY a;" :rows ("a")
  ())
 ("SELECT a, b FROM t WHERE b IN ('1', '01') AND c > 0 ORDER BY a;" :rows ("a" "b")
  ((1 "1")
   (5 "01")))
 ("SELECT max(c), min(c), count(*) FROM t;" :rows ("max(c)" "min(c)" "count(*)")
  ((5 -1 7)))
 ("SELECT max(c) FROM t;" :rows ("max(c)")
  ((5)))
 ("SELECT min(c) FROM t;" :rows ("min(c)")
  ((-1)))
 ("SELECT min(c), a FROM t;" :rows ("min(c)" "a")
  ((-1 7)))
 ("SELECT max(c), a FROM t;" :rows ("max(c)" "a")
  ((5 5)))
 ("SELECT max(b), a FROM t;" :rows ("max(b)" "a")
  (("x" 3)))
 ("SELECT min(b), a FROM t;" :rows ("min(b)" "a")
  (("01" 5)))
 ("SELECT min(d), max(d) FROM t;" :rows ("min(d)" "max(d)")
  (("a" "c")))
 ("SELECT min(d), a FROM t;" :rows ("min(d)" "a")
  (("a" 1)))
 ("SELECT max(d), a FROM t;" :rows ("max(d)" "a")
  (("C" 7)))
 ("SELECT max(rowid), min(rowid) FROM t;" :rows ("max(rowid)" "min(rowid)")
  ((7 1)))
 ("SELECT max(rowid), a FROM t;" :rows ("max(rowid)" "a")
  ((7 7)))
 ("SELECT min(rowid) + 1 FROM t;" :rows ("min(rowid) + 1")
  ((2)))
 ("SELECT max(x), min(x) FROM e;" :rows ("max(x)" "min(x)")
  ((:null :null)))
 ("SELECT min(x) FROM e;" :rows ("min(x)")
  ((:null)))
 ("SELECT max(x) FROM e;" :rows ("max(x)")
  ((:null)))
 ("SELECT max(x) FROM (SELECT 1 AS x) WHERE 0;" :rows ("max(x)")
  ((:null)))
 ("DELETE FROM e;" :ok)
 ("SELECT min(x), max(x) FROM e;" :rows ("min(x)" "max(x)")
  ((:null :null)))
 ("SELECT max(c) FROM t WHERE a > 3;" :rows ("max(c)")
  ((5)))
 ("SELECT a FROM t WHERE c = (SELECT max(c) FROM t);" :rows ("a")
  ((5)))
 ("SELECT a FROM t WHERE b = (SELECT b FROM t WHERE a = 3);" :rows ("a")
  ((3)))
 ("SELECT a FROM t WHERE c = (SELECT 42);" :rows ("a")
  ())
 ("SELECT a FROM t NOT INDEXED WHERE c = 3;" :rows ("a")
  ((3)))
 ("SELECT a FROM t INDEXED BY tc WHERE c = 3;" :rows ("a")
  ((3)))
 ("SELECT a FROM t INDEXED BY tc ORDER BY a;" :rows ("a")
  ((1)
   (2)
   (3)
   (4)
   (5)
   (6)
   (7)))
 ("SELECT a FROM t INDEXED BY nosuch;" :error "no such index: nosuch")
 ("EXPLAIN QUERY PLAN SELECT a FROM t INDEXED BY tc WHERE a = 3;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SCAN t USING INDEX tc")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t NOT INDEXED WHERE c = 3;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t WHERE rowid IN (1, 2);" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH t USING INTEGER PRIMARY KEY (rowid=?)")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t WHERE c IN (1, 2);" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING INDEX tc (c=?)")))
 ("EXPLAIN QUERY PLAN SELECT max(c) FROM t;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING COVERING INDEX tc")))
 ("EXPLAIN QUERY PLAN SELECT min(d) FROM t;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING COVERING INDEX td")))
 ("EXPLAIN QUERY PLAN SELECT max(rowid) FROM t;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t")))
 ("EXPLAIN QUERY PLAN SELECT max(a) FROM t;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t WHERE c = (SELECT max(c) FROM t);" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING INDEX tc (c=?)")
   (6 0 0 "SCALAR SUBQUERY 1")
   (11 6 0 "SEARCH t USING COVERING INDEX tc")))
 ("SELECT count(DISTINCT d), group_concat(DISTINCT d) FROM t;" :rows ("count(DISTINCT d)" "group_concat(DISTINCT d)")
  ((3 "a,B,c")))
 ("SELECT min(d COLLATE BINARY), max(d COLLATE BINARY) FROM t;" :rows ("min(d COLLATE BINARY)" "max(d COLLATE BINARY)")
  (("A" "c")))
 ("SELECT max(d) OVER (), min(d) OVER () FROM t LIMIT 1;" :rows ("max(d) OVER ()" "min(d) OVER ()")
  (("c" "a")))
 ("SELECT min(b COLLATE NOCASE), max(b COLLATE NOCASE) FROM t;" :rows ("min(b COLLATE NOCASE)" "max(b COLLATE NOCASE)")
  (("01" "X")))
)
("expr.test:arithmetic"
 ("SELECT 1 + 2, 7 - 10, 6 * 7, 7 / 2, -7 / 2, 7 % 3, -7 % 3, 7 % -3;" :rows ("1 + 2" "7 - 10" "6 * 7" "7 / 2" "-7 / 2" "7 % 3" "-7 % 3" "7 % -3")
  ((3 -3 42 3 -3 1 -1 1)))
