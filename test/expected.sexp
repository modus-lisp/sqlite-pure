  ((1)))
 ("SELECT docid FROM p WHERE p MATCH 'connect';" :rows ("docid")
  ((1)))
 ("SELECT offsets(p) FROM p WHERE p MATCH 'run';" :rows ("offsets(p)")
  (("0 0 0 7 0 0 8 4")))
 ("CREATE VIRTUAL TABLE u USING fts4(a, tokenize=unicode61 \"remove_diacritics=0\");" :ok)
 ("INSERT INTO u VALUES('Café naïve ÉCOLE');" :ok)
 ("SELECT docid FROM u WHERE u MATCH 'cafe';" :rows ("docid")
  ())
 ("SELECT docid FROM u WHERE u MATCH 'café';" :rows ("docid")
  ((1)))
 ("SELECT offsets(u) FROM u WHERE u MATCH 'école';" :rows ("offsets(u)")
  (("0 0 13 6")))
 ("CREATE VIRTUAL TABLE v USING fts4(a, tokenize=unicode61);" :ok)
 ("INSERT INTO v VALUES('Café naïve ÉCOLE');" :ok)
 ("SELECT docid FROM v WHERE v MATCH 'cafe';" :rows ("docid")
  ((1)))
 ("SELECT snippet(v) FROM v WHERE v MATCH 'ecole';" :rows ("snippet(v)")
  (("Café naïve <b>ÉCOLE</b>")))
 ("CREATE VIRTUAL TABLE w USING fts4(a, tokenize=bogus);" :error "unknown tokenizer: bogus")
