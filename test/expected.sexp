 ("SELECT rowid FROM t WHERE t MATCH 'a AND';" :error "fts5: syntax error near \"\"")
 ("SELECT rowid FROM t WHERE t MATCH '';" :error "fts5: syntax error near \"\"")
 ("SELECT rowid FROM t WHERE t MATCH NULL;" :error "fts5: syntax error near \"\"")
 ("SELECT rowid FROM t WHERE t MATCH '(fast';" :error "fts5: syntax error near \"\"")
 ("SELECT rowid FROM t WHERE t MATCH 'fast)';" :error "fts5: syntax error near \")\"")
 ("SELECT rowid FROM t WHERE t MATCH 'nosuch:fast';" :error "no such column: nosuch")
 ("SELECT rowid FROM t WHERE t MATCH '\"unterminated';" :error "unterminated string")
 ("SELECT rowid FROM t WHERE t MATCH 'fast #';" :error "fts5: syntax error near \"#\"")
 ("SELECT rowid FROM t WHERE t MATCH 'NEAR(fast engine, x)';" :error "expected integer, got \"x\"")
 ("SELECT rowid FROM t WHERE t MATCH 'NEAR fast';" :rows ("rowid")
  ())
 ("SELECT rowid FROM t WHERE t MATCH 'near(fast engine)';" :error "fts5: syntax error near \"near\"")
 ("SELECT rowid FROM t WHERE t MATCH '(fast) engine';" :error "fts5: syntax error near \"engine\"")
 ("SELECT rowid FROM t WHERE t MATCH 'fast (engine)';" :error "fts5: syntax error near \"fast\"")
 ("SELECT rowid FROM t WHERE t MATCH '*';" :error "unknown special query: ")
 ("SELECT rowid FROM t WHERE t MATCH 'fast OR';" :error "fts5: syntax error near \"\"")
 ("SELECT rowid FROM t WHERE t MATCH 'NOT fast';" :error "fts5: syntax error near \"NOT\"")
 ("SELECT rowid FROM t WHERE t MATCH 'Fast';" :rows ("rowid")
  ((1)
   (3)
   (5)
   (6)))
 ("SELECT rowid FROM t WHERE t MATCH 'fast' ORDER BY rowid DESC;" :rows ("rowid")
  ((6)
   (5)
   (3)
   (1)))
 ("SELECT rowid FROM t WHERE t MATCH 'fast' LIMIT 1;" :rows ("rowid")
  ((1)))
)
("fts5.test:fts5-ranking"
 ("CREATE VIRTUAL TABLE t USING fts5(title, body);" :ok)
 ("INSERT INTO t VALUES ('SQLite Tutorial', 'SQLite is a small fast reliable database engine');" :ok)
 ("INSERT INTO t VALUES ('Full-text search', 'the fts5 module provides full text search over documents');" :ok)
 ("INSERT INTO t VALUES ('Database design', 'normal forms and indexes make a database fast');" :ok)
 ("INSERT INTO t VALUES ('Search engines', 'a search engine ranks documents by relevance');" :ok)
 ("INSERT INTO t VALUES ('Fast food', 'not about databases at all but quick meals');" :ok)
 ("INSERT INTO t VALUES ('Engine room', 'the engine of a ship; the fast engine');" :ok)
 ("SELECT rowid, bm25(t) FROM t WHERE t MATCH 'fast';" :rows ("rowid" "bm25(t)")
  ((1 (:f "-1.0067516879219806e-06"))
   (3 (:f "-1.0067516879219806e-06"))
   (5 (:f "-1.0067516879219806e-06"))
   (6 (:f "-1.0067516879219806e-06"))))
 ("SELECT rowid, rank FROM t WHERE t MATCH 'fast' ORDER BY rank;" :rows ("rowid" "rank")
  ((1 (:f "-1.0067516879219806e-06"))
   (3 (:f "-1.0067516879219806e-06"))
   (5 (:f "-1.0067516879219806e-06"))
   (6 (:f "-1.0067516879219806e-06"))))
 ("SELECT rowid FROM t WHERE t MATCH 'engine' ORDER BY rank;" :rows ("rowid")
  ((6)
   (4)
   (1)))
 ("SELECT rowid, bm25(t, 10.0, 1.0) FROM t WHERE t MATCH 'fast OR search';" :rows ("rowid" "bm25(t, 10.0, 1.0)")
  ((1 (:f "-1.0067516879219806e-06"))
   (2 (:f "-1.1506307846817507"))
   (3 (:f "-1.0067516879219806e-06"))
   (4 (:f "-1.175891956536805"))
   (5 (:f "-1.966876740436758e-06"))
   (6 (:f "-1.0067516879219806e-06"))))
 ("SELECT rowid, bm25(t, 0, 5) FROM t WHERE t MATCH 'engine';" :rows ("rowid" "bm25(t, 0, 5)")
  ((1 (:f "-1.7784256559766762e-06"))
   (4 (:f "-1.804248453885453e-06"))
   (6 (:f "-1.966876740436758e-06"))))
 ("SELECT rowid, bm25(t) FROM t WHERE t MATCH '\"full text\" OR database';" :rows ("rowid" "bm25(t)")
  ((1 (:f "-0.59175521702824"))
   (2 (:f "-1.7002806091690006"))
   (3 (:f "-0.8119502874921707"))))
 ("SELECT rowid, bm25(t) FROM t WHERE t MATCH 'NEAR(fast engine)';" :rows ("rowid" "bm25(t)")
  ((1 (:f "-2.013503375843961e-06"))
   (6 (:f "-2.388120704906026e-06"))))
 ("SELECT rowid, bm25(t) FROM t WHERE t MATCH 'title:fast';" :rows ("rowid" "bm25(t)")
  ((5 (:f "-1.308055337361448"))))
 ("SELECT rowid, rank FROM t WHERE t MATCH 'fast' AND rank MATCH 'bm25(10.0, 5.0)' ORDER BY rank;" :rows ("rowid" "rank")
  ((5 (:f "-1.966876740436758e-06"))
   (1 (:f "-1.7784256559766762e-06"))
   (3 (:f "-1.7784256559766762e-06"))
   (6 (:f "-1.7784256559766762e-06"))))
 ("INSERT INTO t(t, rank) VALUES ('rank', 'bm25(1.0, 20.0)');" :ok)
 ("SELECT rowid, rank FROM t WHERE t MATCH 'fast' ORDER BY rank;" :rows ("rowid" "rank")
  ((1 (:f "-2.0769171245066932e-06"))
   (3 (:f "-2.0769171245066932e-06"))
   (6 (:f "-2.0769171245066932e-06"))
   (5 (:f "-1.0067516879219806e-06"))))
 ("SELECT * FROM t_config;" :rows ("k" "v")
  (("rank" "bm25(1.0, 20.0)")
   ("version" 4)))
 ("SELECT rowid, rank FROM t('fast', 'bm25(2.0)') ORDER BY rank;" :rows ("rowid" "rank")
  ((5 (:f "-1.3813690169840453e-06"))
   (1 (:f "-1.0067516879219806e-06"))
   (3 (:f "-1.0067516879219806e-06"))
   (6 (:f "-1.0067516879219806e-06"))))
 ("SELECT rowid, rank FROM t('fast', 'x');" :error "parse error in rank function: x")
 ("SELECT rank FROM t;" :rows ("rank")
  ((:null)
   (:null)
   (:null)
   (:null)
   (:null)
   (:null)))
 ("SELECT bm25(t) FROM t WHERE rowid = 1;" :rows ("bm25(t)")
  (((:f "-0.0"))))
 ("SELECT bm25(title) FROM t WHERE t MATCH 'fast';" :error "no such cursor: 0")
)
("fts5.test:fts5-highlight-snippet"
 ("CREATE VIRTUAL TABLE t USING fts5(title, body);" :ok)
 ("INSERT INTO t VALUES ('SQLite Tutorial', 'SQLite is a small fast reliable database engine. It is fast. Very fast indeed: really.');" :ok)
 ("INSERT INTO t VALUES ('Full-text search', 'The fts5 module provides full text search over documents. Search is fun.');" :ok)
 ("INSERT INTO t VALUES ('Engine room', 'the engine of a ship; the fast engine, the loud engine');" :ok)
 ("INSERT INTO t VALUES ('Unicode Café', 'Ünïcödé text: naïve café, résumé.  CAFÉ society.');" :ok)
 ("INSERT INTO t VALUES (NULL, 'engine without a title');" :ok)
 ("SELECT rowid, highlight(t, 0, '[', ']'), highlight(t, 1, '<b>', '</b>') FROM t WHERE t MATCH 'fast OR engine OR search';" :rows ("rowid" "highlight(t, 0, '[', ']')" "highlight(t, 1, '<b>', '</b>')")
  ((1 "SQLite Tutorial" "SQLite is a small <b>fast</b> reliable database <b>engine</b>. It is <b>fast</b>. Very <b>fast</b> indeed: really.")
   (2 "Full-text [search]" "The fts5 module provides full text <b>search</b> over documents. <b>Search</b> is fun.")
   (3 "[Engine] room" "the <b>engine</b> of a ship; the <b>fast</b> <b>engine</b>, the loud <b>engine</b>")
   (5 :null "<b>engine</b> without a title")))
 ("SELECT highlight(t, 1, '[', ']') FROM t WHERE t MATCH '\"fast engine\"';" :rows ("highlight(t, 1, '[', ']')")
  (("the engine of a ship; the [fast engine], the loud engine")))
 ("SELECT highlight(t, 1, '[', ']') FROM t WHERE t MATCH 'the engine';" :rows ("highlight(t, 1, '[', ']')")
  (("[the] [engine] of a ship; [the] fast [engine], [the] loud [engine]")))
 ("SELECT highlight(t, 1, '[', ']') FROM t WHERE t MATCH '\"the engine\" engine';" :rows ("highlight(t, 1, '[', ']')")
  (("[the engine] of a ship; the fast [engine], the loud [engine]")))
 ("SELECT highlight(t, 1, '[', ']') FROM t WHERE t MATCH 'NEAR(fast engine, 1)';" :rows ("highlight(t, 1, '[', ']')")
  (("the engine of a ship; the [fast] [engine], the loud engine")))
 ("SELECT highlight(t, 1, '(', ')') FROM t WHERE t MATCH 'cafe';" :rows ("highlight(t, 1, '(', ')')")
  (("Ünïcödé text: naïve (café), résumé.  (CAFÉ) society.")))
 ("SELECT highlight(t, 0, '(', ')') FROM t WHERE t MATCH 'cafe';" :rows ("highlight(t, 0, '(', ')')")
  (("Unicode (Café)")))
 ("SELECT highlight(t, 1, NULL, NULL) FROM t WHERE t MATCH 'search';" :rows ("highlight(t, 1, NULL, NULL)")
  (("The fts5 module provides full text search over documents. Search is fun.")))
 ("SELECT highlight(t, 0, '[', ']') FROM t WHERE t MATCH 'engine';" :rows ("highlight(t, 0, '[', ']')")
  (("SQLite Tutorial")
   ("[Engine] room")
   (:null)))
 ("SELECT highlight(t, 1, '[', ']') FROM t WHERE t MATCH 'sea*';" :rows ("highlight(t, 1, '[', ']')")
  (("The fts5 module provides full text [search] over documents. [Search] is fun.")))
 ("SELECT highlight(t, 1, '[', ']') FROM t;" :rows ("highlight(t, 1, '[', ']')")
  (("SQLite is a small fast reliable database engine. It is fast. Very fast indeed: really.")
   ("The fts5 module provides full text search over documents. Search is fun.")
   ("the engine of a ship; the fast engine, the loud engine")
   ("Ünïcödé text: naïve café, résumé.  CAFÉ society.")
   ("engine without a title")))
 ("SELECT snippet(t, 1, '[', ']', '...', 5) FROM t WHERE t MATCH 'fast';" :rows ("snippet(t, 1, '[', ']', '...', 5)")
  (("SQLite is a small [fast]...")
   ("...ship; the [fast] engine, the...")))
 ("SELECT snippet(t, 1, '[', ']', '...', 3) FROM t WHERE t MATCH 'engine';" :rows ("snippet(t, 1, '[', ']', '...', 3)")
  (("...database [engine]. It...")
   ("the [engine] of...")
   ("[engine] without a...")))
 ("SELECT snippet(t, -1, '[', ']', '...', 4) FROM t WHERE t MATCH 'search';" :rows ("snippet(t, -1, '[', ']', '...', 4)")
  (("...[search] over documents. [Search]...")))
 ("SELECT snippet(t, -1, '[', ']', '...', 10) FROM t WHERE t MATCH 'fast OR engine';" :rows ("snippet(t, -1, '[', ']', '...', 10)")
  (("SQLite is a small [fast] reliable database [engine]. It is...")
   ("the [engine] of a ship; the [fast] [engine], the loud...")
   ("[engine] without a title")))
 ("SELECT snippet(t, 1, '[', ']', '', 2) FROM t WHERE t MATCH 'really';" :rows ("snippet(t, 1, '[', ']', '', 2)")
  (("indeed: [really].")))
 ("SELECT snippet(t, 1, '<', '>', '…', 6) FROM t WHERE t MATCH 'fun';" :rows ("snippet(t, 1, '<', '>', '…', 6)")
  (("…Search is <fun>.")))
 ("SELECT snippet(t, 0, '[', ']', '...', 1) FROM t WHERE t MATCH 'tutorial';" :rows ("snippet(t, 0, '[', ']', '...', 1)")
  (("...[Tutorial]")))
 ("SELECT snippet(t, 1, '[', ']', '...', 64) FROM t WHERE t MATCH 'text';" :rows ("snippet(t, 1, '[', ']', '...', 64)")
  (("The fts5 module provides full [text] search over documents. Search is fun.")
   ("Ünïcödé [text]: naïve café, résumé.  CAFÉ society.")))
 ("SELECT highlight(t, 1, '[', ']', 'x') FROM t WHERE t MATCH 'fast';" :error "wrong number of arguments to function highlight()")
 ("SELECT snippet(t, 1) FROM t WHERE t MATCH 'fast';" :error "wrong number of arguments to function snippet()")
)
("fts5.test:fts5-options"
 ("CREATE VIRTUAL TABLE p USING fts5(a, b UNINDEXED, prefix='2 3', tokenize='porter');" :ok)
 ("INSERT INTO p VALUES ('running runners run', 'unindexed words');" :ok)
 ("INSERT INTO p VALUES ('the relational connections', 'more words');" :ok)
 ("SELECT id, hex(block) FROM p_data ORDER BY id;" :rows ("id" "hex(block)")
  ((1 "020600")
   (10 "000000000102020002010101020101")
   (137438953473 "0000002A043072756E0104020404036E65720102030003317275010602030300043272756E01060203030409080A")
   (274877906945 "000000510830636F6E6E656374020204010572656C61740202030103746865020202000331636F0202040102726502020301027468020202000432636F6E020204010372656C0202030103746865020202040C0A080807070908")))
 ("SELECT rowid FROM p WHERE p MATCH 'run';" :rows ("rowid")
  ((1)))
 ("SELECT rowid FROM p WHERE p MATCH 'runner';" :rows ("rowid")
  ((1)))
 ("SELECT rowid FROM p WHERE p MATCH 'relate';" :rows ("rowid")
  ((2)))
 ("SELECT rowid FROM p WHERE p MATCH 'unindexed';" :rows ("rowid")
  ())
 ("SELECT rowid FROM p WHERE p MATCH 'b:words';" :rows ("rowid")
  ())
 ("SELECT rowid FROM p WHERE p MATCH 'ru*';" :rows ("rowid")
  ((1)))
 ("SELECT rowid FROM p WHERE p MATCH 'rel*';" :rows ("rowid")
  ((2)))
 ("SELECT rowid FROM p WHERE p MATCH 'r*';" :rows ("rowid")
  ((1)
   (2)))
 ("SELECT rowid, b FROM p WHERE p MATCH 'connect';" :rows ("rowid" "b")
  ((2 "more words")))
 ("CREATE VIRTUAL TABLE tri USING fts5(x, tokenize='trigram');" :ok)
 ("INSERT INTO tri VALUES ('The Quick Brown fox');" :ok)
 ("INSERT INTO tri VALUES ('quicksand');" :ok)
 ("SELECT rowid FROM tri WHERE tri MATCH 'uic';" :rows ("rowid")
  ((1)
   (2)))
 ("SELECT rowid FROM tri WHERE tri MATCH 'QUICK';" :rows ("rowid")
  ((1)
   (2)))
 ("SELECT rowid FROM tri WHERE tri MATCH 'ck b';" :rows ("rowid")
  ())
 ("SELECT rowid FROM tri WHERE tri MATCH 'qu';" :rows ("rowid")
  ())
 ("SELECT highlight(tri, 0, '[', ']') FROM tri WHERE tri MATCH 'uick';" :rows ("highlight(tri, 0, '[', ']')")
  (("The Q[uick] Brown fox")
   ("q[uick]sand")))
 ("CREATE VIRTUAL TABLE asc USING fts5(x, tokenize=\"ascii separators '.' tokenchars '-'\");" :ok)
 ("INSERT INTO asc VALUES ('a-b.c d_e Füß');" :ok)
 ("SELECT rowid FROM asc WHERE asc MATCH '\"a-b\"';" :rows ("rowid")
  ((1)))
 ("SELECT rowid FROM asc WHERE asc MATCH 'c';" :rows ("rowid")
  ((1)))
 ("SELECT rowid FROM asc WHERE asc MATCH 'füß';" :rows ("rowid")
  ((1)))
 ("SELECT rowid FROM asc WHERE asc MATCH 'FÜSS';" :rows ("rowid")
  ())
 ("CREATE VIRTUAL TABLE ud USING fts5(x, tokenize='unicode61 remove_diacritics 0');" :ok)
 ("INSERT INTO ud VALUES ('café resume résumé');" :ok)
 ("SELECT rowid FROM ud WHERE ud MATCH 'cafe';" :rows ("rowid")
  ())
 ("SELECT rowid FROM ud WHERE ud MATCH 'café';" :rows ("rowid")
  ((1)))
 ("SELECT rowid FROM ud WHERE ud MATCH 'RÉSUMÉ';" :rows ("rowid")
  ((1)))
 ("CREATE VIRTUAL TABLE bad USING fts5(a, nosuch=1);" :error "unrecognized option: \"nosuch\"")
 ("CREATE VIRTUAL TABLE bad USING fts5(a, b nosuch);" :error "unrecognized column option: nosuch")
 ("CREATE VIRTUAL TABLE bad USING fts5(rank);" :error "reserved fts5 column name: rank")
 ("CREATE VIRTUAL TABLE bad USING fts5(rowid);" :error "reserved fts5 column name: rowid")
 ("CREATE VIRTUAL TABLE bad USING fts5(a, detail=x);" :error "malformed detail=... directive")
 ("CREATE VIRTUAL TABLE bad USING fts5(a, tokenize='nosuch');" :error "no such tokenizer: nosuch")
 ("CREATE VIRTUAL TABLE bad USING fts5(a, prefix='0');" :error "prefix length out of range (max 999)")
 ("CREATE VIRTUAL TABLE bad USING fts5(a, prefix='x');" :error "malformed prefix=... directive")
 ("CREATE VIRTUAL TABLE bad USING fts5(a, columnsize=2);" :error "malformed columnsize=... directive")
 ("SELECT name FROM sqlite_master WHERE name LIKE 'bad%';" :rows ("name")
  ())
)
