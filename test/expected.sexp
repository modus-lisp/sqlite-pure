   (5 7 3)))
 ("SELECT g, v, count(*) OVER (ORDER BY v ROWS UNBOUNDED PRECEDING EXCLUDE NO OTHERS) FROM t ORDER BY v, g;" :rows ("g" "v" "count(*) OVER (ORDER BY v ROWS UNBOUNDED PRECEDING EXCLUDE NO OTHERS)")
  ((4 :null 1)
   (1 1 2)
   (1 2 3)
   (2 2 4)
   (2 3 5)
   (3 3 6)
   (3 3 7)
   (5 7 8)))
 ("SELECT g, v, first_value(g) OVER w, last_value(g) OVER w, nth_value(g, 2) OVER w FROM t WINDOW w AS (ORDER BY v ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING EXCLUDE CURRENT ROW) ORDER BY v, g;" :rows ("g" "v" "first_value(g) OVER w" "last_value(g) OVER w" "nth_value(g, 2) OVER w")
  ((4 :null 1 1 :null)
