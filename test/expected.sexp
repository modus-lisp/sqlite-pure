("ddl.test:indexes-and-lookup"
 ("CREATE TABLE t(a, b, c);" :ok)
 ("CREATE INDEX ta ON t(a);" :ok)
 ("CREATE UNIQUE INDEX tbc ON t(b, c DESC);" :ok)
 ("INSERT INTO t VALUES (1, 'x', 1), (2, 'x', 2), (1, 'y', 3), (3, 'z', NULL);" :ok)
 ("SELECT c FROM t WHERE a = 1 ORDER BY c;" :rows ("c")
  ((1)
   (3)))
 ("SELECT a FROM t WHERE b = 'x' AND c = 2;" :rows ("a")
  ((2)))
 ("INSERT INTO t VALUES (9, 'x', 1);" :error "UNIQUE constraint failed: t.b, t.c")
 ("SELECT count(*) FROM t WHERE a = '1';" :rows ("count(*)")
  ((0)))
 ("SELECT type, name, tbl_name, sql FROM sqlite_schema ORDER BY name;" :rows ("type" "name" "tbl_name" "sql")
  (("table" "t" "t" "CREATE TABLE t(a, b, c)")
   ("index" "ta" "t" "CREATE INDEX ta ON t(a)")
   ("index" "tbc" "t" "CREATE UNIQUE INDEX tbc ON t(b, c DESC)")))
 ("CREATE INDEX ta ON t(b);" :error "index ta already exists")
 ("CREATE INDEX IF NOT EXISTS ta ON t(b);" :ok)
 ("DROP INDEX ta;" :ok)
 ("SELECT c FROM t WHERE a = 1 ORDER BY c;" :rows ("c")
  ((1)
   (3)))
 ("DROP INDEX ta;" :error "no such index: ta")
 ("DROP INDEX IF EXISTS ta;" :ok)
)
