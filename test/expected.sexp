   (1 2 1 2 2)
   (2 2 1 2 2)
   (2 3 2 3 3)
   (3 3 2 3 3)
   (3 3 3 5 5)
   (5 7 3 3 :null)))
 ("SELECT g, v, max(g) OVER (PARTITION BY v % 2 ORDER BY v RANGE BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING EXCLUDE TIES) FROM t ORDER BY g, v;" :rows ("g" "v" "max(g) OVER (PARTITION BY v % 2 ORDER BY v RANGE BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING EXCLUDE TIES)")
