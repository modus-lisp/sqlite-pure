  ((1234 (:f "46.0") (:f "56.0") (:f "586.0") (:f "598.0"))))
 ("SELECT * FROM box WHERE rowid = 2999;" :rows ("id" "minx" "maxx" "miny" "maxy")
  ((2999 (:f "81.0") (:f "88.0") (:f "271.0") (:f "280.0"))))
 ("SELECT * FROM box WHERE id = '17';" :rows ("id" "minx" "maxx" "miny" "maxy")
  ((17 (:f "623.0") (:f "623.0") (:f "393.0") (:f "397.0"))))
 ("SELECT * FROM box WHERE id = 17.5;" :rows ("id" "minx" "maxx" "miny" "maxy")
  ())
 ("SELECT * FROM box WHERE id = NULL;" :rows ("id" "minx" "maxx" "miny" "maxy")
  ())
 ("SELECT count(*) FROM box WHERE id BETWEEN 100 AND 199;" :rows ("count(*)")
  ((100)))
 ("SELECT b.id FROM box AS a JOIN box AS b ON b.minx >= a.minx AND b.maxx <= a.maxx AND b.miny >= a.miny AND b.maxy <= a.maxy WHERE a.id = 7 ORDER BY b.id;" :rows ("id")
  ((7)
   (1007)
   (2007)))
 ("SELECT count(*) FROM (SELECT 5 AS lo, 7 AS hi) q, box WHERE box.minx BETWEEN q.lo AND q.hi;" :rows ("count(*)")
