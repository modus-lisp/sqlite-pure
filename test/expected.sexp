  ((0 "id" "INTEGER" 0 :null 1)
   (1 "name" "TEXT" 1 "'x'" 0)
   (2 "score" "REAL" 0 :null 0)
   (3 "u" "" 0 :null 0)))
 ("PRAGMA index_list(t);" :rows ("seq" "name" "unique" "origin" "partial")
  ((0 "ts" 0 "c" 0)
   (1 "sqlite_autoindex_t_1" 1 "u" 0)))
 ("PRAGMA index_info(ts);" :rows ("seqno" "cid" "name")
  ((0 2 "score")
   (1 1 "name")))
 ("PRAGMA user_version;" :rows ("user_version")
  ((0)))
 ("PRAGMA user_version = 42;" :ok)
 ("PRAGMA user_version;" :rows ("user_version")
  ((42)))
 ("PRAGMA integrity_check;" :rows ("integrity_check")
  (("ok")))
)
("ddl.test:without-rowid"
 ("CREATE TABLE w(k TEXT, n INTEGER, v, PRIMARY KEY (k, n)) WITHOUT ROWID;" :ok)
 ("INSERT INTO w VALUES ('b', 2, 'b2'), ('a', 1, 'a1'), ('a', 2, 'a2');" :ok)
 ("SELECT * FROM w;" :rows ("k" "n" "v")
  (("a" 1 "a1")
   ("a" 2 "a2")
   ("b" 2 "b2")))
 ("SELECT v FROM w WHERE k = 'a' AND n = 2;" :rows ("v")
  (("a2")))
 ("INSERT INTO w VALUES ('a', 1, 'dup');" :error "UNIQUE constraint failed: w.k, w.n")
 ("INSERT OR REPLACE INTO w VALUES ('a', 1, 'new');" :ok)
 ("UPDATE w SET v = v || '!' WHERE k = 'b';" :ok)
 ("DELETE FROM w WHERE k = 'a' AND n = 2;" :ok)
 ("SELECT * FROM w;" :rows ("k" "n" "v")
  (("a" 1 "new")
   ("b" 2 "b2!")))
 ("SELECT rowid FROM w;" :error "no such column: rowid")
)
("ddl.test:without-rowid-secondary-index"
 ("CREATE TABLE w(p INTEGER, q TEXT, r, PRIMARY KEY (p, q)) WITHOUT ROWID;" :ok)
 ("CREATE INDEX wr ON w(r);" :ok)
 ("INSERT INTO w VALUES (1, 'a', 10), (2, 'b', 20), (3, 'c', 10);" :ok)
 ("SELECT p, q FROM w WHERE r = 10 ORDER BY p;" :rows ("p" "q")
  ((1 "a")
   (3 "c")))
 ("UPDATE w SET p = p + 100 WHERE r = 10;" :ok)
 ("SELECT * FROM w ORDER BY p;" :rows ("p" "q" "r")
  ((2 "b" 20)
   (101 "a" 10)
   (103 "c" 10)))
 ("DELETE FROM w WHERE r = 20;" :ok)
 ("SELECT count(*) FROM w;" :rows ("count(*)")
  ((2)))
 ("PRAGMA integrity_check;" :rows ("integrity_check")
  (("ok")))
)
