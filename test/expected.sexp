("fts3.test:fts3-basics"
 ("CREATE VIRTUAL TABLE t USING fts3(a, b);" :ok)
 ("SELECT type, name, tbl_name, rootpage, sql FROM sqlite_master ORDER BY rowid;" :rows ("type" "name" "tbl_name" "rootpage" "sql")
  (("table" "t" "t" 0 "CREATE VIRTUAL TABLE t USING fts3(a, b)")
   ("table" "t_content" "t_content" 2 "CREATE TABLE 't_content'(docid INTEGER PRIMARY KEY, 'c0a', 'c1b')")
   ("table" "t_segments" "t_segments" 3 "CREATE TABLE 't_segments'(blockid INTEGER PRIMARY KEY, block BLOB)")
   ("table" "t_segdir" "t_segdir" 4 "CREATE TABLE 't_segdir'(level INTEGER,idx INTEGER,start_block INTEGER,leaves_end_block INTEGER,end_block INTEGER,root BLOB,PRIMARY KEY(level, idx))")
   ("index" "sqlite_autoindex_t_segdir_1" "t_segdir" 5 :null)))
 ("INSERT INTO t VALUES ('hello world', 'the quick brown fox');" :ok)
 ("INSERT INTO t VALUES ('Hello again', 'lazy dog hello');" :ok)
 ("INSERT INTO t(docid, a, b) VALUES (10, 'third', 'row');" :ok)
