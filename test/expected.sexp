("json.test:json-basics"
 ("SELECT json(' { \"a\" : 1.0 , \"b\":[1e2, \"xA\\n\", true,null] } '), json('\"\\/\"'), json(' 12 '), json('-0.5E+3'), json(' [ ] ');" :rows ("json(' { \"a\" : 1.0 , \"b\":[1e2, \"xA\\n\", true,null] } ')" "json('\"\\/\"')" "json(' 12 ')" "json('-0.5E+3')" "json(' [ ] ')")
  (("{\"a\":1.0,\"b\":[1e2,\"xA\\n\",true,null]}" "\"\\/\"" "12" "-0.5E+3" "[]")))
 ("SELECT json_quote('a\"b\\c' || char(10) || char(1)), json_quote(1.5), json_quote(NULL), json_quote(3);" :rows ("json_quote('a\"b\\c' || char(10) || char(1))" "json_quote(1.5)" "json_quote(NULL)" "json_quote(3)")
  (("\"a\\\"b\\\\c\\n\\u0001\"" "1.5" "null" "3")))
