("fts5.test:fts5-content-modes"
 ("CREATE VIRTUAL TABLE cl USING fts5(a, content='');" :ok)
 ("INSERT INTO cl VALUES ('abc def');" :ok)
 ("INSERT INTO cl(rowid, a) VALUES (7, 'def ghi');" :ok)
 ("SELECT *, rowid FROM cl;" :rows ("a" "rowid")
  ((:null 1)
   (:null 7)))
 ("SELECT *, rowid FROM cl WHERE cl MATCH 'def';" :rows ("a" "rowid")
  ((:null 1)
   (:null 7)))
 ("DELETE FROM cl WHERE rowid = 1;" :error "cannot DELETE from contentless fts5 table: cl")
 ("UPDATE cl SET a = 'x';" :error "cannot UPDATE contentless fts5 table: cl")
 ("INSERT INTO cl(cl, rowid, a) VALUES ('delete', 1, 'abc def');" :ok)
 ("SELECT rowid FROM cl WHERE cl MATCH 'def';" :rows ("rowid")
  ((7)))
 ("SELECT sql FROM sqlite_master WHERE name LIKE 'cl%';" :rows ("sql")
  (("CREATE VIRTUAL TABLE cl USING fts5(a, content='')")
   ("CREATE TABLE 'cl_data'(id INTEGER PRIMARY KEY, block BLOB)")
   ("CREATE TABLE 'cl_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID")
   ("CREATE TABLE 'cl_docsize'(id INTEGER PRIMARY KEY, sz BLOB)")
   ("CREATE TABLE 'cl_config'(k PRIMARY KEY, v) WITHOUT ROWID")))
 ("INSERT INTO cl(cl) VALUES ('rebuild');" :error "'rebuild' may not be used with a contentless fts5 table")
 ("INSERT INTO cl(cl) VALUES ('delete-all');" :ok)
 ("SELECT rowid FROM cl WHERE cl MATCH 'def';" :rows ("rowid")
  ())
 ("CREATE TABLE src(id INTEGER PRIMARY KEY, t, u);" :ok)
 ("INSERT INTO src VALUES (7, 'external text', 'more'), (9, 'other text', 'stuff');" :ok)
 ("CREATE VIRTUAL TABLE ex USING fts5(t, u, content='src', content_rowid='id');" :ok)
 ("INSERT INTO ex(ex) VALUES ('rebuild');" :ok)
 ("SELECT *, rowid FROM ex WHERE ex MATCH 'text';" :rows ("t" "u" "rowid")
  (("external text" "more" 7)
   ("other text" "stuff" 9)))
 ("SELECT * FROM ex;" :rows ("t" "u")
  (("external text" "more")
   ("other text" "stuff")))
 ("SELECT highlight(ex, 0, '[', ']') FROM ex WHERE ex MATCH 'other';" :rows ("highlight(ex, 0, '[', ']')")
  (("[other] text")))
 ("INSERT INTO ex(ex, rowid, t, u) VALUES ('delete', 7, 'external text', 'more');" :ok)
 ("SELECT rowid FROM ex WHERE ex MATCH 'text';" :rows ("rowid")
  ((9)))
 ("INSERT INTO ex(ex) VALUES ('integrity-check');" :ok)
 ("DELETE FROM ex WHERE rowid = 9;" :ok)
 ("SELECT rowid FROM ex WHERE ex MATCH 'text';" :rows ("rowid")
  ())
 ("CREATE VIRTUAL TABLE ft USING fts5(a);" :ok)
 ("INSERT INTO ft(ft) VALUES ('delete-all');" :error "'delete-all' may only be used with a contentless or external content fts5 table")
 ("INSERT INTO ft(ft, rowid, a) VALUES ('delete', 1, 'x');" :error "SQL logic error")
 ("INSERT INTO ft(ft) VALUES ('nonsense');" :error "SQL logic error")
 ("INSERT INTO ft(ft, rank) VALUES ('automerge', 8);" :ok)
 ("INSERT INTO ft(ft, rank) VALUES ('automerge', 'x');" :error "SQL logic error")
 ("INSERT INTO ft(ft, rank) VALUES ('pgsz', 10);" :error "SQL logic error")
 ("INSERT INTO ft(ft, rank) VALUES ('crisismerge', 1);" :ok)
 ("INSERT INTO ft(ft, rank) VALUES ('usermerge', 3);" :ok)
 ("SELECT * FROM ft_config;" :rows ("k" "v")
  (("automerge" 8)
   ("crisismerge" 1)
   ("usermerge" 3)
   ("version" 4)))
 ("SELECT id, hex(block) FROM ft_data WHERE id = 10;" :rows ("id" "hex(block)")
  ((10 "00000003000000")))
 ("INSERT INTO ft VALUES ('dup');" :ok)
 ("INSERT INTO ft(rowid, a) VALUES (1, 'dup');" :error "constraint failed")
 ("INSERT OR REPLACE INTO ft(rowid, a) VALUES (1, 'replaced');" :ok)
 ("INSERT OR IGNORE INTO ft(rowid, a) VALUES (1, 'ignored');" :error "constraint failed")
 ("SELECT rowid, a FROM ft;" :rows ("rowid" "a")
  ((1 "replaced")))
 ("SELECT rowid FROM ft WHERE ft MATCH 'dup';" :rows ("rowid")
  ())
 ("SELECT rowid FROM ft WHERE ft MATCH 'replaced';" :rows ("rowid")
  ((1)))
)
("fts5.test:fts5-ddl"
 ("CREATE VIRTUAL TABLE ft USING fts5(a, b);" :ok)
 ("INSERT INTO ft VALUES ('one two', 'three');" :ok)
 ("ALTER TABLE ft RENAME TO f2;" :ok)
 ("SELECT type, name, tbl_name, sql FROM sqlite_master ORDER BY rowid;" :rows ("type" "name" "tbl_name" "sql")
  (("table" "f2" "f2" "CREATE VIRTUAL TABLE \"f2\" USING fts5(a, b)")
   ("table" "f2_data" "f2_data" "CREATE TABLE \"f2_data\"(id INTEGER PRIMARY KEY, block BLOB)")
   ("table" "f2_idx" "f2_idx" "CREATE TABLE \"f2_idx\"(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID")
   ("table" "f2_content" "f2_content" "CREATE TABLE \"f2_content\"(id INTEGER PRIMARY KEY, c0, c1)")
   ("table" "f2_docsize" "f2_docsize" "CREATE TABLE \"f2_docsize\"(id INTEGER PRIMARY KEY, sz BLOB)")
   ("table" "f2_config" "f2_config" "CREATE TABLE \"f2_config\"(k PRIMARY KEY, v) WITHOUT ROWID")))
 ("SELECT rowid FROM f2 WHERE f2 MATCH 'two';" :rows ("rowid")
  ((1)))
 ("CREATE INDEX i ON f2(a);" :error "virtual tables may not be indexed")
 ("CREATE TRIGGER tr AFTER INSERT ON f2 BEGIN SELECT 1; END;" :error "cannot create triggers on virtual tables")
 ("ALTER TABLE f2 ADD COLUMN c;" :error "virtual tables may not be altered")
 ("PRAGMA table_list;" :rows ("schema" "name" "type" "ncol" "wr" "strict")
  (("main" "f2_config" "shadow" 2 1 0)
   ("main" "f2_docsize" "shadow" 2 0 0)
   ("main" "f2_content" "shadow" 3 0 0)
   ("main" "f2_idx" "shadow" 3 1 0)
   ("main" "f2_data" "shadow" 2 0 0)
   ("main" "f2" "virtual" 4 0 0)
   ("main" "sqlite_schema" "table" 5 0 0)
   ("temp" "sqlite_temp_schema" "table" 5 0 0)))
 ("DROP TABLE f2;" :ok)
 ("SELECT name FROM sqlite_master;" :rows ("name")
  ())
 ("CREATE VIRTUAL TABLE IF NOT EXISTS g USING fts5(x);" :ok)
 ("CREATE VIRTUAL TABLE IF NOT EXISTS g USING fts5(x);" :ok)
 ("CREATE VIRTUAL TABLE g USING fts5(x);" :error "table g already exists")
 ("CREATE TABLE log(x);" :ok)
 ("CREATE TRIGGER tl AFTER INSERT ON log BEGIN INSERT INTO g VALUES (new.x); END;" :ok)
 ("INSERT INTO log VALUES ('from a trigger');" :ok)
 ("SELECT rowid FROM g WHERE g MATCH 'trigger';" :rows ("rowid")
  ((1)))
 ("BEGIN;" :ok)
 ("INSERT INTO g VALUES ('in a transaction');" :ok)
 ("INSERT INTO g VALUES ('another one');" :ok)
 ("SELECT rowid FROM g WHERE g MATCH 'another';" :rows ("rowid")
  ((3)))
 ("ROLLBACK;" :ok)
 ("SELECT rowid FROM g WHERE g MATCH 'another';" :rows ("rowid")
  ())
 ("SELECT count(*) FROM g;" :rows ("count(*)")
  ((1)))
)
("json.test:json-basics"
 ("SELECT json(' { \"a\" : 1.0 , \"b\":[1e2, \"xA\\n\", true,null] } '), json('\"\\/\"'), json(' 12 '), json('-0.5E+3'), json(' [ ] ');" :rows ("json(' { \"a\" : 1.0 , \"b\":[1e2, \"xA\\n\", true,null] } ')" "json('\"\\/\"')" "json(' 12 ')" "json('-0.5E+3')" "json(' [ ] ')")
  (("{\"a\":1.0,\"b\":[1e2,\"xA\\n\",true,null]}" "\"\\/\"" "12" "-0.5E+3" "[]")))
 ("SELECT json_quote('a\"b\\c' || char(10) || char(1)), json_quote(1.5), json_quote(NULL), json_quote(3);" :rows ("json_quote('a\"b\\c' || char(10) || char(1))" "json_quote(1.5)" "json_quote(NULL)" "json_quote(3)")
  (("\"a\\\"b\\\\c\\n\\u0001\"" "1.5" "null" "3")))
 ("SELECT json_valid('{\"a\":}'), json_valid('[1,2]'), json_valid(NULL), json_valid(12), json_valid('[1,2,]');" :rows ("json_valid('{\"a\":}')" "json_valid('[1,2]')" "json_valid(NULL)" "json_valid(12)" "json_valid('[1,2,]')")
  ((0 1 0 1 0)))
 ("SELECT json('[1');" :error "malformed JSON")
 ("SELECT json('[1,2,]');" :error "malformed JSON")
)
("json.test:json-extract"
 ("SELECT json_extract('{\"a\":{\"b\":[10,20,{\"c\":\"x\"}]}}', '$.a.b[2].c'), json_extract('[1,2,3]', '$[#-1]'), json_extract('{\"a\":1}', '$.x');" :rows ("json_extract('{\"a\":{\"b\":[10,20,{\"c\":\"x\"}]}}', '$.a.b[2].c')" "json_extract('[1,2,3]', '$[#-1]')" "json_extract('{\"a\":1}', '$.x')")
  (("x" 3 :null)))
 ("SELECT json_extract('{\"a\":1.5,\"b\":\"s\",\"c\":null,\"d\":true,\"e\":[1]}', '$.a', '$.b', '$.c', '$.d', '$.e');" :rows ("json_extract('{\"a\":1.5,\"b\":\"s\",\"c\":null,\"d\":true,\"e\":[1]}', '$.a', '$.b', '$.c', '$.d', '$.e')")
  (("[1.5,\"s\",null,true,[1]]")))
 ("SELECT json_extract('{\"a\":-0}', '$.a'), json_extract('{\"a\":12345678901234567890}', '$.a'), json_extract('{\"a b\":1}', '$.\"a b\"');" :rows ("json_extract('{\"a\":-0}', '$.a')" "json_extract('{\"a\":12345678901234567890}', '$.a')" "json_extract('{\"a b\":1}', '$.\"a b\"')")
  ((0 (:f "1.2345678901234567e+19") 1)))
 ("SELECT json_extract('\"é\\/\"', '$'), typeof(json_extract('{\"a\":[]}', '$.a')), json_extract('{\"a\":true}', '$.a'), json_extract('[[1]]', '$[0][0]');" :rows ("json_extract('\"é\\/\"', '$')" "typeof(json_extract('{\"a\":[]}', '$.a'))" "json_extract('{\"a\":true}', '$.a')" "json_extract('[[1]]', '$[0][0]')")
  (("é/" "text" 1 1)))
 ("SELECT json_extract('{\"a\":1,\"a\":2}', '$.a'), json('{\"a\":1,\"a\":2}');" :rows ("json_extract('{\"a\":1,\"a\":2}', '$.a')" "json('{\"a\":1,\"a\":2}')")
  ((1 "{\"a\":1,\"a\":2}")))
 ("SELECT json_extract('[1]', 'a');" :error "JSON path error near 'a'")
 ("SELECT '{\"a\":[1,2]}' -> '$.a', '{\"a\":[1,2]}' ->> 'a', '[5,6]' -> 1, '{\"a\":\"x\"}' -> 'a', '{\"a\":\"x\"}' ->> 'a', '{\"a\":{\"b\":3}}' -> 'a' ->> 'b';" :rows ("'{\"a\":[1,2]}' -> '$.a'" "'{\"a\":[1,2]}' ->> 'a'" "'[5,6]' -> 1" "'{\"a\":\"x\"}' -> 'a'" "'{\"a\":\"x\"}' ->> 'a'" "'{\"a\":{\"b\":3}}' -> 'a' ->> 'b'")
  (("[1,2]" "[1,2]" "6" "\"x\"" "x" 3)))
)
("json.test:json-build"
 ("SELECT json_array(1, 'x', NULL, 2.5, json('[3]'), '[4]'), json_object('a', 1, 'b', json_array(2)), json_object('k', 1.0), json_array(1e100, -0.0, 0.1);" :rows ("json_array(1, 'x', NULL, 2.5, json('[3]'), '[4]')" "json_object('a', 1, 'b', json_array(2))" "json_object('k', 1.0)" "json_array(1e100, -0.0, 0.1)")
  (("[1,\"x\",null,2.5,[3],\"[4]\"]" "{\"a\":1,\"b\":[2]}" "{\"k\":1.0}" "[1.0e+100,0.0,0.1]")))
 ("SELECT json_array(json_extract('{\"a\":[1]}', '$.a')), json_array('{\"a\":1}' -> '$'), json_object('n', json('null'));" :rows ("json_array(json_extract('{\"a\":[1]}', '$.a'))" "json_array('{\"a\":1}' -> '$')" "json_object('n', json('null'))")
  (("[[1]]" "[{\"a\":1}]" "{\"n\":null}")))
 ("SELECT json_array(x'01');" :error "JSON cannot hold BLOB values")
 ("SELECT json_group_array(x) FROM (SELECT 1 x UNION ALL SELECT 'a' UNION ALL SELECT NULL);" :rows ("json_group_array(x)")
  (("[1,\"a\",null]")))
 ("SELECT json_group_object(k, v) FROM (SELECT 'a' k, 1 v UNION ALL SELECT 'b', 2);" :rows ("json_group_object(k, v)")
  (("{\"a\":1,\"b\":2}")))
)
("json.test:json-modify"
 ("SELECT json_insert('{\"a\":1}', '$.b', 2, '$.a', 9), json_replace('{\"a\":1}', '$.a', 'x', '$.c', 3), json_set('{\"a\":1}', '$.a', 2, '$.c[0]', 3);" :rows ("json_insert('{\"a\":1}', '$.b', 2, '$.a', 9)" "json_replace('{\"a\":1}', '$.a', 'x', '$.c', 3)" "json_set('{\"a\":1}', '$.a', 2, '$.c[0]', 3)")
  (("{\"a\":1,\"b\":2}" "{\"a\":\"x\"}" "{\"a\":2,\"c\":[3]}")))
 ("SELECT json_set('[1,2]', '$[#]', 3), json_remove('[1,2,3]', '$[1]'), json_remove('{\"a\":1,\"b\":2}', '$.a'), json_set('{}', '$.a.b', 1), json_insert('[]', '$[5]', 1);" :rows ("json_set('[1,2]', '$[#]', 3)" "json_remove('[1,2,3]', '$[1]')" "json_remove('{\"a\":1,\"b\":2}', '$.a')" "json_set('{}', '$.a.b', 1)" "json_insert('[]', '$[5]', 1)")
  (("[1,2,3]" "[1,3]" "{\"b\":2}" "{\"a\":{\"b\":1}}" "[]")))
 ("SELECT json_patch('{\"a\":1,\"b\":{\"c\":2}}', '{\"b\":{\"c\":null,\"d\":4},\"e\":5}'), json_patch('[1]', '{\"a\":1}'), json_patch('{\"a\":1}', '[2]');" :rows ("json_patch('{\"a\":1,\"b\":{\"c\":2}}', '{\"b\":{\"c\":null,\"d\":4},\"e\":5}')" "json_patch('[1]', '{\"a\":1}')" "json_patch('{\"a\":1}', '[2]')")
  (("{\"a\":1,\"b\":{\"d\":4},\"e\":5}" "{\"a\":1}" "[2]")))
 ("SELECT json_type('{\"a\":1.5}', '$.a'), json_type('[1]'), json_type('{\"a\":1}', '$.b'), json_type('{\"a\":\"s\",\"b\":null,\"c\":false,\"d\":7}', '$.c'), json_array_length('[1,2,3]'), json_array_length('{\"a\":[1,2]}', '$.a'), json_array_length('5');" :rows ("json_type('{\"a\":1.5}', '$.a')" "json_type('[1]')" "json_type('{\"a\":1}', '$.b')" "json_type('{\"a\":\"s\",\"b\":null,\"c\":false,\"d\":7}', '$.c')" "json_array_length('[1,2,3]')" "json_array_length('{\"a\":[1,2]}', '$.a')" "json_array_length('5')")
  (("real" "array" :null "false" 3 2 0)))
)
("json.test:json-each-tree"
 ("SELECT * FROM json_each('{\"a\":1,\"b\":[2,3],\"c\":{\"d\":null}}');" :rows ("key" "value" "type" "atom" "id" "parent" "fullkey" "path")
  (("a" 1 "integer" 1 2 :null "$.a" "$")
   ("b" "[2,3]" "array" :null 4 :null "$.b" "$")
   ("c" "{\"d\":null}" "object" :null 8 :null "$.c" "$")))
 ("SELECT key, value, type, atom, id, parent, fullkey, path FROM json_tree('{\"a\":1,\"b\":[2,{\"x\":\"y\"}]}');" :rows ("key" "value" "type" "atom" "id" "parent" "fullkey" "path")
  ((:null "{\"a\":1,\"b\":[2,{\"x\":\"y\"}]}" "object" :null 0 :null "$" "$")
   ("a" 1 "integer" 1 2 0 "$.a" "$")
   ("b" "[2,{\"x\":\"y\"}]" "array" :null 4 0 "$.b" "$")
   (0 2 "integer" 2 5 4 "$.b[0]" "$.b")
   (1 "{\"x\":\"y\"}" "object" :null 6 4 "$.b[1]" "$.b")
   ("x" "y" "text" "y" 8 6 "$.b[1].x" "$.b[1]")))
 ("SELECT key, value FROM json_each('{\"a\":{\"b\":[7,8]}}', '$.a.b');" :rows ("key" "value")
  ((0 7)
   (1 8)))
 ("SELECT key, value FROM json_each('5');" :rows ("key" "value")
  ((:null 5)))
 ("CREATE TABLE doc(id INTEGER PRIMARY KEY, body TEXT);" :ok)
 ("INSERT INTO doc VALUES (1, '{\"tags\":[\"a\",\"b\"],\"n\":1}'), (2, '{\"tags\":[\"c\"],\"n\":2}'), (3, '{\"n\":3}');" :ok)
 ("SELECT doc.id, j.value FROM doc, json_each(doc.body, '$.tags') AS j ORDER BY doc.id, j.key;" :rows ("id" "value")
  ((1 "a")
   (1 "b")
   (2 "c")))
 ("SELECT id FROM doc WHERE EXISTS (SELECT 1 FROM json_each(doc.body, '$.tags') WHERE value = 'c');" :rows ("id")
  ((2)))
 ("SELECT body ->> '$.n' AS n, json_array_length(body, '$.tags') FROM doc ORDER BY n;" :rows ("n" "json_array_length(body, '$.tags')")
  ((1 2)
   (2 1)
   (3 :null)))
 ("SELECT count(*) FROM doc, json_tree(doc.body);" :rows ("count(*)")
  ((11)))
)
("json.test:json-each-hidden-columns"
 ("SELECT json, root, key FROM json_each('[1,2]');" :rows ("json" "root" "key")
  (("[1,2]" "$" 0)
   ("[1,2]" "$" 1)))
 ("SELECT * FROM json_each('[1]') AS a NATURAL JOIN json_each('[1]') AS b;" :rows ("key" "value" "type" "atom" "id" "parent" "fullkey" "path")
  ())
 ("SELECT j.json FROM json_tree('{\"a\":1}') AS j WHERE j.key = 'a';" :rows ("json")
  (("{\"a\":1}")))
)
("multidb.test:temp-tables"
 ("CREATE TABLE t(a);" :ok)
 ("INSERT INTO t VALUES (1), (2);" :ok)
 ("CREATE TEMP TABLE t(b);" :ok)
 ("INSERT INTO t VALUES ('temp');" :ok)
 ("SELECT * FROM t;" :rows ("b")
  (("temp")))
 ("SELECT * FROM main.t ORDER BY a;" :rows ("a")
  ((1)
   (2)))
 ("SELECT * FROM temp.t;" :rows ("b")
  (("temp")))
 ("SELECT name FROM sqlite_temp_master;" :rows ("name")
  (("t")))
 ("SELECT name FROM sqlite_master;" :rows ("name")
  (("t")))
 ("DROP TABLE t;" :ok)
 ("SELECT * FROM t ORDER BY a;" :rows ("a")
  ((1)
   (2)))
 ("CREATE TEMPORARY TABLE tt(x PRIMARY KEY, y);" :ok)
 ("INSERT INTO tt VALUES (1, 'a'), (2, 'b');" :ok)
 ("INSERT INTO tt VALUES (1, 'dup');" :error "UNIQUE constraint failed: tt.x")
 ("CREATE INDEX temp.tty ON tt(y);" :ok)
 ("SELECT x FROM tt WHERE y = 'b';" :rows ("x")
  ((2)))
 ("SELECT type, name FROM temp.sqlite_master ORDER BY name;" :rows ("type" "name")
  (("index" "sqlite_autoindex_tt_1")
   ("table" "tt")
   ("index" "tty")))
 ("CREATE TEMP VIEW v AS SELECT a FROM main.t;" :ok)
 ("SELECT * FROM v ORDER BY a;" :rows ("a")
  ((1)
   (2)))
)
("multidb.test:temp-trigger-on-main"
 ("CREATE TABLE t(a);" :ok)
 ("CREATE TEMP TABLE log(m);" :ok)
 ("CREATE TEMP TRIGGER tr AFTER INSERT ON t BEGIN INSERT INTO log VALUES (new.a * 10); END;" :ok)
 ("INSERT INTO t VALUES (1), (2);" :ok)
 ("SELECT m FROM log ORDER BY m;" :rows ("m")
  ((10)
   (20)))
 ("SELECT count(*) FROM sqlite_master WHERE type = 'trigger';" :rows ("count(*)")
  ((0)))
)
("multidb.test:attach-memory"
 ("CREATE TABLE t(a);" :ok)
 ("INSERT INTO t VALUES (1);" :ok)
 ("ATTACH DATABASE ':memory:' AS aux;" :ok)
 ("CREATE TABLE aux.t(a);" :ok)
 ("INSERT INTO aux.t VALUES (100), (200);" :ok)
 ("SELECT a FROM t;" :rows ("a")
  ((1)))
 ("SELECT a FROM aux.t ORDER BY a;" :rows ("a")
  ((100)
   (200)))
 ("SELECT m.a, x.a FROM main.t m, aux.t x ORDER BY 2;" :rows ("a" "a")
  ((1 100)
   (1 200)))
 ("CREATE TABLE aux.u(z UNIQUE);" :ok)
 ("INSERT INTO u VALUES (1);" :ok)
 ("INSERT INTO aux.u VALUES (1);" :error "UNIQUE constraint failed: u.z")
 ("SELECT name FROM aux.sqlite_master ORDER BY name;" :rows ("name")
  (("sqlite_autoindex_u_1")
   ("t")
   ("u")))
 ("PRAGMA database_list;" :rows ("seq" "name" "file")
  ((0 "main" "")
   (2 "aux" "")))
 ("BEGIN;" :ok)
 ("INSERT INTO aux.t VALUES (300);" :ok)
 ("INSERT INTO main.t VALUES (2);" :ok)
 ("ROLLBACK;" :ok)
 ("SELECT (SELECT count(*) FROM main.t), (SELECT count(*) FROM aux.t);" :rows ("(SELECT count(*) FROM main.t)" "(SELECT count(*) FROM aux.t)")
  ((1 2)))
 ("ATTACH ':memory:' AS aux;" :error "database aux is already in use")
 ("DETACH aux;" :ok)
 ("SELECT * FROM aux.t;" :error "no such table: aux.t")
 ("DETACH nosuch;" :error "no such database: nosuch")
)
("rtree.test:rtree-basics"
 ("CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1, y0, y1, +name, +extra);" :ok)
 ("SELECT type, name, tbl_name, rootpage, sql FROM sqlite_master ORDER BY rowid;" :rows ("type" "name" "tbl_name" "rootpage" "sql")
  (("table" "rt" "rt" 0 "CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1, y0, y1, +name, +extra)")
   ("table" "rt_rowid" "rt_rowid" 2 "CREATE TABLE \"rt_rowid\"(rowid INTEGER PRIMARY KEY,nodeno,a0,a1)")
   ("table" "rt_node" "rt_node" 3 "CREATE TABLE \"rt_node\"(nodeno INTEGER PRIMARY KEY,data)")
   ("table" "rt_parent" "rt_parent" 4 "CREATE TABLE \"rt_parent\"(nodeno INTEGER PRIMARY KEY,parentnode)")))
 ("INSERT INTO rt VALUES (1, 0.1, 0.2, 1, 5, 'n', 3);" :ok)
 ("INSERT INTO rt(x0, x1, y0, y1) VALUES (-0.1, 1e40, 2, 2);" :ok)
 ("SELECT * FROM rt ORDER BY id;" :rows ("id" "x0" "x1" "y0" "y1" "name" "extra")
  ((1 (:f "0.09999998658895493") (:f "0.20000000298023224") (:f "1.0") (:f "5.0") "n" 3)
   (2 (:f "-0.10000000149011612") :inf (:f "2.0") (:f "2.0") :null :null)))
 ("SELECT hex(data) FROM rt_node;" :rows ("hex(data)")
  (("")))
 ("SELECT rtreenode(2, data) FROM rt_node;" :rows ("rtreenode(2, data)")
  (("{1 0.1 0.2 1 5} {2 -0.1 Inf 2 2}")))
 ("SELECT * FROM rt_rowid ORDER BY rowid;" :rows ("rowid" "nodeno" "a0" "a1")
  ((1 1 "n" 3)
   (2 1 :null :null)))
 ("SELECT count(*) FROM rt_parent;" :rows ("count(*)")
  ((0)))
 ("PRAGMA table_info(rt);" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk")
  ((0 "id" "INT" 0 :null 0)
   (1 "x0" "REAL" 0 :null 0)
   (2 "x1" "REAL" 0 :null 0)
   (3 "y0" "REAL" 0 :null 0)
   (4 "y1" "REAL" 0 :null 0)
   (5 "name" "" 0 :null 0)
   (6 "extra" "" 0 :null 0)))
 ("SELECT rowid, id FROM rt ORDER BY 1;" :rows ("rowid" "id")
  ((1 1)
   (2 2)))
 ("SELECT typeof(id), typeof(x0), typeof(name) FROM rt ORDER BY id;" :rows ("typeof(id)" "typeof(x0)" "typeof(name)")
  (("integer" "real" "text")
   ("integer" "real" "null")))
 ("SELECT rtreecheck('rt');" :rows ("rtreecheck('rt')")
  (("ok")))
 ("SELECT rtreecheck('main', 'rt');" :rows ("rtreecheck('main', 'rt')")
  (("ok")))
)
("rtree.test:rtree-errors"
 ("CREATE VIRTUAL TABLE bad USING rtree(a, b);" :error "Too few columns for an rtree table")
 ("CREATE VIRTUAL TABLE bad USING rtree(a, b, c, d);" :error "Wrong number of columns for an rtree table")
 ("CREATE VIRTUAL TABLE bad USING rtree(a, b, c, +d, e, f);" :error "Auxiliary rtree columns must be last")
 ("CREATE VIRTUAL TABLE bad USING rtree(a,b,c,d,e,f,g,h,i,j,k,l,m);" :error "Too many columns for an rtree table")
 ("CREATE VIRTUAL TABLE bad USING rtree;" :error "Too few columns for an rtree table")
 ("CREATE VIRTUAL TABLE bad USING rtree();" :error "Too few columns for an rtree table")
 ("CREATE VIRTUAL TABLE bad USING nosuch(a);" :error "no such module: nosuch")
 ("CREATE VIRTUAL TABLE r USING rtree(id, a, b);" :ok)
 ("CREATE VIRTUAL TABLE r USING rtree(id, a, b);" :error "table r already exists")
 ("CREATE VIRTUAL TABLE IF NOT EXISTS r USING rtree(id, a, b);" :ok)
 ("CREATE INDEX ri ON r(a);" :error "virtual tables may not be indexed")
 ("CREATE TRIGGER rtr AFTER INSERT ON r BEGIN SELECT 1; END;" :error "cannot create triggers on virtual tables")
 ("ALTER TABLE r ADD COLUMN z;" :error "virtual tables may not be altered")
 ("ALTER TABLE r RENAME COLUMN a TO q;" :error "cannot rename columns of virtual table \"r\"")
 ("INSERT INTO r VALUES (1, 5, 1);" :error "rtree constraint failed: r.(a<=b)")
 ("INSERT INTO r VALUES (1, 1, 5);" :ok)
 ("INSERT INTO r VALUES (1, 1, 5);" :error "UNIQUE constraint failed: r.id")
 ("INSERT INTO r VALUES (1, 2);" :error "table r has 3 columns but 2 values were supplied")
 ("INSERT INTO r(id, a) VALUES (30, 1);" :error "rtree constraint failed: r.(a<=b)")
 ("INSERT OR IGNORE INTO r VALUES (1, 2, 2);" :ok)
 ("INSERT OR IGNORE INTO r VALUES (2, 9, 2);" :ok)
 ("INSERT OR REPLACE INTO r VALUES (1, 3, 4);" :ok)
 ("INSERT OR REPLACE INTO r VALUES (3, 9, 4);" :error "rtree constraint failed: r.(a<=b)")
 ("REPLACE INTO r VALUES (4, 0, 0);" :ok)
 ("UPDATE r SET a = 10 WHERE id = 1;" :error "rtree constraint failed: r.(a<=b)")
 ("SELECT * FROM r ORDER BY id;" :rows ("id" "a" "b")
  ((1 (:f "3.0") (:f "4.0"))
   (4 (:f "0.0") (:f "0.0"))))
 ("SELECT * FROM sqlite_master WHERE name = 'bad';" :rows ("type" "name" "tbl_name" "rootpage" "sql")
  ())
 ("PRAGMA table_list;" :rows ("schema" "name" "type" "ncol" "wr" "strict")
  (("main" "r_parent" "shadow" 2 0 0)
