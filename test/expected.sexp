  ((2 0 0 "SCAN json_tree VIRTUAL TABLE INDEX 1:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t, json_each(t.c);" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SCAN t")
   (5 0 0 "SCAN json_each VIRTUAL TABLE INDEX 1:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM pragma_table_info('t');" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN pragma_table_info VIRTUAL TABLE INDEX 0:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM v;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "CO-ROUTINE v")
   (8 2 0 "SCAN t USING COVERING INDEX ta")
   (36 0 0 "SCAN v")))
 ("EXPLAIN QUERY PLAN DELETE FROM u WHERE id = 3;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid=?)")))
