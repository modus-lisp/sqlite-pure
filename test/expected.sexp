  ((134 760551 1293301)))
)
("dml.test:savepoints"
 ("CREATE TABLE t(a);" :ok)
 ("SAVEPOINT s1;" :ok)
 ("INSERT INTO t VALUES (1);" :ok)
 ("SAVEPOINT s2;" :ok)
 ("INSERT INTO t VALUES (2);" :ok)
 ("ROLLBACK TO s2;" :ok)
 ("INSERT INTO t VALUES (3);" :ok)
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (3)))
 ("RELEASE s1;" :ok)
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (3)))
 ("BEGIN;" :ok)
 ("INSERT INTO t VALUES (4);" :ok)
 ("SAVEPOINT x;" :ok)
 ("DELETE FROM t;" :ok)
 ("SELECT count(*) FROM t;" :rows ("count(*)")
  ((0)))
 ("ROLLBACK TO SAVEPOINT x;" :ok)
 ("SELECT count(*) FROM t;" :rows ("count(*)")
  ((3)))
 ("RELEASE SAVEPOINT x;" :ok)
 ("ROLLBACK;" :ok)
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (3)))
 ("RELEASE nosuch;" :error "no such savepoint: nosuch")
 ("SAVEPOINT a;" :ok)
 ("CREATE TABLE u(z);" :ok)
 ("ROLLBACK TO a;" :ok)
 ("SELECT name FROM sqlite_schema ORDER BY name;" :rows ("name")
  (("t")))
 ("RELEASE a;" :ok)
)
("dml.test:foreign-keys"
 ("PRAGMA foreign_keys = ON;" :ok)
 ("PRAGMA foreign_keys;" :rows ("foreign_keys")
  ((1)))
 ("CREATE TABLE p(id INTEGER PRIMARY KEY, name TEXT UNIQUE);" :ok)
 ("CREATE TABLE ch(id INTEGER PRIMARY KEY, pid REFERENCES p(id) ON DELETE CASCADE ON UPDATE CASCADE, pname TEXT REFERENCES p(name) ON DELETE SET NULL);" :ok)
 ("CREATE TABLE r(x REFERENCES p ON DELETE RESTRICT);" :ok)
 ("INSERT INTO p VALUES (1, 'a'), (2, 'b'), (3, 'c');" :ok)
 ("INSERT INTO ch VALUES (10, 1, 'a'), (11, 2, 'b'), (12, NULL, NULL);" :ok)
 ("INSERT INTO ch VALUES (13, 9, NULL);" :error "FOREIGN KEY constraint failed")
 ("INSERT INTO ch VALUES (14, NULL, 'zz');" :error "FOREIGN KEY constraint failed")
 ("DELETE FROM p WHERE id = 1;" :ok)
 ("SELECT * FROM ch ORDER BY id;" :rows ("id" "pid" "pname")
  ((11 2 "b")
   (12 :null :null)))
 ("UPDATE p SET id = 20 WHERE id = 2;" :ok)
 ("SELECT * FROM ch ORDER BY id;" :rows ("id" "pid" "pname")
  ((11 20 "b")
   (12 :null :null)))
 ("DELETE FROM p WHERE name = 'b';" :ok)
 ("SELECT * FROM ch ORDER BY id;" :rows ("id" "pid" "pname")
  ((12 :null :null)))
 ("INSERT INTO r VALUES (3);" :ok)
 ("DELETE FROM p WHERE id = 3;" :error "FOREIGN KEY constraint failed")
 ("SELECT * FROM p ORDER BY id;" :rows ("id" "name")
  ((3 "c")))
 ("PRAGMA foreign_key_list(ch);" :rows ("id" "seq" "table" "from" "to" "on_update" "on_delete" "match")
  ((0 0 "p" "pname" "name" "NO ACTION" "SET NULL" "NONE")
   (1 0 "p" "pid" "id" "CASCADE" "CASCADE" "NONE")))
 ("UPDATE ch SET pid = 5 WHERE id = 12;" :error "FOREIGN KEY constraint failed")
 ("CREATE TABLE d(x REFERENCES p(id) DEFERRABLE INITIALLY DEFERRED);" :ok)
 ("BEGIN;" :ok)
 ("INSERT INTO d VALUES (99);" :ok)
 ("COMMIT;" :error "FOREIGN KEY constraint failed")
 ("INSERT INTO p(id) VALUES (99);" :ok)
 ("COMMIT;" :ok)
 ("SELECT count(*) FROM d;" :rows ("count(*)")
  ((1)))
 ("CREATE TABLE sn(a, b, FOREIGN KEY (a, b) REFERENCES p2(x, y) ON DELETE SET NULL);" :ok)
 ("CREATE TABLE p2(x, y, UNIQUE (x, y));" :ok)
 ("INSERT INTO p2 VALUES (1, 2);" :ok)
 ("INSERT INTO sn VALUES (1, 2), (NULL, 5);" :ok)
 ("INSERT INTO sn VALUES (1, 3);" :error "FOREIGN KEY constraint failed")
 ("DELETE FROM p2;" :ok)
 ("SELECT * FROM sn ORDER BY rowid;" :rows ("a" "b")
  ((:null :null)
   (:null 5)))
 ("PRAGMA foreign_keys = OFF;" :ok)
 ("INSERT INTO ch VALUES (50, 777, NULL);" :ok)
 ("SELECT count(*) FROM ch;" :rows ("count(*)")
  ((2)))
)
("explain.test:eqp-access-paths"
 ("CREATE TABLE t(a, b, c);" :ok)
 ("CREATE INDEX ta ON t(a);" :ok)
 ("CREATE INDEX tab ON t(a, b);" :ok)
 ("CREATE TABLE u(id INTEGER PRIMARY KEY, x, y UNIQUE);" :ok)
 ("CREATE TABLE w(k PRIMARY KEY, v) WITHOUT ROWID;" :ok)
 ("CREATE TABLE p(q, r);" :ok)
 ("EXPLAIN QUERY PLAN SELECT * FROM t;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE a = 1;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING INDEX tab (a=?)")))
 ("EXPLAIN QUERY PLAN SELECT a, b FROM t WHERE a = 1;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH t USING COVERING INDEX tab (a=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE a = 1 AND b = 2;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING INDEX tab (a=? AND b=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE b = 2 AND a = 7;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING INDEX tab (a=? AND b=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u WHERE id = 5;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u WHERE rowid = 5;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u WHERE id > 5 AND id < 9;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid>? AND rowid<?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u WHERE id >= 5;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid>?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u WHERE id <= 5;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid<?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u WHERE y = 3;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH u USING INDEX sqlite_autoindex_u_1 (y=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM w WHERE k = 1;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH w USING PRIMARY KEY (k=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM w;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN w")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t AS x WHERE x.a = 1;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH x USING INDEX tab (a=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE b = 3;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE +a = 1;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE c IN (1, 2, 3);" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t NOT INDEXED WHERE a = 1;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")))
 ("EXPLAIN QUERY PLAN SELECT * FROM p;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN p")))
 ("EXPLAIN QUERY PLAN SELECT q FROM p WHERE r = 1;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN p")))
)
("explain.test:eqp-order-group-distinct"
 ("CREATE TABLE t(a, b, c);" :ok)
 ("CREATE INDEX ta ON t(a);" :ok)
 ("CREATE TABLE u(id INTEGER PRIMARY KEY, x, y UNIQUE);" :ok)
 ("EXPLAIN QUERY PLAN SELECT * FROM t ORDER BY a;" :rows ("id" "parent" "notused" "detail")
  ((4 0 0 "SCAN t USING INDEX ta")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t ORDER BY a DESC;" :rows ("id" "parent" "notused" "detail")
  ((4 0 0 "SCAN t USING INDEX ta")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t ORDER BY c;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SCAN t")
   (11 0 0 "USE TEMP B-TREE FOR ORDER BY")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t ORDER BY a;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SCAN t USING COVERING INDEX ta")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t ORDER BY a LIMIT 5;" :rows ("id" "parent" "notused" "detail")
  ((5 0 0 "SCAN t USING INDEX ta")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u ORDER BY id;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SCAN u")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u ORDER BY id DESC;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SCAN u")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u ORDER BY x;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SCAN u")
   (11 0 0 "USE TEMP B-TREE FOR ORDER BY")))
 ("EXPLAIN QUERY PLAN SELECT count(*) FROM t;" :rows ("id" "parent" "notused" "detail")
  ((4 0 0 "SCAN t USING COVERING INDEX ta")))
 ("EXPLAIN QUERY PLAN SELECT count(*) FROM u;" :rows ("id" "parent" "notused" "detail")
  ((4 0 0 "SCAN u USING COVERING INDEX sqlite_autoindex_u_1")))
 ("EXPLAIN QUERY PLAN SELECT a, count(*) FROM t GROUP BY a;" :rows ("id" "parent" "notused" "detail")
  ((6 0 0 "SCAN t USING COVERING INDEX ta")))
 ("EXPLAIN QUERY PLAN SELECT c, count(*) FROM t GROUP BY c;" :rows ("id" "parent" "notused" "detail")
  ((6 0 0 "SCAN t")
   (8 0 0 "USE TEMP B-TREE FOR GROUP BY")))
 ("EXPLAIN QUERY PLAN SELECT sum(a) FROM t GROUP BY c HAVING count(*) > 1 ORDER BY 1;" :rows ("id" "parent" "notused" "detail")
  ((7 0 0 "SCAN t")
   (9 0 0 "USE TEMP B-TREE FOR GROUP BY")
   (46 0 0 "USE TEMP B-TREE FOR ORDER BY")))
 ("EXPLAIN QUERY PLAN SELECT DISTINCT c FROM t;" :rows ("id" "parent" "notused" "detail")
