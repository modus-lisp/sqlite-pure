   (2 "cnt" "" 0 :null 0)))
 ("PRAGMA table_info(vi);" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk")
  ((0 "term" "" 0 :null 0)
   (1 "doc" "" 0 :null 0)
   (2 "col" "" 0 :null 0)
   (3 "offset" "" 0 :null 0)))
 ("SELECT sql FROM sqlite_master WHERE name LIKE 'v%';" :rows ("sql")
  (("CREATE VIRTUAL TABLE vr USING fts5vocab(ft, 'row')")
   ("CREATE VIRTUAL TABLE vc USING fts5vocab(ft, 'col')")
   ("CREATE VIRTUAL TABLE vi USING fts5vocab(ft, 'instance')")
   ("CREATE VIRTUAL TABLE vn USING fts5vocab(nosuch, 'row')")))
 ("INSERT INTO vr VALUES ('a', 1, 1);" :error "table vr may not be modified")
 ("DELETE FROM vr;" :error "table vr may not be modified")
