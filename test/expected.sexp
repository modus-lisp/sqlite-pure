("ddl.test:alter-table"
 ("CREATE TABLE t(a, b);" :ok)
 ("INSERT INTO t VALUES (1, 2);" :ok)
 ("ALTER TABLE t ADD COLUMN c TEXT DEFAULT 'dc';" :ok)
 ("ALTER TABLE t ADD d INTEGER;" :ok)
 ("SELECT * FROM t;" :rows ("a" "b" "c" "d")
  ((1 2 "dc" :null)))
 ("INSERT INTO t VALUES (3, 4, 'x', 5);" :ok)
 ("SELECT * FROM t ORDER BY a;" :rows ("a" "b" "c" "d")
  ((1 2 "dc" :null)
   (3 4 "x" 5)))
 ("SELECT sql FROM sqlite_schema WHERE name = 't';" :rows ("sql")
  (("CREATE TABLE t(a, b, c TEXT DEFAULT 'dc', d INTEGER)")))
 ("ALTER TABLE t RENAME TO t2;" :ok)
 ("SELECT a FROM t2 ORDER BY a;" :rows ("a")
  ((1)
   (3)))
 ("SELECT name, sql FROM sqlite_schema;" :rows ("name" "sql")
  (("t2" "CREATE TABLE \"t2\"(a, b, c TEXT DEFAULT 'dc', d INTEGER)")))
 ("ALTER TABLE t2 RENAME COLUMN b TO bb;" :ok)
 ("SELECT bb FROM t2 ORDER BY bb;" :rows ("bb")
  ((2)
   (4)))
 ("ALTER TABLE t2 DROP COLUMN c;" :ok)
 ("SELECT * FROM t2 ORDER BY a;" :rows ("a" "bb" "d")
  ((1 2 :null)
   (3 4 5)))
 ("SELECT sql FROM sqlite_schema WHERE name = 't2';" :rows ("sql")
  (("CREATE TABLE \"t2\"(a, bb, d INTEGER)")))
 ("ALTER TABLE t2 ADD COLUMN e NOT NULL;" :error "Cannot add a NOT NULL column with default value NULL")
 ("ALTER TABLE t2 ADD COLUMN a;" :error "duplicate column name: a")
)
("ddl.test:pragmas"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT 'x', score REAL, u UNIQUE);" :ok)
 ("CREATE INDEX ts ON t(score DESC, name);" :ok)
