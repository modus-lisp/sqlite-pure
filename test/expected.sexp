 ("CREATE TABLE t(id INTEGER PRIMARY KEY, s TEXT, b BLOB);" :ok)
 ("INSERT INTO t VALUES (1, 'x', NULL);" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM c WHERE i < 200)
INSERT INTO t(s, b) SELECT printf('%.*c', i * 50, 'a'), zeroblob(i * 97) FROM c;" :ok)
 ("SELECT count(*), sum(length(s)), sum(length(b)) FROM t;" :rows ("count(*)" "sum(length(s))" "sum(length(b))")
  ((201 1005001 1949700)))
 ("UPDATE t SET s = s || s WHERE id % 7 = 0;" :ok)
