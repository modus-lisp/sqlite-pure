("dml.test:check-constraint"
 ("CREATE TABLE t(a CHECK (a > 0), b, CONSTRAINT bpos CHECK (b IS NULL OR b < 10));" :ok)
 ("INSERT INTO t VALUES (1, 1);" :ok)
 ("INSERT INTO t VALUES (0, 1);" :error "CHECK constraint failed: a > 0")
 ("INSERT INTO t VALUES (1, 11);" :error "CHECK constraint failed: bpos")
 ("INSERT INTO t VALUES (NULL, NULL);" :ok)
