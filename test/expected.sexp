 ("CREATE TABLE pts(pid INTEGER PRIMARY KEY, x, y);" :ok)
 ("INSERT INTO pts VALUES (1, 10.5, 20.5), (2, 500, 500), (3, -5, -5);" :ok)
 ("SELECT pid, count(box.id) FROM pts LEFT JOIN box ON box.minx <= pts.x AND box.maxx >= pts.x AND box.miny <= pts.y AND box.maxy >= pts.y GROUP BY pid ORDER BY pid;" :rows ("pid" "count(box.id)")
