 ("INSERT INTO t VALUES (1);" :ok)
 ("INSERT INTO t VALUES (2), (3), (1), (4);" :error "UNIQUE constraint failed: t.a")
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)))
 ("INSERT OR FAIL INTO t VALUES (5), (1), (6);" :error "UNIQUE constraint failed: t.a")
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (5)))
