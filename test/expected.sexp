("select.test:bare-columns-in-groups"
 ("CREATE TABLE t(a, b);" :ok)
 ("INSERT INTO t VALUES (1, 'x'), (2, 'y'), (1, 'z'), (2, 'w'), (3, 'v'), (1, 'u');" :ok)
 ("SELECT a, b FROM t GROUP BY a;" :rows ("a" "b")
  ((1 "x")
   (2 "y")
   (3 "v")))
 ("SELECT a, b, count(*) FROM t GROUP BY a;" :rows ("a" "b" "count(*)")
  ((1 "x" 3)
   (2 "y" 2)
   (3 "v" 1)))
 ("SELECT a, b, max(b) FROM t GROUP BY a;" :rows ("a" "b" "max(b)")
  ((1 "z" "z")
   (2 "y" "y")
   (3 "v" "v")))
 ("SELECT a, b, min(b) FROM t GROUP BY a;" :rows ("a" "b" "min(b)")
  ((1 "u" "u")
   (2 "w" "w")
   (3 "v" "v")))
 ("SELECT b, count(*) FROM t;" :rows ("b" "count(*)")
  (("x" 6)))
 ("SELECT b, max(b) FROM t;" :rows ("b" "max(b)")
  (("z" "z")))
)
("select.test:ordered-scans"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, a, b TEXT COLLATE NOCASE, c);" :ok)
 ("CREATE INDEX ta ON t(a);" :ok)
 ("CREATE INDEX tbc ON t(b, c DESC);" :ok)
 ("INSERT INTO t(a, b, c) VALUES (3, 'x', 1), (1, 'Y', 2), (2, 'x', 3), (NULL, 'z', 4), (1, 'a', 5), (5, NULL, 6);" :ok)
 ("SELECT id FROM t ORDER BY id DESC;" :rows ("id")
  ((6)
   (5)
   (4)
   (3)
   (2)
   (1)))
 ("SELECT id FROM t ORDER BY id DESC LIMIT 2;" :rows ("id")
  ((6)
   (5)))
 ("SELECT id, a FROM t ORDER BY a, id;" :rows ("id" "a")
  ((4 :null)
   (2 1)
   (5 1)
   (3 2)
   (1 3)
   (6 5)))
 ("SELECT id, a FROM t ORDER BY a DESC LIMIT 3;" :rows ("id" "a")
  ((6 5)
   (1 3)
   (3 2)))
 ("SELECT id FROM t ORDER BY b, c DESC;" :rows ("id")
  ((6)
   (5)
   (3)
   (1)
   (2)
   (4)))
 ("SELECT id FROM t ORDER BY b DESC, c;" :rows ("id")
  ((4)
   (2)
   (1)
   (3)
   (5)
   (6)))
 ("SELECT id FROM t ORDER BY b COLLATE BINARY, c DESC;" :rows ("id")
  ((6)
   (2)
   (5)
   (3)
   (1)
   (4)))
 ("SELECT id FROM t WHERE a > 1 ORDER BY id DESC;" :rows ("id")
  ((6)
   (3)
   (1)))
 ("SELECT id FROM t WHERE id > 2 ORDER BY id;" :rows ("id")
  ((3)
   (4)
   (5)
   (6)))
 ("SELECT id FROM t ORDER BY a NULLS LAST, id;" :rows ("id")
  ((2)
   (5)
   (3)
   (1)
   (6)
   (4)))
 ("SELECT id, a FROM t ORDER BY 2 DESC, 1;" :rows ("id" "a")
  ((6 5)
   (1 3)
   (3 2)
   (2 1)
   (5 1)
   (4 :null)))
 ("SELECT id FROM t WHERE a = 1 ORDER BY id DESC;" :rows ("id")
  ((5)
   (2)))
 ("SELECT a AS x FROM t ORDER BY x LIMIT 3 OFFSET 1;" :rows ("x")
  ((1)
   (1)
   (2)))
)
("select.test:right-full-joins"
 ("CREATE TABLE a(k, x);" :ok)
 ("CREATE TABLE b(k, y);" :ok)
 ("CREATE TABLE c(k, z);" :ok)
 ("INSERT INTO a VALUES (1, 'a1'), (2, 'a2'), (3, 'a3');" :ok)
 ("INSERT INTO b VALUES (2, 'b2'), (3, 'b3'), (4, 'b4');" :ok)
 ("INSERT INTO c VALUES (3, 'c3'), (4, 'c4'), (5, 'c5');" :ok)
 ("SELECT * FROM a RIGHT JOIN b ON a.k = b.k ORDER BY b.k;" :rows ("k" "x" "k" "y")
  ((2 "a2" 2 "b2")
   (3 "a3" 3 "b3")
   (:null :null 4 "b4")))
 ("SELECT * FROM a FULL JOIN b ON a.k = b.k ORDER BY coalesce(a.k, b.k);" :rows ("k" "x" "k" "y")
  ((1 "a1" :null :null)
   (2 "a2" 2 "b2")
   (3 "a3" 3 "b3")
   (:null :null 4 "b4")))
 ("SELECT * FROM a RIGHT JOIN b USING (k) ORDER BY k;" :rows ("k" "x" "y")
  ((2 "a2" "b2")
   (3 "a3" "b3")
   (4 :null "b4")))
 ("SELECT * FROM a FULL OUTER JOIN b USING (k) ORDER BY k;" :rows ("k" "x" "y")
  ((1 "a1" :null)
   (2 "a2" "b2")
   (3 "a3" "b3")
   (4 :null "b4")))
 ("SELECT a.k, b.k, c.k FROM a LEFT JOIN b ON a.k = b.k RIGHT JOIN c ON c.k = b.k ORDER BY c.k;" :rows ("k" "k" "k")
  ((3 3 3)
   (:null :null 4)
   (:null :null 5)))
 ("SELECT * FROM a RIGHT JOIN b ON a.k = b.k WHERE a.k IS NULL;" :rows ("k" "x" "k" "y")
  ((:null :null 4 "b4")))
 ("SELECT * FROM a FULL OUTER JOIN b ON a.k = b.k AND b.y = 'b3' ORDER BY a.k, b.k;" :rows ("k" "x" "k" "y")
  ((:null :null 2 "b2")
   (:null :null 4 "b4")
   (1 "a1" :null :null)
   (2 "a2" :null :null)
   (3 "a3" 3 "b3")))
 ("SELECT k FROM a FULL JOIN b USING (k) ORDER BY 1;" :rows ("k")
  ((1)
   (2)
   (3)
   (4)))
 ("SELECT * FROM a RIGHT JOIN b ON 1 = 0 ORDER BY b.k;" :rows ("k" "x" "k" "y")
  ((:null :null 2 "b2")
   (:null :null 3 "b3")
   (:null :null 4 "b4")))
 ("SELECT count(*), count(a.k), count(b.k) FROM a FULL JOIN b ON a.k = b.k;" :rows ("count(*)" "count(a.k)" "count(b.k)")
  ((4 3 3)))
)
("select.test:update-from"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, v);" :ok)
 ("INSERT INTO t VALUES (1, 'x'), (2, 'y'), (3, 'z');" :ok)
 ("CREATE TABLE s(id, nv);" :ok)
 ("INSERT INTO s VALUES (1, 'X'), (3, 'Z'), (3, 'ZZ');" :ok)
 ("UPDATE t SET v = s.nv FROM s WHERE t.id = s.id;" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v")
  ((1 "X")
   (2 "y")
   (3 "ZZ")))
 ("SELECT changes();" :rows ("changes()")
  ((2)))
 ("UPDATE t AS tt SET v = v || s.nv FROM (SELECT id, count(*) AS nv FROM s GROUP BY id) AS s WHERE tt.id = s.id;" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v")
  ((1 "X1")
   (2 "y")
   (3 "ZZ2")))
 ("SELECT a.k, b.k, c.k FROM a JOIN b ON a.k = b.k AND b.k > 2 RIGHT JOIN c ON c.k = a.k ORDER BY c.k;" :error "no such table: a")
)
("select.test:pragma-table-functions"
 ("CREATE TABLE p(id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT 'x', ref INT REFERENCES q(k) ON DELETE CASCADE);" :ok)
 ("CREATE TABLE q(k UNIQUE, v);" :ok)
 ("CREATE INDEX pn ON p(name, ref DESC);" :ok)
 ("CREATE VIEW pv AS SELECT name, ref FROM p;" :ok)
 ("SELECT * FROM pragma_table_info('p');" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk")
  ((0 "id" "INTEGER" 0 :null 1)
   (1 "name" "TEXT" 1 "'x'" 0)
   (2 "ref" "INT" 0 :null 0)))
 ("SELECT name, type, pk FROM pragma_table_info('p') WHERE notnull ORDER BY cid;" :error "near \"notnull\": syntax error")
 ("SELECT cid, name, hidden FROM pragma_table_xinfo('pv');" :rows ("cid" "name" "hidden")
  ((0 "name" 0)
   (1 "ref" 0)))
 ("SELECT m.name, c.name FROM sqlite_schema AS m JOIN pragma_table_info(m.name) AS c WHERE m.type = 'table' ORDER BY m.name, c.cid;" :rows ("name" "name")
  (("p" "id")
   ("p" "name")
   ("p" "ref")
   ("q" "k")
   ("q" "v")))
 ("SELECT m.name, count(*) FROM sqlite_schema m, pragma_table_info(m.name) GROUP BY m.name ORDER BY 1;" :rows ("name" "count(*)")
  (("p" 3)
   ("pv" 2)
   ("q" 2)))
 ("SELECT * FROM pragma_index_list('p');" :rows ("seq" "name" "unique" "origin" "partial")
  ((0 "pn" 0 "c" 0)))
 ("SELECT * FROM pragma_index_list('q');" :rows ("seq" "name" "unique" "origin" "partial")
  ((0 "sqlite_autoindex_q_1" 1 "u" 0)))
 ("SELECT * FROM pragma_index_info('pn');" :rows ("seqno" "cid" "name")
  ((0 1 "name")
   (1 2 "ref")))
 ("SELECT * FROM pragma_index_xinfo('pn');" :rows ("seqno" "cid" "name" "desc" "coll" "key")
  ((0 1 "name" 0 "BINARY" 1)
   (1 2 "ref" 1 "BINARY" 1)
   (2 -1 :null 0 "BINARY" 0)))
 ("SELECT * FROM pragma_foreign_key_list('p');" :rows ("id" "seq" "table" "from" "to" "on_update" "on_delete" "match")
  ((0 0 "q" "ref" "k" "NO ACTION" "CASCADE" "NONE")))
 ("SELECT \"table\", \"from\", \"to\", on_delete FROM pragma_foreign_key_list('p');" :rows ("table" "from" "to" "on_delete")
  (("q" "ref" "k" "CASCADE")))
 ("SELECT * FROM pragma_table_info('nonesuch');" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk")
  ())
 ("SELECT * FROM pragma_table_info;" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk")
  ())
 ("SELECT * FROM pragma_table_info(NULL);" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk")
  ())
 ("SELECT name, arg, schema FROM pragma_table_info('q');" :rows ("name" "arg" "schema")
  (("k" "q" :null)
   ("v" "q" :null)))
 ("SELECT * FROM pragma_table_info('q', 'main');" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk")
  ((0 "k" "" 0 :null 0)
   (1 "v" "" 0 :null 0)))
 ("SELECT name FROM pragma_database_list;" :rows ("name")
  (("main")))
 ("SELECT * FROM pragma_integrity_check;" :rows ("integrity_check")
  (("ok")))
 ("SELECT * FROM pragma_quick_check();" :rows ("quick_check")
  (("ok")))
 ("SELECT * FROM pragma_collation_list ORDER BY seq;" :rows ("seq" "name")
  ((0 "RTRIM")
   (1 "NOCASE")
   (2 "BINARY")))
 ("SELECT user_version FROM pragma_user_version;" :rows ("user_version")
  ((0)))
 ("SELECT * FROM pragma_encoding, pragma_foreign_keys, pragma_schema_version;" :rows ("encoding" "foreign_keys" "schema_version")
  (("UTF-8" 0 4)))
 ("SELECT * FROM pragma_page_size;" :rows ("page_size")
  ((4096)))
 ("SELECT count(*) FROM pragma_table_list WHERE name IN ('p', 'q', 'pv');" :rows ("count(*)")
  ((3)))
 ("SELECT name, type, ncol FROM pragma_table_list('p');" :rows ("name" "type" "ncol")
  (("p" "table" 3)))
 ("SELECT * FROM pragma_table_info('p', 'q', 'r');" :error "too many arguments on pragma_table_info() - max 2")
 ("SELECT * FROM pragma_nosuch('p');" :error "no such table: pragma_nosuch")
 ("SELECT * FROM pragma_nosuch;" :error "no such table: pragma_nosuch")
 ("SELECT p.name FROM pragma_table_info('p') AS p WHERE p.name LIKE 'n%';" :rows ("name")
  (("name")))
)
