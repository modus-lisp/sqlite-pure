("ddl.test:alter-table"
 ("CREATE TABLE t(a, b);" :ok)
 ("INSERT INTO t VALUES (1, 2);" :ok)
 ("ALTER TABLE t ADD COLUMN c TEXT DEFAULT 'dc';" :ok)
 ("ALTER TABLE t ADD d INTEGER;" :ok)
 ("SELECT * FROM t;" :rows ("a" "b" "c" "d")
  ((1 2 "dc" :null)))
 ("INSERT INTO t VALUES (3, 4, 'x', 5);" :ok)
 ("SELECT * FROM t ORDER BY a;" :rows ("a" "b" "c" "d")
  ((1 2 "dc" :null)
   (3 4 "x" 5)))
 ("SELECT sql FROM sqlite_schema WHERE name = 't';" :rows ("sql")
  (("CREATE TABLE t(a, b, c TEXT DEFAULT 'dc', d INTEGER)")))
 ("ALTER TABLE t RENAME TO t2;" :ok)
 ("SELECT a FROM t2 ORDER BY a;" :rows ("a")
  ((1)
   (3)))
 ("SELECT name, sql FROM sqlite_schema;" :rows ("name" "sql")
  (("t2" "CREATE TABLE \"t2\"(a, b, c TEXT DEFAULT 'dc', d INTEGER)")))
 ("ALTER TABLE t2 RENAME COLUMN b TO bb;" :ok)
 ("SELECT bb FROM t2 ORDER BY bb;" :rows ("bb")
  ((2)
   (4)))
 ("ALTER TABLE t2 DROP COLUMN c;" :ok)
 ("SELECT * FROM t2 ORDER BY a;" :rows ("a" "bb" "d")
  ((1 2 :null)
   (3 4 5)))
 ("SELECT sql FROM sqlite_schema WHERE name = 't2';" :rows ("sql")
  (("CREATE TABLE \"t2\"(a, bb, d INTEGER)")))
 ("ALTER TABLE t2 ADD COLUMN e NOT NULL;" :error "Cannot add a NOT NULL column with default value NULL")
 ("ALTER TABLE t2 ADD COLUMN a;" :error "duplicate column name: a")
)
("ddl.test:pragmas"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT 'x', score REAL, u UNIQUE);" :ok)
 ("CREATE INDEX ts ON t(score DESC, name);" :ok)
 ("PRAGMA table_info(t);" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk")
  ((0 "id" "INTEGER" 0 :null 1)
   (1 "name" "TEXT" 1 "'x'" 0)
   (2 "score" "REAL" 0 :null 0)
   (3 "u" "" 0 :null 0)))
 ("PRAGMA index_list(t);" :rows ("seq" "name" "unique" "origin" "partial")
  ((0 "ts" 0 "c" 0)
   (1 "sqlite_autoindex_t_1" 1 "u" 0)))
 ("PRAGMA index_info(ts);" :rows ("seqno" "cid" "name")
  ((0 2 "score")
   (1 1 "name")))
 ("PRAGMA user_version;" :rows ("user_version")
  ((0)))
 ("PRAGMA user_version = 42;" :ok)
 ("PRAGMA user_version;" :rows ("user_version")
  ((42)))
 ("PRAGMA integrity_check;" :rows ("integrity_check")
  (("ok")))
)
("ddl.test:without-rowid"
 ("CREATE TABLE w(k TEXT, n INTEGER, v, PRIMARY KEY (k, n)) WITHOUT ROWID;" :ok)
 ("INSERT INTO w VALUES ('b', 2, 'b2'), ('a', 1, 'a1'), ('a', 2, 'a2');" :ok)
 ("SELECT * FROM w;" :rows ("k" "n" "v")
  (("a" 1 "a1")
   ("a" 2 "a2")
   ("b" 2 "b2")))
 ("SELECT v FROM w WHERE k = 'a' AND n = 2;" :rows ("v")
  (("a2")))
 ("INSERT INTO w VALUES ('a', 1, 'dup');" :error "UNIQUE constraint failed: w.k, w.n")
 ("INSERT OR REPLACE INTO w VALUES ('a', 1, 'new');" :ok)
 ("UPDATE w SET v = v || '!' WHERE k = 'b';" :ok)
 ("DELETE FROM w WHERE k = 'a' AND n = 2;" :ok)
 ("SELECT * FROM w;" :rows ("k" "n" "v")
  (("a" 1 "new")
   ("b" 2 "b2!")))
 ("SELECT rowid FROM w;" :error "no such column: rowid")
)
("dml.test:update-basic"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, v, w);" :ok)
 ("INSERT INTO t VALUES (1, 'a', 10), (2, 'b', 20), (3, 'c', 30);" :ok)
 ("UPDATE t SET w = w + 1 WHERE id >= 2;" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v" "w")
  ((1 "a" 10)
   (2 "b" 21)
   (3 "c" 31)))
 ("UPDATE t SET v = upper(v), w = w * 2;" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v" "w")
  ((1 "A" 20)
   (2 "B" 42)
   (3 "C" 62)))
 ("UPDATE t SET id = id + 10 WHERE id = 1;" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v" "w")
  ((2 "B" 42)
   (3 "C" 62)
   (11 "A" 20)))
 ("UPDATE t SET v = 'z' WHERE 0;" :ok)
 ("SELECT changes();" :rows ("changes()")
  ((0)))
 ("UPDATE t SET w = NULL WHERE v = 'B';" :ok)
 ("SELECT changes(), total_changes();" :rows ("changes()" "total_changes()")
  ((1 10)))
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v" "w")
  ((2 "B" :null)
   (3 "C" 62)
   (11 "A" 20)))
)
("dml.test:delete-basic"
 ("CREATE TABLE t(a);" :ok)
 ("INSERT INTO t VALUES (1), (2), (3), (4), (5);" :ok)
 ("DELETE FROM t WHERE a % 2 = 0;" :ok)
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (3)
   (5)))
 ("SELECT changes();" :rows ("changes()")
  ((2)))
 ("DELETE FROM t;" :ok)
 ("SELECT count(*) FROM t;" :rows ("count(*)")
  ((0)))
 ("INSERT INTO t VALUES (9);" :ok)
 ("SELECT rowid, a FROM t;" :rows ("rowid" "a")
  ((1 9)))
)
("dml.test:not-null"
 ("CREATE TABLE t(a NOT NULL, b);" :ok)
 ("INSERT INTO t VALUES (1, 2);" :ok)
 ("INSERT INTO t VALUES (NULL, 2);" :error "NOT NULL constraint failed: t.a")
 ("INSERT OR IGNORE INTO t VALUES (NULL, 3);" :ok)
 ("SELECT * FROM t;" :rows ("a" "b")
  ((1 2)))
 ("UPDATE t SET a = NULL;" :error "NOT NULL constraint failed: t.a")
 ("SELECT * FROM t;" :rows ("a" "b")
  ((1 2)))
)
("dml.test:not-null-replace-default"
 ("CREATE TABLE t(a NOT NULL DEFAULT 'dflt', b);" :ok)
 ("INSERT OR REPLACE INTO t VALUES (NULL, 1);" :ok)
 ("SELECT * FROM t;" :rows ("a" "b")
  (("dflt" 1)))
)
("dml.test:unique"
 ("CREATE TABLE t(a UNIQUE, b);" :ok)
 ("INSERT INTO t VALUES (1, 'x'), (2, 'y');" :ok)
 ("INSERT INTO t VALUES (1, 'z');" :error "UNIQUE constraint failed: t.a")
 ("INSERT INTO t VALUES (NULL, 'n1'), (NULL, 'n2');" :ok)
 ("SELECT * FROM t ORDER BY rowid;" :rows ("a" "b")
  ((1 "x")
   (2 "y")
   (:null "n1")
   (:null "n2")))
 ("INSERT OR IGNORE INTO t VALUES (2, 'ignored'), (3, 'kept');" :ok)
 ("SELECT * FROM t ORDER BY rowid;" :rows ("a" "b")
  ((1 "x")
   (2 "y")
   (:null "n1")
   (:null "n2")
   (3 "kept")))
 ("INSERT OR REPLACE INTO t VALUES (1, 'replaced');" :ok)
 ("SELECT a, b FROM t ORDER BY a;" :rows ("a" "b")
  ((:null "n1")
   (:null "n2")
   (1 "replaced")
   (2 "y")
   (3 "kept")))
 ("UPDATE t SET a = 2 WHERE a = 3;" :error "UNIQUE constraint failed: t.a")
 ("UPDATE OR REPLACE t SET a = 2 WHERE a = 3;" :ok)
 ("SELECT a, b FROM t ORDER BY a;" :rows ("a" "b")
  ((:null "n1")
   (:null "n2")
   (1 "replaced")
   (2 "kept")))
)
("dml.test:multi-column-unique"
 ("CREATE TABLE t(a, b, c, UNIQUE(a, b));" :ok)
 ("INSERT INTO t VALUES (1, 1, 'x'), (1, 2, 'y');" :ok)
 ("INSERT INTO t VALUES (1, 1, 'dup');" :error "UNIQUE constraint failed: t.a, t.b")
 ("INSERT INTO t VALUES (1, NULL, 'n'), (1, NULL, 'n2');" :ok)
 ("SELECT * FROM t ORDER BY rowid;" :rows ("a" "b" "c")
  ((1 1 "x")
   (1 2 "y")
   (1 :null "n")
   (1 :null "n2")))
)
("dml.test:primary-key-text"
 ("CREATE TABLE t(k TEXT PRIMARY KEY, v);" :ok)
 ("INSERT INTO t VALUES ('a', 1), ('b', 2);" :ok)
 ("INSERT INTO t VALUES ('a', 3);" :error "UNIQUE constraint failed: t.k")
 ("REPLACE INTO t VALUES ('a', 4);" :ok)
 ("SELECT * FROM t ORDER BY k;" :rows ("k" "v")
  (("a" 4)
   ("b" 2)))
 ("SELECT * FROM t WHERE k = 'b';" :rows ("k" "v")
  (("b" 2)))
)
("dml.test:conflict-abort-atomic"
 ("CREATE TABLE t(a UNIQUE);" :ok)
 ("INSERT INTO t VALUES (1);" :ok)
 ("INSERT INTO t VALUES (2), (3), (1), (4);" :error "UNIQUE constraint failed: t.a")
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)))
 ("INSERT OR FAIL INTO t VALUES (5), (1), (6);" :error "UNIQUE constraint failed: t.a")
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (5)))
)
("dml.test:check-constraint"
 ("CREATE TABLE t(a CHECK (a > 0), b, CONSTRAINT bpos CHECK (b IS NULL OR b < 10));" :ok)
 ("INSERT INTO t VALUES (1, 1);" :ok)
 ("INSERT INTO t VALUES (0, 1);" :error "CHECK constraint failed: a > 0")
 ("INSERT INTO t VALUES (1, 11);" :error "CHECK constraint failed: bpos")
 ("INSERT INTO t VALUES (NULL, NULL);" :ok)
 ("SELECT * FROM t ORDER BY rowid;" :rows ("a" "b")
  ((1 1)
   (:null :null)))
)
("dml.test:autoincrement"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY AUTOINCREMENT, v);" :ok)
 ("INSERT INTO t(v) VALUES ('a'), ('b'), ('c');" :ok)
 ("DELETE FROM t WHERE id = 3;" :ok)
 ("INSERT INTO t(v) VALUES ('d');" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v")
  ((1 "a")
   (2 "b")
   (4 "d")))
 ("SELECT name, seq FROM sqlite_sequence;" :rows ("name" "seq")
  (("t" 4)))
 ("INSERT INTO t VALUES (100, 'e');" :ok)
 ("INSERT INTO t(v) VALUES ('f');" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v")
  ((1 "a")
   (2 "b")
   (4 "d")
   (100 "e")
   (101 "f")))
 ("SELECT seq FROM sqlite_sequence WHERE name = 't';" :rows ("seq")
  ((101)))
)
("dml.test:rowid-reuse-without-autoincrement"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, v);" :ok)
 ("INSERT INTO t(v) VALUES ('a'), ('b'), ('c');" :ok)
 ("DELETE FROM t WHERE id = 3;" :ok)
 ("INSERT INTO t(v) VALUES ('d');" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v")
  ((1 "a")
   (2 "b")
   (3 "d")))
)
("dml.test:upsert"
 ("CREATE TABLE kv(k TEXT PRIMARY KEY, v INTEGER, n INTEGER DEFAULT 0);" :ok)
 ("INSERT INTO kv(k, v) VALUES ('a', 1);" :ok)
 ("INSERT INTO kv(k, v) VALUES ('a', 5) ON CONFLICT(k) DO UPDATE SET v = excluded.v, n = n + 1;" :ok)
 ("INSERT INTO kv(k, v) VALUES ('b', 2) ON CONFLICT(k) DO UPDATE SET v = excluded.v;" :ok)
 ("INSERT INTO kv(k, v) VALUES ('b', 9) ON CONFLICT DO NOTHING;" :ok)
 ("SELECT * FROM kv ORDER BY k;" :rows ("k" "v" "n")
  (("a" 5 1)
   ("b" 2 0)))
 ("INSERT INTO kv(k, v) VALUES ('a', 0) ON CONFLICT(k) DO UPDATE SET v = v + 100 WHERE excluded.v > 0;" :ok)
 ("SELECT * FROM kv ORDER BY k;" :rows ("k" "v" "n")
  (("a" 5 1)
   ("b" 2 0)))
)
("dml.test:returning"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, v);" :ok)
 ("INSERT INTO t(v) VALUES ('a'), ('b') RETURNING id, v;" :rows ("id" "v")
  ((1 "a")
   (2 "b")))
 ("UPDATE t SET v = v || '!' WHERE id = 2 RETURNING *;" :rows ("id" "v")
  ((2 "b!")))
 ("DELETE FROM t WHERE id = 1 RETURNING v, id * 10 AS ten;" :rows ("v" "ten")
  (("a" 10)))
 ("SELECT * FROM t;" :rows ("id" "v")
  ((2 "b!")))
)
("dml.test:insert-column-mismatch"
 ("CREATE TABLE t(a, b);" :ok)
 ("INSERT INTO t VALUES (1);" :error "table t has 2 columns but 1 values were supplied")
 ("INSERT INTO t(a) VALUES (1, 2);" :error "2 values for 1 columns")
 ("INSERT INTO t(nosuch) VALUES (1);" :error "table t has no column named nosuch")
 ("SELECT count(*) FROM t;" :rows ("count(*)")
  ((0)))
)
("dml.test:transactions"
 ("CREATE TABLE t(a);" :ok)
 ("BEGIN;" :ok)
 ("INSERT INTO t VALUES (1);" :ok)
 ("INSERT INTO t VALUES (2);" :ok)
 ("ROLLBACK;" :ok)
 ("SELECT count(*) FROM t;" :rows ("count(*)")
  ((0)))
 ("BEGIN;" :ok)
 ("INSERT INTO t VALUES (3);" :ok)
 ("COMMIT;" :ok)
 ("SELECT a FROM t;" :rows ("a")
  ((3)))
 ("COMMIT;" :error "cannot commit - no transaction is active")
 ("BEGIN;" :ok)
 ("BEGIN;" :error "cannot start a transaction within a transaction")
 ("ROLLBACK;" :ok)
)
("dml.test:statement-atomicity-in-transaction"
 ("CREATE TABLE t(a UNIQUE);" :ok)
 ("BEGIN;" :ok)
 ("INSERT INTO t VALUES (1);" :ok)
 ("INSERT INTO t VALUES (2), (1);" :error "UNIQUE constraint failed: t.a")
 ("INSERT INTO t VALUES (3);" :ok)
 ("COMMIT;" :ok)
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (3)))
)
("dml.test:update-with-index"
 ("CREATE TABLE t(a, b);" :ok)
 ("CREATE INDEX tb ON t(b);" :ok)
 ("INSERT INTO t VALUES (1, 'x'), (2, 'y'), (3, 'x');" :ok)
 ("UPDATE t SET b = 'z' WHERE b = 'x';" :ok)
 ("SELECT a FROM t WHERE b = 'z' ORDER BY a;" :rows ("a")
  ((1)
   (3)))
 ("SELECT a FROM t WHERE b = 'x';" :rows ("a")
  ())
 ("DELETE FROM t WHERE b = 'z';" :ok)
 ("SELECT a, b FROM t;" :rows ("a" "b")
  ((2 "y")))
)
("dml.test:large-values"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, s TEXT, b BLOB);" :ok)
 ("INSERT INTO t VALUES (1, 'x', NULL);" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM c WHERE i < 200)
INSERT INTO t(s, b) SELECT printf('%.*c', i * 50, 'a'), zeroblob(i * 97) FROM c;" :ok)
 ("SELECT count(*), sum(length(s)), sum(length(b)) FROM t;" :rows ("count(*)" "sum(length(s))" "sum(length(b))")
  ((201 1005001 1949700)))
 ("UPDATE t SET s = s || s WHERE id % 7 = 0;" :ok)
 ("DELETE FROM t WHERE id % 3 = 0;" :ok)
 ("SELECT count(*), sum(length(s)), sum(length(b)) FROM t;" :rows ("count(*)" "sum(length(s))" "sum(length(b))")
  ((134 760551 1293301)))
)
("expr.test:arithmetic"
 ("SELECT 1 + 2, 7 - 10, 6 * 7, 7 / 2, -7 / 2, 7 % 3, -7 % 3, 7 % -3;" :rows ("1 + 2" "7 - 10" "6 * 7" "7 / 2" "-7 / 2" "7 % 3" "-7 % 3" "7 % -3")
  ((3 -3 42 3 -3 1 -1 1)))
 ("SELECT 7.0 / 2, 1 / 0, 1 % 0, 1.0 / 0, 5.5 % 2, 10 % 3.5;" :rows ("7.0 / 2" "1 / 0" "1 % 0" "1.0 / 0" "5.5 % 2" "10 % 3.5")
  (((:f "3.5") :null :null :null (:f "1.0") (:f "1.0"))))
 ("SELECT 9223372036854775807 + 1, -9223372036854775808 - 1, 9223372036854775807 * 2;" :rows ("9223372036854775807 + 1" "-9223372036854775808 - 1" "9223372036854775807 * 2")
  (((:f "9.223372036854776e+18") (:f "-9.223372036854776e+18") (:f "1.8446744073709552e+19"))))
 ("SELECT -9223372036854775808 / -1, -9223372036854775808 % -1;" :rows ("-9223372036854775808 / -1" "-9223372036854775808 % -1")
  (((:f "9.223372036854776e+18") 0)))
 ("SELECT '3abc' + 1, 'abc' * 2, ' 1.5e2x' + 0, '0x10' + 0, x'3132' + 1;" :rows ("'3abc' + 1" "'abc' * 2" "' 1.5e2x' + 0" "'0x10' + 0" "x'3132' + 1")
  ((4 0 (:f "150.0") 0 13)))
 ("SELECT 0.1 + 0.2, 1e308 * 10, -(-9223372036854775808);" :rows ("0.1 + 0.2" "1e308 * 10" "-(-9223372036854775808)")
  (((:f "0.30000000000000004") :inf (:f "9.223372036854776e+18"))))
 ("SELECT 2 + 3 * 4, (2 + 3) * 4, 10 - 2 - 3, 100 / 10 / 5, 2 || 3 + 1;" :rows ("2 + 3 * 4" "(2 + 3) * 4" "10 - 2 - 3" "100 / 10 / 5" "2 || 3 + 1")
  ((14 20 5 2 24)))
)
("expr.test:bitwise"
 ("SELECT 5 & 3, 5 | 3, ~5, 1 << 4, 256 >> 4, -1 >> 1, 1 << 63, 1 << 64, -8 >> 100, 3 << -1;" :rows ("5 & 3" "5 | 3" "~5" "1 << 4" "256 >> 4" "-1 >> 1" "1 << 63" "1 << 64" "-8 >> 100" "3 << -1")
  ((1 7 -6 16 16 -1 -9223372036854775808 0 -1 1)))
)
("expr.test:comparisons"
 ("SELECT 1 < 2, 2 <= 2, 3 > 4, 'a' < 'b', 'B' < 'a', 1 < 'a', x'00' > 'z', 1 = 1.0;" :rows ("1 < 2" "2 <= 2" "3 > 4" "'a' < 'b'" "'B' < 'a'" "1 < 'a'" "x'00' > 'z'" "1 = 1.0")
  ((1 1 0 1 1 1 1 1)))
 ("SELECT 1 == 1, 1 != 2, 1 <> 1, NULL < 1, 'abc' = 'ABC';" :rows ("1 == 1" "1 != 2" "1 <> 1" "NULL < 1" "'abc' = 'ABC'")
  ((1 1 0 :null 0)))
 ("SELECT 'abc' = 'ABC' COLLATE NOCASE, 'abc ' = 'abc' COLLATE RTRIM, 'a' < 'B' COLLATE NOCASE;" :rows ("'abc' = 'ABC' COLLATE NOCASE" "'abc ' = 'abc' COLLATE RTRIM" "'a' < 'B' COLLATE NOCASE")
  ((1 1 1)))
)
("expr.test:comparison-affinity"
 ("CREATE TABLE t(i INTEGER, x TEXT, b BLOB, n);" :ok)
 ("INSERT INTO t VALUES (5, '5', '5', '5');" :ok)
 ("SELECT i = '5', x = 5, b = 5, n = 5, i = x, x = i, i < '10', x < 10, b < 10;" :error "no such column: i")
 ("SELECT i IN ('5', 6), x IN (5), b IN (5), n IN ('5');" :error "no such column: i")
 ("SELECT CAST(i AS TEXT) = x, i = CAST(x AS INTEGER);" :error "no such column: i")
)
("expr.test:cast"
 ("SELECT CAST('123' AS INTEGER), CAST('12.9' AS INTEGER), CAST('1e3' AS INTEGER), CAST('  -42xyz' AS INTEGER), CAST('abc' AS INTEGER);" :rows ("CAST('123' AS INTEGER)" "CAST('12.9' AS INTEGER)" "CAST('1e3' AS INTEGER)" "CAST('  -42xyz' AS INTEGER)" "CAST('abc' AS INTEGER)")
  ((123 12 1 -42 0)))
 ("SELECT CAST(12.9 AS INTEGER), CAST(-12.9 AS INTEGER), CAST(1e30 AS INTEGER), CAST(-1e30 AS INTEGER);" :rows ("CAST(12.9 AS INTEGER)" "CAST(-12.9 AS INTEGER)" "CAST(1e30 AS INTEGER)" "CAST(-1e30 AS INTEGER)")
  ((12 -12 9223372036854775807 -9223372036854775808)))
 ("SELECT CAST('1.5' AS REAL), CAST(3 AS REAL), CAST('x' AS REAL), CAST('1e400' AS REAL);" :rows ("CAST('1.5' AS REAL)" "CAST(3 AS REAL)" "CAST('x' AS REAL)" "CAST('1e400' AS REAL)")
  (((:f "1.5") (:f "3.0") (:f "0.0") :inf)))
 ("SELECT CAST(12 AS TEXT), CAST(1.5 AS TEXT), CAST(1e20 AS TEXT), CAST(0.1 AS TEXT), CAST(100.0 AS TEXT), CAST(1e-5 AS TEXT);" :rows ("CAST(12 AS TEXT)" "CAST(1.5 AS TEXT)" "CAST(1e20 AS TEXT)" "CAST(0.1 AS TEXT)" "CAST(100.0 AS TEXT)" "CAST(1e-5 AS TEXT)")
  (("12" "1.5" "1.0e+20" "0.1" "100.0" "1.0e-05")))
 ("SELECT CAST(123456789.123 AS TEXT), CAST(1.0/3 AS TEXT), CAST(2.0/3 AS TEXT), CAST(-1.25e-10 AS TEXT);" :rows ("CAST(123456789.123 AS TEXT)" "CAST(1.0/3 AS TEXT)" "CAST(2.0/3 AS TEXT)" "CAST(-1.25e-10 AS TEXT)")
  (("123456789.123" "0.333333333333333" "0.666666666666667" "-1.25e-10")))
 ("SELECT CAST('12.0' AS NUMERIC), CAST('12.5' AS NUMERIC), CAST('1e2' AS NUMERIC), CAST(3.0 AS NUMERIC), CAST('abc' AS NUMERIC);" :rows ("CAST('12.0' AS NUMERIC)" "CAST('12.5' AS NUMERIC)" "CAST('1e2' AS NUMERIC)" "CAST(3.0 AS NUMERIC)" "CAST('abc' AS NUMERIC)")
  ((12 (:f "12.5") 100 (:f "3.0") 0)))
 ("SELECT CAST(NULL AS INTEGER), typeof(CAST(NULL AS TEXT)), CAST(x'3132' AS INTEGER), hex(CAST(12 AS BLOB));" :rows ("CAST(NULL AS INTEGER)" "typeof(CAST(NULL AS TEXT))" "CAST(x'3132' AS INTEGER)" "hex(CAST(12 AS BLOB))")
  ((:null "null" 12 "3132")))
 ("SELECT typeof(CAST(5 AS VARCHAR)), typeof(CAST('5' AS FLOAT)), typeof(CAST('5' AS whatever));" :rows ("typeof(CAST(5 AS VARCHAR))" "typeof(CAST('5' AS FLOAT))" "typeof(CAST('5' AS whatever))")
  (("text" "real" "integer")))
)
("expr.test:real-to-text"
 ("SELECT 1.0 || '', 1.5 || '', 1e15 || '', 1e16 || '', 123456789012345.0 || '', 1234567890123456.0 || '';" :rows ("1.0 || ''" "1.5 || ''" "1e15 || ''" "1e16 || ''" "123456789012345.0 || ''" "1234567890123456.0 || ''")
  (("1.0" "1.5" "1.0e+15" "1.0e+16" "123456789012345.0" "1.23456789012346e+15")))
 ("SELECT 0.0001 || '', 0.00001 || '', 3.14159265358979 || '', 2.718281828459045 || '', -0.0 || '';" :rows ("0.0001 || ''" "0.00001 || ''" "3.14159265358979 || ''" "2.718281828459045 || ''" "-0.0 || ''")
  (("0.0001" "1.0e-05" "3.14159265358979" "2.71828182845905" "0.0")))
 ("SELECT 1e100 || '', 1.7976931348623157e308 || '', 5e-324 || '', 4.9e-300 || '', 100.25 || '';" :rows ("1e100 || ''" "1.7976931348623157e308 || ''" "5e-324 || ''" "4.9e-300 || ''" "100.25 || ''")
  (("1.0e+100" "1.79769313486232e+308" "4.94065645841247e-324" "4.9e-300" "100.25")))
)
("expr.test:strings"
 ("SELECT 'a' || 'b' || 'c', length('hello'), lower('HeLLo'), upper('hello'), length(NULL), length(123), length(1.5);" :rows ("'a' || 'b' || 'c'" "length('hello')" "lower('HeLLo')" "upper('hello')" "length(NULL)" "length(123)" "length(1.5)")
  (("abc" 5 "hello" "HELLO" :null 3 3)))
 ("SELECT substr('hello', 2), substr('hello', 2, 3), substr('hello', -3), substr('hello', -3, 2), substr('hello', 0, 2), substr('hello', 10), substr('hello', 2, -1), substr('hello', 0);" :rows ("substr('hello', 2)" "substr('hello', 2, 3)" "substr('hello', -3)" "substr('hello', -3, 2)" "substr('hello', 0, 2)" "substr('hello', 10)" "substr('hello', 2, -1)" "substr('hello', 0)")
  (("ello" "ell" "llo" "ll" "h" "" "h" "hello")))
 ("SELECT substr(x'0102030405', 2, 2), substring('abcdef', 3);" :rows ("substr(x'0102030405', 2, 2)" "substring('abcdef', 3)")
  (((:blob "0203") "cdef")))
 ("SELECT trim('  x  '), ltrim('  x  '), rtrim('  x  '), trim('xxhixx', 'x'), ltrim('abcba', 'ab'), rtrim('abcba', 'ab');" :rows ("trim('  x  ')" "ltrim('  x  ')" "rtrim('  x  ')" "trim('xxhixx', 'x')" "ltrim('abcba', 'ab')" "rtrim('abcba', 'ab')")
  (("x" "x  " "  x" "hi" "cba" "abc")))
 ("SELECT replace('hello world', 'o', '0'), replace('aaa', 'a', 'bb'), replace('abc', '', 'x'), instr('hello', 'll'), instr('hello', 'z');" :rows ("replace('hello world', 'o', '0')" "replace('aaa', 'a', 'bb')" "replace('abc', '', 'x')" "instr('hello', 'll')" "instr('hello', 'z')")
  (("hell0 w0rld" "bbbbbb" "abc" 3 0)))
 ("SELECT hex('abc'), hex(NULL), hex(255), quote('it''s'), quote(1), quote(NULL), quote(x'abcd'), quote(1.5);" :rows ("hex('abc')" "hex(NULL)" "hex(255)" "quote('it''s')" "quote(1)" "quote(NULL)" "quote(x'abcd')" "quote(1.5)")
  (("616263" "" "323535" "'it''s'" "1" "NULL" "X'ABCD'" "1.5")))
 ("SELECT char(72, 105), unicode('A'), unicode(''), printf('%d', 5);" :rows ("char(72, 105)" "unicode('A')" "unicode('')" "printf('%d', 5)")
  (("Hi" 65 :null "5")))
)
("expr.test:like-glob"
 ("SELECT 'hello' LIKE 'h%', 'hello' LIKE 'H%', 'hello' LIKE '_ello', 'hello' LIKE '%l%', 'hello' LIKE 'hel', 'hello' NOT LIKE 'x%';" :rows ("'hello' LIKE 'h%'" "'hello' LIKE 'H%'" "'hello' LIKE '_ello'" "'hello' LIKE '%l%'" "'hello' LIKE 'hel'" "'hello' NOT LIKE 'x%'")
  ((1 1 1 1 0 1)))
 ("SELECT 'a%c' LIKE 'a\\%c' ESCAPE '\\', 'abc' LIKE 'a\\%c' ESCAPE '\\', 'a_c' LIKE 'a#_c' ESCAPE '#';" :rows ("'a%c' LIKE 'a\\%c' ESCAPE '\\'" "'abc' LIKE 'a\\%c' ESCAPE '\\'" "'a_c' LIKE 'a#_c' ESCAPE '#'")
  ((1 0 1)))
 ("SELECT 'hello' GLOB 'h*', 'hello' GLOB 'H*', 'hello' GLOB 'h?llo', 'hello' GLOB 'h[a-e]llo', 'hello' GLOB 'h[^e]llo', 'a]b' GLOB 'a[]]b';" :rows ("'hello' GLOB 'h*'" "'hello' GLOB 'H*'" "'hello' GLOB 'h?llo'" "'hello' GLOB 'h[a-e]llo'" "'hello' GLOB 'h[^e]llo'" "'a]b' GLOB 'a[]]b'")
  ((1 0 1 1 0 1)))
 ("SELECT NULL LIKE 'a', 'a' LIKE NULL, like('a%', 'abc'), glob('*c', 'abc');" :rows ("NULL LIKE 'a'" "'a' LIKE NULL" "like('a%', 'abc')" "glob('*c', 'abc')")
  ((:null :null 1 1)))
 ("SELECT 'ABC' LIKE 'abc', 'Ä' LIKE 'ä', '' LIKE '%', '' LIKE '_';" :rows ("'ABC' LIKE 'abc'" "'Ä' LIKE 'ä'" "'' LIKE '%'" "'' LIKE '_'")
  ((1 0 1 0)))
)
("expr.test:case"
 ("SELECT CASE 1 WHEN 1 THEN 'one' WHEN 2 THEN 'two' ELSE 'many' END;" :rows ("CASE 1 WHEN 1 THEN 'one' WHEN 2 THEN 'two' ELSE 'many' END")
  (("one")))
 ("SELECT CASE 3 WHEN 1 THEN 'one' WHEN 2 THEN 'two' END;" :rows ("CASE 3 WHEN 1 THEN 'one' WHEN 2 THEN 'two' END")
  ((:null)))
 ("SELECT CASE WHEN 1 > 2 THEN 'a' WHEN 2 > 1 THEN 'b' ELSE 'c' END;" :rows ("CASE WHEN 1 > 2 THEN 'a' WHEN 2 > 1 THEN 'b' ELSE 'c' END")
  (("b")))
 ("SELECT CASE NULL WHEN NULL THEN 'null' ELSE 'not' END;" :rows ("CASE NULL WHEN NULL THEN 'null' ELSE 'not' END")
  (("not")))
 ("SELECT iif(1, 'y', 'n'), iif(0, 'y', 'n'), iif(NULL, 'y', 'n');" :rows ("iif(1, 'y', 'n')" "iif(0, 'y', 'n')" "iif(NULL, 'y', 'n')")
  (("y" "n" "n")))
)
("expr.test:between-in"
 ("SELECT 5 BETWEEN 1 AND 10, 5 NOT BETWEEN 1 AND 10, 'b' BETWEEN 'a' AND 'c', NULL BETWEEN 1 AND 2, 1 BETWEEN NULL AND 2, 3 BETWEEN NULL AND 2;" :rows ("5 BETWEEN 1 AND 10" "5 NOT BETWEEN 1 AND 10" "'b' BETWEEN 'a' AND 'c'" "NULL BETWEEN 1 AND 2" "1 BETWEEN NULL AND 2" "3 BETWEEN NULL AND 2")
  ((1 0 1 :null :null 0)))
 ("SELECT 1 IN (1, 2), 3 IN (1, 2), 3 NOT IN (1, 2), NULL IN (1), 1 IN (NULL, 1), 2 IN (NULL, 1), 2 NOT IN (NULL, 1), 1 IN (), 1 NOT IN ();" :rows ("1 IN (1, 2)" "3 IN (1, 2)" "3 NOT IN (1, 2)" "NULL IN (1)" "1 IN (NULL, 1)" "2 IN (NULL, 1)" "2 NOT IN (NULL, 1)" "1 IN ()" "1 NOT IN ()")
  ((1 0 1 :null 1 :null :null 0 1)))
 ("SELECT 'a' IN ('A', 'a'), 1.0 IN (1), '1' IN (1);" :rows ("'a' IN ('A', 'a')" "1.0 IN (1)" "'1' IN (1)")
  ((1 1 0)))
)
