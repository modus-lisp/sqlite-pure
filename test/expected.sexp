  ((1 "hello world" "the quick brown fox")
   (2 "Hello again" "lazy dog hello")))
 ("SELECT rowid FROM ft WHERE ft MATCH 'HELLO';" :rows ("rowid")
  ((1)
   (2)))
 ("SELECT rowid FROM ft WHERE ft = 'hello';" :rows ("rowid")
  ((1)
   (2)))
 ("SELECT rowid FROM ft WHERE a MATCH 'hello';" :rows ("rowid")
  ((1)
   (2)))
 ("SELECT rowid FROM ft WHERE b MATCH 'hello';" :rows ("rowid")
  ((2)))
 ("SELECT rowid FROM ft('hello');" :rows ("rowid")
  ((1)
   (2)))
 ("SELECT rowid FROM ft WHERE ft MATCH 'hello' AND rowid > 1;" :rows ("rowid")
  ((2)))
 ("SELECT rowid FROM ft WHERE rowid = 2;" :rows ("rowid")
  ((2)))
 ("DELETE FROM ft WHERE rowid = 1;" :ok)
 ("SELECT id, hex(block) FROM ft_data ORDER BY id;" :rows ("id" "hex(block)")
  ((1 "020304")
   (10 "000000000104040004010101020101030101040101")
   (137438953473 "00000044063062726F776E01060101040103666F780106010105010568656C6C6F0102020105717569636B0106010103010374686501060101020105776F726C64010203040C0A0A0C0A")
   (274877906945 "000000300630616761696E0202030103646F670206010103010568656C6C6F02080201010401046C617A790206010102040A0A0D")
   (412316860417 "000000180430726F770A06010102010574686972640A0202040A")
   (549755813889 "00000036063062726F776E01010103666F780101010568656C6C6F01010105717569636B0101010374686501010105776F726C640101040907090907")))
