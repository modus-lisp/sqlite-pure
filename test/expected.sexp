   (18 14 0 "SCAN u USING COVERING INDEX sqlite_autoindex_u_1")
   (27 0 0 "SCALAR SUBQUERY 4")
   (30 27 0 "SCAN CONSTANT ROW")
   (33 27 0 "SCALAR SUBQUERY 3")
   (36 33 0 "SCAN CONSTANT ROW")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE a = (SELECT 1) AND b IN (SELECT x FROM (SELECT x FROM u GROUP BY x));" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING INDEX ta (a=?)")
   (6 0 0 "SCALAR SUBQUERY 1")
   (9 6 0 "SCAN CONSTANT ROW")
   (20 0 0 "LIST SUBQUERY 3")
   (22 20 0 "CO-ROUTINE (subquery-2)")
   (28 22 0 "SCAN u")
   (30 22 0 "USE TEMP B-TREE FOR GROUP BY")
   (62 20 0 "SCAN (subquery-2)")))
 ("EXPLAIN QUERY PLAN SELECT (SELECT max(x) FROM u) AS m, a FROM t ORDER BY c;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SCAN t")
   (7 0 0 "SCALAR SUBQUERY 1")
   (12 7 0 "SEARCH u")
   (28 0 0 "USE TEMP B-TREE FOR ORDER BY")))
 ("EXPLAIN QUERY PLAN SELECT c, (SELECT 1) FROM t GROUP BY c ORDER BY 2;" :rows ("id" "parent" "notused" "detail")
  ((7 0 0 "SCAN t")
   (9 0 0 "USE TEMP B-TREE FOR GROUP BY")
   (37 0 0 "SCALAR SUBQUERY 1")
   (40 37 0 "SCAN CONSTANT ROW")
   (51 0 0 "USE TEMP B-TREE FOR ORDER BY")))
 ("EXPLAIN QUERY PLAN SELECT DISTINCT c, (SELECT x FROM u WHERE id = t.a) FROM t ORDER BY b;" :rows ("id" "parent" "notused" "detail")
  ((4 0 0 "SCAN t")
   (8 0 0 "CORRELATED SCALAR SUBQUERY 1")
   (12 8 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid=?)")
   (26 0 0 "USE TEMP B-TREE FOR DISTINCT")
   (27 0 0 "USE TEMP B-TREE FOR ORDER BY")))
)
("explain.test:eqp-compound-dml-misc"
 ("CREATE TABLE t(a, b, c);" :ok)
 ("CREATE INDEX ta ON t(a);" :ok)
 ("CREATE TABLE u(id INTEGER PRIMARY KEY, x, y UNIQUE);" :ok)
 ("CREATE VIRTUAL TABLE r USING rtree(id, x0, x1, y0, y1);" :ok)
 ("CREATE VIEW v AS SELECT a, count(*) AS n FROM t GROUP BY a;" :ok)
 ("EXPLAIN QUERY PLAN SELECT a FROM t UNION SELECT x FROM u;" :rows ("id" "parent" "notused" "detail")
  ((1 0 0 "COMPOUND QUERY")
   (2 1 0 "LEFT-MOST SUBQUERY")
   (5 2 0 "SCAN t USING COVERING INDEX ta")
   (11 1 0 "UNION USING TEMP B-TREE")
   (13 11 0 "SCAN u")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t UNION ALL SELECT x FROM u;" :rows ("id" "parent" "notused" "detail")
  ((1 0 0 "COMPOUND QUERY")
   (2 1 0 "LEFT-MOST SUBQUERY")
   (4 2 0 "SCAN t USING COVERING INDEX ta")
   (9 1 0 "UNION ALL")
   (11 9 0 "SCAN u")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t EXCEPT SELECT x FROM u;" :rows ("id" "parent" "notused" "detail")
  ((1 0 0 "COMPOUND QUERY")
   (2 1 0 "LEFT-MOST SUBQUERY")
   (5 2 0 "SCAN t USING COVERING INDEX ta")
   (11 1 0 "EXCEPT USING TEMP B-TREE")
   (13 11 0 "SCAN u")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t INTERSECT SELECT x FROM u;" :rows ("id" "parent" "notused" "detail")
  ((1 0 0 "COMPOUND QUERY")
   (2 1 0 "LEFT-MOST SUBQUERY")
   (5 2 0 "SCAN t USING COVERING INDEX ta")
   (12 1 0 "INTERSECT USING TEMP B-TREE")
   (14 12 0 "SCAN u")))
 ("EXPLAIN QUERY PLAN SELECT * FROM r;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN r VIRTUAL TABLE INDEX 2:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM r WHERE x0 > 1;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN r VIRTUAL TABLE INDEX 2:E0")))
 ("EXPLAIN QUERY PLAN SELECT * FROM r WHERE x0 > 1 AND y1 < 5 AND x1 = 3;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN r VIRTUAL TABLE INDEX 2:E0C3A1")))
 ("EXPLAIN QUERY PLAN SELECT * FROM r WHERE id = 3;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN r VIRTUAL TABLE INDEX 1:")))
 ("EXPLAIN QUERY PLAN SELECT * FROM json_each('[1]');" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN json_each VIRTUAL TABLE INDEX 1:")))
