("rtree.test:rtree-churn"
 ("CREATE VIRTUAL TABLE t USING rtree(id, a, b, c, d, e, f, +tag);" :ok)
 ("WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 2500)
  INSERT INTO t SELECT i, i % 97, i % 97 + 3, (i * 31) % 211, (i * 31) % 211 + 1, i % 7, i % 7 + i % 5, 'tag' || i FROM n;" :ok)
 ("SELECT rtreecheck('t');" :rows ("rtreecheck('t')")
  (("ok")))
 ("DELETE FROM t WHERE id % 3 = 0;" :ok)
 ("SELECT rtreecheck('t');" :rows ("rtreecheck('t')")
  (("ok")))
 ("SELECT count(*), sum(a), sum(f), count(tag) FROM t;" :rows ("count(*)" "sum(a)" "sum(f)" "count(tag)")
  ((1667 (:f "79468.0") (:f "8331.0") 1667)))
 ("UPDATE t SET a = a + 1000, b = b + 1000 WHERE id % 5 = 1;" :ok)
 ("SELECT rtreecheck('t');" :rows ("rtreecheck('t')")
  (("ok")))
 ("SELECT count(*), sum(id) FROM t WHERE a >= 1000;" :rows ("count(*)" "sum(id)")
  ((333 415333)))
 ("DELETE FROM t WHERE id > 100;" :ok)
 ("SELECT rtreecheck('t');" :rows ("rtreecheck('t')")
  (("ok")))
 ("SELECT count(*), sum(id), group_concat(tag) FROM (SELECT * FROM t ORDER BY id);" :rows ("count(*)" "sum(id)" "group_concat(tag)")
  ((67 3367 "tag1,tag2,tag4,tag5,tag7,tag8,tag10,tag11,tag13,tag14,tag16,tag17,tag19,tag20,tag22,tag23,tag25,tag26,tag28,tag29,tag31,tag32,tag34,tag35,tag37,tag38,tag40,tag41,tag43,tag44,tag46,tag47,tag49,tag50,tag52,tag53,tag55,tag56,tag58,tag59,tag61,tag62,tag64,tag65,tag67,tag68,tag70,tag71,tag73,tag74,tag76,tag77,tag79,tag80,tag82,tag83,tag85,tag86,tag88,tag89,tag91,tag92,tag94,tag95,tag97,tag98,tag100")))
 ("DELETE FROM t WHERE id > 5;" :ok)
 ("SELECT rtreecheck('t'), (SELECT count(*) FROM t_parent), (SELECT count(*) FROM t_node);" :rows ("rtreecheck('t')" "(SELECT count(*) FROM t_parent)" "(SELECT count(*) FROM t_node)")
  (("ok" 0 1)))
 ("DELETE FROM t;" :ok)
 ("SELECT rtreecheck('t'), (SELECT count(*) FROM t_node), (SELECT hex(substr(data, 1, 4)) FROM t_node);" :rows ("rtreecheck('t')" "(SELECT count(*) FROM t_node)" "(SELECT hex(substr(data, 1, 4)) FROM t_node)")
  (("ok" 1 "00000000")))
 ("INSERT INTO t VALUES (1, 0, 1, 0, 1, 0, 1, 'again');" :ok)
 ("SELECT * FROM t;" :rows ("id" "a" "b" "c" "d" "e" "f" "tag")
  ((1 (:f "0.0") (:f "1.0") (:f "0.0") (:f "1.0") (:f "0.0") (:f "1.0") "again")))
)
