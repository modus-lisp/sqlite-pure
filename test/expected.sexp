 ("INSERT INTO rt VALUES (5.5, 0, 1, 0, 1);" :ok)
 ("INSERT INTO rt VALUES ('7', 0, 1, 0, 1);" :ok)
 ("INSERT INTO rt VALUES ('x', 0, 1, 0, 1);" :ok)
 ("INSERT INTO rt VALUES (NULL, 0, 1, 0, 1);" :ok)
 ("INSERT INTO rt VALUES (9, '3', '4.5', X'00', 2);" :ok)
 ("INSERT INTO rt VALUES ('1.5e3', '2e0x', '1e1', -1e-45, 1e-45);" :ok)
 ("INSERT INTO rt VALUES (40, 1e40, 1e41, -1e40, 1e-50);" :ok)
 ("INSERT INTO rt VALUES (41, 16777217, 16777217, -16777217, -16777217);" :ok)
 ("INSERT INTO rt VALUES (42, 0.3, 0.3, -0.3, -0.3);" :ok)
 ("INSERT INTO rt DEFAULT VALUES;" :ok)
 ("SELECT * FROM rt ORDER BY id;" :rows ("id" "x0" "x1" "y0" "y1")
  ((0 (:f "0.0") (:f "1.0") (:f "0.0") (:f "1.0"))
   (1 (:f "2.0") (:f "10.0") (:f "-1.401298464324817e-45") (:f "1.401298464324817e-45"))
   (4 (:f "0.0") (:f "0.0") (:f "0.0") (:f "0.0"))
   (5 (:f "0.0") (:f "1.0") (:f "0.0") (:f "1.0"))
   (7 (:f "0.0") (:f "1.0") (:f "0.0") (:f "1.0"))
   (8 (:f "0.0") (:f "1.0") (:f "0.0") (:f "1.0"))
   (9 (:f "3.0") (:f "4.5") (:f "0.0") (:f "2.0"))
   (40 :inf :inf :-inf (:f "0.0"))
   (41 (:f "16777216.0") (:f "16777220.0") (:f "-16777220.0") (:f "-16777216.0"))
   (42 (:f "0.2999999523162842") (:f "0.30000001192092896") (:f "-0.30000001192092896") (:f "-0.2999999523162842"))
   (43 (:f "0.0") (:f "0.0") (:f "0.0") (:f "0.0"))))
