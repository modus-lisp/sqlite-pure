("ddl.test:indexes-and-lookup"
 ("CREATE TABLE t(a, b, c);" :ok)
 ("CREATE INDEX ta ON t(a);" :ok)
 ("CREATE UNIQUE INDEX tbc ON t(b, c DESC);" :ok)
 ("INSERT INTO t VALUES (1, 'x', 1), (2, 'x', 2), (1, 'y', 3), (3, 'z', NULL);" :ok)
 ("SELECT c FROM t WHERE a = 1 ORDER BY c;" :rows ("c")
  ((1)
   (3)))
 ("SELECT a FROM t WHERE b = 'x' AND c = 2;" :rows ("a")
  ((2)))
 ("INSERT INTO t VALUES (9, 'x', 1);" :error "UNIQUE constraint failed: t.b, t.c")
 ("SELECT count(*) FROM t WHERE a = '1';" :rows ("count(*)")
  ((0)))
 ("SELECT type, name, tbl_name, sql FROM sqlite_schema ORDER BY name;" :rows ("type" "name" "tbl_name" "sql")
  (("table" "t" "t" "CREATE TABLE t(a, b, c)")
   ("index" "ta" "t" "CREATE INDEX ta ON t(a)")
   ("index" "tbc" "t" "CREATE UNIQUE INDEX tbc ON t(b, c DESC)")))
 ("CREATE INDEX ta ON t(b);" :error "index ta already exists")
 ("CREATE INDEX IF NOT EXISTS ta ON t(b);" :ok)
 ("DROP INDEX ta;" :ok)
 ("SELECT c FROM t WHERE a = 1 ORDER BY c;" :rows ("c")
  ((1)
   (3)))
 ("DROP INDEX ta;" :error "no such index: ta")
 ("DROP INDEX IF EXISTS ta;" :ok)
)
("ddl.test:index-collation"
 ("CREATE TABLE t(name TEXT COLLATE NOCASE, v);" :ok)
 ("CREATE INDEX tn ON t(name);" :ok)
 ("INSERT INTO t VALUES ('Alice', 1), ('bob', 2), ('ALICE', 3);" :ok)
 ("SELECT v FROM t WHERE name = 'alice' ORDER BY v;" :rows ("v")
  ((1)
   (3)))
 ("SELECT name FROM t ORDER BY name, v;" :rows ("name")
  (("Alice")
   ("ALICE")
   ("bob")))
 ("SELECT v FROM t WHERE name = 'BOB';" :rows ("v")
  ((2)))
)
("ddl.test:unique-index-on-existing-data"
 ("CREATE TABLE t(a);" :ok)
 ("INSERT INTO t VALUES (1), (2), (1);" :ok)
 ("CREATE UNIQUE INDEX ua ON t(a);" :error "UNIQUE constraint failed: t.a")
 ("SELECT count(*) FROM sqlite_schema WHERE name = 'ua';" :rows ("count(*)")
  ((0)))
 ("DELETE FROM t WHERE rowid = 3;" :ok)
 ("CREATE UNIQUE INDEX ua ON t(a);" :ok)
 ("INSERT INTO t VALUES (2);" :error "UNIQUE constraint failed: t.a")
)
("ddl.test:drop-table"
 ("CREATE TABLE t(a UNIQUE);" :ok)
 ("CREATE INDEX ti ON t(a);" :ok)
 ("INSERT INTO t VALUES (1);" :ok)
 ("DROP TABLE t;" :ok)
 ("SELECT * FROM t;" :error "no such table: t")
 ("SELECT count(*) FROM sqlite_schema;" :rows ("count(*)")
  ((0)))
 ("CREATE TABLE t(b);" :ok)
 ("SELECT * FROM t;" :rows ("b")
  ())
 ("DROP TABLE IF EXISTS nosuch;" :ok)
 ("DROP TABLE nosuch;" :error "no such table: nosuch")
)
("ddl.test:create-errors"
 ("CREATE TABLE t(a);" :ok)
 ("CREATE TABLE t(b);" :error "table t already exists")
 ("CREATE TABLE IF NOT EXISTS t(b);" :ok)
 ("CREATE TABLE T(c);" :error "table T already exists")
 ("CREATE TABLE sqlite_x(a);" :error "object name reserved for internal use: sqlite_x")
 ("CREATE TABLE u(a, a);" :error "duplicate column name: a")
 ("CREATE TABLE v(a PRIMARY KEY, b PRIMARY KEY);" :error "table \"v\" has more than one primary key")
 ("SELECT name FROM sqlite_schema ORDER BY name;" :rows ("name")
  (("t")))
)
("ddl.test:create-table-as"
 ("CREATE TABLE src(a INTEGER, b TEXT, c);" :ok)
 ("INSERT INTO src VALUES (1, 'x', 1.5), (2, 'y', NULL);" :ok)
 ("CREATE TABLE dst AS SELECT a, b AS bee, c * 2 AS c2, a || b FROM src;" :ok)
 ("SELECT * FROM dst ORDER BY a;" :rows ("a" "bee" "c2" "a || b")
  ((1 "x" (:f "3.0") "1x")
   (2 "y" :null "2y")))
 ("SELECT sql FROM sqlite_schema WHERE name = 'dst';" :rows ("sql")
  (("CREATE TABLE dst(a INT,bee TEXT,c2,\"a || b\")")))
 ("SELECT typeof(a), typeof(bee) FROM dst;" :rows ("typeof(a)" "typeof(bee)")
  (("integer" "text")
   ("integer" "text")))
)
("ddl.test:alter-table"
 ("CREATE TABLE t(a, b);" :ok)
 ("INSERT INTO t VALUES (1, 2);" :ok)
 ("ALTER TABLE t ADD COLUMN c TEXT DEFAULT 'dc';" :ok)
 ("ALTER TABLE t ADD d INTEGER;" :ok)
 ("SELECT * FROM t;" :rows ("a" "b" "c" "d")
  ((1 2 "dc" :null)))
 ("INSERT INTO t VALUES (3, 4, 'x', 5);" :ok)
 ("SELECT * FROM t ORDER BY a;" :rows ("a" "b" "c" "d")
  ((1 2 "dc" :null)
   (3 4 "x" 5)))
 ("SELECT sql FROM sqlite_schema WHERE name = 't';" :rows ("sql")
  (("CREATE TABLE t(a, b, c TEXT DEFAULT 'dc', d INTEGER)")))
 ("ALTER TABLE t RENAME TO t2;" :ok)
 ("SELECT a FROM t2 ORDER BY a;" :rows ("a")
  ((1)
   (3)))
 ("SELECT name, sql FROM sqlite_schema;" :rows ("name" "sql")
  (("t2" "CREATE TABLE \"t2\"(a, b, c TEXT DEFAULT 'dc', d INTEGER)")))
 ("ALTER TABLE t2 RENAME COLUMN b TO bb;" :ok)
 ("SELECT bb FROM t2 ORDER BY bb;" :rows ("bb")
  ((2)
   (4)))
 ("ALTER TABLE t2 DROP COLUMN c;" :ok)
 ("SELECT * FROM t2 ORDER BY a;" :rows ("a" "bb" "d")
  ((1 2 :null)
   (3 4 5)))
 ("SELECT sql FROM sqlite_schema WHERE name = 't2';" :rows ("sql")
  (("CREATE TABLE \"t2\"(a, bb, d INTEGER)")))
 ("ALTER TABLE t2 ADD COLUMN e NOT NULL;" :error "Cannot add a NOT NULL column with default value NULL")
 ("ALTER TABLE t2 ADD COLUMN a;" :error "duplicate column name: a")
)
("ddl.test:pragmas"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT 'x', score REAL, u UNIQUE);" :ok)
 ("CREATE INDEX ts ON t(score DESC, name);" :ok)
 ("PRAGMA table_info(t);" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk")
  ((0 "id" "INTEGER" 0 :null 1)
   (1 "name" "TEXT" 1 "'x'" 0)
   (2 "score" "REAL" 0 :null 0)
   (3 "u" "" 0 :null 0)))
 ("PRAGMA index_list(t);" :rows ("seq" "name" "unique" "origin" "partial")
  ((0 "ts" 0 "c" 0)
   (1 "sqlite_autoindex_t_1" 1 "u" 0)))
 ("PRAGMA index_info(ts);" :rows ("seqno" "cid" "name")
  ((0 2 "score")
   (1 1 "name")))
 ("PRAGMA user_version;" :rows ("user_version")
  ((0)))
 ("PRAGMA user_version = 42;" :ok)
 ("PRAGMA user_version;" :rows ("user_version")
  ((42)))
 ("PRAGMA integrity_check;" :rows ("integrity_check")
  (("ok")))
)
("ddl.test:without-rowid"
 ("CREATE TABLE w(k TEXT, n INTEGER, v, PRIMARY KEY (k, n)) WITHOUT ROWID;" :ok)
 ("INSERT INTO w VALUES ('b', 2, 'b2'), ('a', 1, 'a1'), ('a', 2, 'a2');" :ok)
 ("SELECT * FROM w;" :rows ("k" "n" "v")
  (("a" 1 "a1")
   ("a" 2 "a2")
   ("b" 2 "b2")))
 ("SELECT v FROM w WHERE k = 'a' AND n = 2;" :rows ("v")
  (("a2")))
 ("INSERT INTO w VALUES ('a', 1, 'dup');" :error "UNIQUE constraint failed: w.k, w.n")
 ("INSERT OR REPLACE INTO w VALUES ('a', 1, 'new');" :ok)
 ("UPDATE w SET v = v || '!' WHERE k = 'b';" :ok)
 ("DELETE FROM w WHERE k = 'a' AND n = 2;" :ok)
 ("SELECT * FROM w;" :rows ("k" "n" "v")
  (("a" 1 "new")
   ("b" 2 "b2!")))
 ("SELECT rowid FROM w;" :error "no such column: rowid")
)
("ddl.test:without-rowid-secondary-index"
 ("CREATE TABLE w(p INTEGER, q TEXT, r, PRIMARY KEY (p, q)) WITHOUT ROWID;" :ok)
 ("CREATE INDEX wr ON w(r);" :ok)
 ("INSERT INTO w VALUES (1, 'a', 10), (2, 'b', 20), (3, 'c', 10);" :ok)
 ("SELECT p, q FROM w WHERE r = 10 ORDER BY p;" :rows ("p" "q")
  ((1 "a")
   (3 "c")))
 ("UPDATE w SET p = p + 100 WHERE r = 10;" :ok)
 ("SELECT * FROM w ORDER BY p;" :rows ("p" "q" "r")
  ((2 "b" 20)
   (101 "a" 10)
   (103 "c" 10)))
 ("DELETE FROM w WHERE r = 20;" :ok)
 ("SELECT count(*) FROM w;" :rows ("count(*)")
  ((2)))
 ("PRAGMA integrity_check;" :rows ("integrity_check")
  (("ok")))
)
("ddl.test:generated-columns"
 ("CREATE TABLE g(a INTEGER, b AS (a * 2), c TEXT, d AS (a || c) STORED, e);" :ok)
 ("INSERT INTO g(a, c, e) VALUES (3, 'x', 99);" :ok)
 ("INSERT INTO g VALUES (4, 'y', 100);" :ok)
 ("SELECT * FROM g ORDER BY a;" :rows ("a" "b" "c" "d" "e")
  ((3 6 "x" "3x" 99)
   (4 8 "y" "4y" 100)))
 ("SELECT b, d FROM g WHERE b > 6;" :rows ("b" "d")
  ((8 "4y")))
 ("UPDATE g SET a = 10 WHERE a = 3;" :ok)
 ("SELECT * FROM g ORDER BY a;" :rows ("a" "b" "c" "d" "e")
  ((4 8 "y" "4y" 100)
   (10 20 "x" "10x" 99)))
 ("INSERT INTO g(a, b) VALUES (1, 2);" :error "cannot INSERT into generated column \"b\"")
 ("UPDATE g SET b = 1;" :error "cannot UPDATE generated column \"b\"")
 ("PRAGMA table_info(g);" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk")
  ((0 "a" "INTEGER" 0 :null 0)
   (1 "c" "TEXT" 0 :null 0)
   (2 "e" "" 0 :null 0)))
 ("PRAGMA table_xinfo(g);" :rows ("cid" "name" "type" "notnull" "dflt_value" "pk" "hidden")
  ((0 "a" "INTEGER" 0 :null 0 0)
   (1 "b" "" 0 :null 0 2)
   (2 "c" "TEXT" 0 :null 0 0)
   (3 "d" "" 0 :null 0 3)
   (4 "e" "" 0 :null 0 0)))
 ("CREATE INDEX gb ON g(b);" :ok)
 ("SELECT a FROM g WHERE b = 8;" :rows ("a")
  ((4)))
 ("PRAGMA integrity_check;" :rows ("integrity_check")
  (("ok")))
)
("ddl.test:strict-tables"
 ("CREATE TABLE s(i INTEGER, r REAL, t TEXT, b BLOB, a ANY) STRICT;" :ok)
 ("INSERT INTO s VALUES (1, 2.5, 'x', x'00', 3);" :ok)
 ("INSERT INTO s VALUES ('1', 2, 3, x'00', 'z');" :ok)
 ("INSERT INTO s VALUES ('abc', 1, 1, 1, 1);" :error "cannot store TEXT value in INTEGER column s.i")
 ("INSERT INTO s VALUES (1.5, 1, 1, 1, 1);" :error "cannot store REAL value in INTEGER column s.i")
 ("INSERT INTO s VALUES (NULL, NULL, NULL, NULL, NULL);" :ok)
 ("SELECT typeof(i), i, typeof(r), r, typeof(t), t, typeof(a), a FROM s ORDER BY rowid;" :rows ("typeof(i)" "i" "typeof(r)" "r" "typeof(t)" "t" "typeof(a)" "a")
  (("integer" 1 "real" (:f "2.5") "text" "x" "integer" 3)
   ("integer" 1 "real" (:f "2.0") "text" "3" "text" "z")
   ("null" :null "null" :null "null" :null "null" :null)))
 ("UPDATE s SET i = 'nope';" :error "cannot store TEXT value in INTEGER column s.i")
 ("CREATE TABLE bad(x FOO) STRICT;" :error "unknown datatype for bad.x: \"FOO\"")
 ("CREATE TABLE bad2(x) STRICT;" :error "missing datatype for bad2.x")
)
("dml.test:update-basic"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, v, w);" :ok)
 ("INSERT INTO t VALUES (1, 'a', 10), (2, 'b', 20), (3, 'c', 30);" :ok)
 ("UPDATE t SET w = w + 1 WHERE id >= 2;" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v" "w")
  ((1 "a" 10)
   (2 "b" 21)
   (3 "c" 31)))
 ("UPDATE t SET v = upper(v), w = w * 2;" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v" "w")
  ((1 "A" 20)
   (2 "B" 42)
   (3 "C" 62)))
 ("UPDATE t SET id = id + 10 WHERE id = 1;" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v" "w")
  ((2 "B" 42)
   (3 "C" 62)
   (11 "A" 20)))
 ("UPDATE t SET v = 'z' WHERE 0;" :ok)
 ("SELECT changes();" :rows ("changes()")
  ((0)))
 ("UPDATE t SET w = NULL WHERE v = 'B';" :ok)
 ("SELECT changes(), total_changes();" :rows ("changes()" "total_changes()")
  ((1 10)))
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v" "w")
  ((2 "B" :null)
   (3 "C" 62)
   (11 "A" 20)))
)
("dml.test:delete-basic"
 ("CREATE TABLE t(a);" :ok)
 ("INSERT INTO t VALUES (1), (2), (3), (4), (5);" :ok)
 ("DELETE FROM t WHERE a % 2 = 0;" :ok)
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (3)
   (5)))
 ("SELECT changes();" :rows ("changes()")
  ((2)))
 ("DELETE FROM t;" :ok)
 ("SELECT count(*) FROM t;" :rows ("count(*)")
  ((0)))
 ("INSERT INTO t VALUES (9);" :ok)
 ("SELECT rowid, a FROM t;" :rows ("rowid" "a")
  ((1 9)))
)
("dml.test:not-null"
 ("CREATE TABLE t(a NOT NULL, b);" :ok)
 ("INSERT INTO t VALUES (1, 2);" :ok)
 ("INSERT INTO t VALUES (NULL, 2);" :error "NOT NULL constraint failed: t.a")
 ("INSERT OR IGNORE INTO t VALUES (NULL, 3);" :ok)
 ("SELECT * FROM t;" :rows ("a" "b")
  ((1 2)))
 ("UPDATE t SET a = NULL;" :error "NOT NULL constraint failed: t.a")
 ("SELECT * FROM t;" :rows ("a" "b")
  ((1 2)))
)
("dml.test:not-null-replace-default"
 ("CREATE TABLE t(a NOT NULL DEFAULT 'dflt', b);" :ok)
 ("INSERT OR REPLACE INTO t VALUES (NULL, 1);" :ok)
 ("SELECT * FROM t;" :rows ("a" "b")
  (("dflt" 1)))
)
("dml.test:unique"
 ("CREATE TABLE t(a UNIQUE, b);" :ok)
 ("INSERT INTO t VALUES (1, 'x'), (2, 'y');" :ok)
 ("INSERT INTO t VALUES (1, 'z');" :error "UNIQUE constraint failed: t.a")
 ("INSERT INTO t VALUES (NULL, 'n1'), (NULL, 'n2');" :ok)
 ("SELECT * FROM t ORDER BY rowid;" :rows ("a" "b")
  ((1 "x")
   (2 "y")
   (:null "n1")
   (:null "n2")))
 ("INSERT OR IGNORE INTO t VALUES (2, 'ignored'), (3, 'kept');" :ok)
 ("SELECT * FROM t ORDER BY rowid;" :rows ("a" "b")
  ((1 "x")
   (2 "y")
   (:null "n1")
   (:null "n2")
   (3 "kept")))
 ("INSERT OR REPLACE INTO t VALUES (1, 'replaced');" :ok)
 ("SELECT a, b FROM t ORDER BY a;" :rows ("a" "b")
  ((:null "n1")
   (:null "n2")
   (1 "replaced")
   (2 "y")
   (3 "kept")))
 ("UPDATE t SET a = 2 WHERE a = 3;" :error "UNIQUE constraint failed: t.a")
 ("UPDATE OR REPLACE t SET a = 2 WHERE a = 3;" :ok)
 ("SELECT a, b FROM t ORDER BY a;" :rows ("a" "b")
  ((:null "n1")
   (:null "n2")
   (1 "replaced")
   (2 "kept")))
)
("dml.test:multi-column-unique"
 ("CREATE TABLE t(a, b, c, UNIQUE(a, b));" :ok)
 ("INSERT INTO t VALUES (1, 1, 'x'), (1, 2, 'y');" :ok)
 ("INSERT INTO t VALUES (1, 1, 'dup');" :error "UNIQUE constraint failed: t.a, t.b")
 ("INSERT INTO t VALUES (1, NULL, 'n'), (1, NULL, 'n2');" :ok)
 ("SELECT * FROM t ORDER BY rowid;" :rows ("a" "b" "c")
  ((1 1 "x")
   (1 2 "y")
   (1 :null "n")
   (1 :null "n2")))
)
("dml.test:primary-key-text"
 ("CREATE TABLE t(k TEXT PRIMARY KEY, v);" :ok)
 ("INSERT INTO t VALUES ('a', 1), ('b', 2);" :ok)
 ("INSERT INTO t VALUES ('a', 3);" :error "UNIQUE constraint failed: t.k")
 ("REPLACE INTO t VALUES ('a', 4);" :ok)
 ("SELECT * FROM t ORDER BY k;" :rows ("k" "v")
  (("a" 4)
   ("b" 2)))
 ("SELECT * FROM t WHERE k = 'b';" :rows ("k" "v")
  (("b" 2)))
)
("dml.test:conflict-abort-atomic"
 ("CREATE TABLE t(a UNIQUE);" :ok)
 ("INSERT INTO t VALUES (1);" :ok)
 ("INSERT INTO t VALUES (2), (3), (1), (4);" :error "UNIQUE constraint failed: t.a")
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)))
 ("INSERT OR FAIL INTO t VALUES (5), (1), (6);" :error "UNIQUE constraint failed: t.a")
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (5)))
)
("dml.test:check-constraint"
 ("CREATE TABLE t(a CHECK (a > 0), b, CONSTRAINT bpos CHECK (b IS NULL OR b < 10));" :ok)
 ("INSERT INTO t VALUES (1, 1);" :ok)
 ("INSERT INTO t VALUES (0, 1);" :error "CHECK constraint failed: a > 0")
 ("INSERT INTO t VALUES (1, 11);" :error "CHECK constraint failed: bpos")
 ("INSERT INTO t VALUES (NULL, NULL);" :ok)
 ("SELECT * FROM t ORDER BY rowid;" :rows ("a" "b")
  ((1 1)
   (:null :null)))
)
("dml.test:autoincrement"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY AUTOINCREMENT, v);" :ok)
 ("INSERT INTO t(v) VALUES ('a'), ('b'), ('c');" :ok)
 ("DELETE FROM t WHERE id = 3;" :ok)
 ("INSERT INTO t(v) VALUES ('d');" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v")
  ((1 "a")
   (2 "b")
   (4 "d")))
 ("SELECT name, seq FROM sqlite_sequence;" :rows ("name" "seq")
  (("t" 4)))
 ("INSERT INTO t VALUES (100, 'e');" :ok)
 ("INSERT INTO t(v) VALUES ('f');" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v")
  ((1 "a")
   (2 "b")
   (4 "d")
   (100 "e")
   (101 "f")))
 ("SELECT seq FROM sqlite_sequence WHERE name = 't';" :rows ("seq")
  ((101)))
)
("dml.test:rowid-reuse-without-autoincrement"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, v);" :ok)
 ("INSERT INTO t(v) VALUES ('a'), ('b'), ('c');" :ok)
 ("DELETE FROM t WHERE id = 3;" :ok)
 ("INSERT INTO t(v) VALUES ('d');" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v")
  ((1 "a")
   (2 "b")
   (3 "d")))
)
("dml.test:upsert"
 ("CREATE TABLE kv(k TEXT PRIMARY KEY, v INTEGER, n INTEGER DEFAULT 0);" :ok)
 ("INSERT INTO kv(k, v) VALUES ('a', 1);" :ok)
 ("INSERT INTO kv(k, v) VALUES ('a', 5) ON CONFLICT(k) DO UPDATE SET v = excluded.v, n = n + 1;" :ok)
 ("INSERT INTO kv(k, v) VALUES ('b', 2) ON CONFLICT(k) DO UPDATE SET v = excluded.v;" :ok)
 ("INSERT INTO kv(k, v) VALUES ('b', 9) ON CONFLICT DO NOTHING;" :ok)
 ("SELECT * FROM kv ORDER BY k;" :rows ("k" "v" "n")
  (("a" 5 1)
   ("b" 2 0)))
 ("INSERT INTO kv(k, v) VALUES ('a', 0) ON CONFLICT(k) DO UPDATE SET v = v + 100 WHERE excluded.v > 0;" :ok)
 ("SELECT * FROM kv ORDER BY k;" :rows ("k" "v" "n")
  (("a" 5 1)
   ("b" 2 0)))
)
("dml.test:returning"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, v);" :ok)
 ("INSERT INTO t(v) VALUES ('a'), ('b') RETURNING id, v;" :rows ("id" "v")
  ((1 "a")
   (2 "b")))
 ("UPDATE t SET v = v || '!' WHERE id = 2 RETURNING *;" :rows ("id" "v")
  ((2 "b!")))
 ("DELETE FROM t WHERE id = 1 RETURNING v, id * 10 AS ten;" :rows ("v" "ten")
  (("a" 10)))
 ("SELECT * FROM t;" :rows ("id" "v")
  ((2 "b!")))
)
("dml.test:insert-column-mismatch"
 ("CREATE TABLE t(a, b);" :ok)
 ("INSERT INTO t VALUES (1);" :error "table t has 2 columns but 1 values were supplied")
 ("INSERT INTO t(a) VALUES (1, 2);" :error "2 values for 1 columns")
 ("INSERT INTO t(nosuch) VALUES (1);" :error "table t has no column named nosuch")
 ("SELECT count(*) FROM t;" :rows ("count(*)")
  ((0)))
)
("dml.test:transactions"
 ("CREATE TABLE t(a);" :ok)
 ("BEGIN;" :ok)
 ("INSERT INTO t VALUES (1);" :ok)
 ("INSERT INTO t VALUES (2);" :ok)
 ("ROLLBACK;" :ok)
 ("SELECT count(*) FROM t;" :rows ("count(*)")
  ((0)))
 ("BEGIN;" :ok)
 ("INSERT INTO t VALUES (3);" :ok)
 ("COMMIT;" :ok)
 ("SELECT a FROM t;" :rows ("a")
  ((3)))
 ("COMMIT;" :error "cannot commit - no transaction is active")
 ("BEGIN;" :ok)
 ("BEGIN;" :error "cannot start a transaction within a transaction")
 ("ROLLBACK;" :ok)
)
("dml.test:statement-atomicity-in-transaction"
 ("CREATE TABLE t(a UNIQUE);" :ok)
 ("BEGIN;" :ok)
 ("INSERT INTO t VALUES (1);" :ok)
 ("INSERT INTO t VALUES (2), (1);" :error "UNIQUE constraint failed: t.a")
 ("INSERT INTO t VALUES (3);" :ok)
 ("COMMIT;" :ok)
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (3)))
)
("dml.test:update-with-index"
 ("CREATE TABLE t(a, b);" :ok)
 ("CREATE INDEX tb ON t(b);" :ok)
 ("INSERT INTO t VALUES (1, 'x'), (2, 'y'), (3, 'x');" :ok)
 ("UPDATE t SET b = 'z' WHERE b = 'x';" :ok)
 ("SELECT a FROM t WHERE b = 'z' ORDER BY a;" :rows ("a")
  ((1)
   (3)))
 ("SELECT a FROM t WHERE b = 'x';" :rows ("a")
  ())
 ("DELETE FROM t WHERE b = 'z';" :ok)
 ("SELECT a, b FROM t;" :rows ("a" "b")
  ((2 "y")))
)
("dml.test:large-values"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, s TEXT, b BLOB);" :ok)
 ("INSERT INTO t VALUES (1, 'x', NULL);" :ok)
 ("WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM c WHERE i < 200)
INSERT INTO t(s, b) SELECT printf('%.*c', i * 50, 'a'), zeroblob(i * 97) FROM c;" :ok)
 ("SELECT count(*), sum(length(s)), sum(length(b)) FROM t;" :rows ("count(*)" "sum(length(s))" "sum(length(b))")
  ((201 1005001 1949700)))
 ("UPDATE t SET s = s || s WHERE id % 7 = 0;" :ok)
 ("DELETE FROM t WHERE id % 3 = 0;" :ok)
 ("SELECT count(*), sum(length(s)), sum(length(b)) FROM t;" :rows ("count(*)" "sum(length(s))" "sum(length(b))")
  ((134 760551 1293301)))
)
("dml.test:savepoints"
 ("CREATE TABLE t(a);" :ok)
 ("SAVEPOINT s1;" :ok)
 ("INSERT INTO t VALUES (1);" :ok)
 ("SAVEPOINT s2;" :ok)
 ("INSERT INTO t VALUES (2);" :ok)
 ("ROLLBACK TO s2;" :ok)
 ("INSERT INTO t VALUES (3);" :ok)
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (3)))
 ("RELEASE s1;" :ok)
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (3)))
 ("BEGIN;" :ok)
 ("INSERT INTO t VALUES (4);" :ok)
 ("SAVEPOINT x;" :ok)
 ("DELETE FROM t;" :ok)
 ("SELECT count(*) FROM t;" :rows ("count(*)")
  ((0)))
 ("ROLLBACK TO SAVEPOINT x;" :ok)
 ("SELECT count(*) FROM t;" :rows ("count(*)")
  ((3)))
 ("RELEASE SAVEPOINT x;" :ok)
 ("ROLLBACK;" :ok)
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (3)))
 ("RELEASE nosuch;" :error "no such savepoint: nosuch")
 ("SAVEPOINT a;" :ok)
 ("CREATE TABLE u(z);" :ok)
 ("ROLLBACK TO a;" :ok)
 ("SELECT name FROM sqlite_schema ORDER BY name;" :rows ("name")
  (("t")))
 ("RELEASE a;" :ok)
)
("dml.test:foreign-keys"
 ("PRAGMA foreign_keys = ON;" :ok)
 ("PRAGMA foreign_keys;" :rows ("foreign_keys")
  ((1)))
 ("CREATE TABLE p(id INTEGER PRIMARY KEY, name TEXT UNIQUE);" :ok)
 ("CREATE TABLE ch(id INTEGER PRIMARY KEY, pid REFERENCES p(id) ON DELETE CASCADE ON UPDATE CASCADE, pname TEXT REFERENCES p(name) ON DELETE SET NULL);" :ok)
 ("CREATE TABLE r(x REFERENCES p ON DELETE RESTRICT);" :ok)
 ("INSERT INTO p VALUES (1, 'a'), (2, 'b'), (3, 'c');" :ok)
 ("INSERT INTO ch VALUES (10, 1, 'a'), (11, 2, 'b'), (12, NULL, NULL);" :ok)
 ("INSERT INTO ch VALUES (13, 9, NULL);" :error "FOREIGN KEY constraint failed")
 ("INSERT INTO ch VALUES (14, NULL, 'zz');" :error "FOREIGN KEY constraint failed")
 ("DELETE FROM p WHERE id = 1;" :ok)
 ("SELECT * FROM ch ORDER BY id;" :rows ("id" "pid" "pname")
  ((11 2 "b")
   (12 :null :null)))
 ("UPDATE p SET id = 20 WHERE id = 2;" :ok)
 ("SELECT * FROM ch ORDER BY id;" :rows ("id" "pid" "pname")
  ((11 20 "b")
   (12 :null :null)))
 ("DELETE FROM p WHERE name = 'b';" :ok)
 ("SELECT * FROM ch ORDER BY id;" :rows ("id" "pid" "pname")
  ((12 :null :null)))
 ("INSERT INTO r VALUES (3);" :ok)
 ("DELETE FROM p WHERE id = 3;" :error "FOREIGN KEY constraint failed")
 ("SELECT * FROM p ORDER BY id;" :rows ("id" "name")
  ((3 "c")))
 ("PRAGMA foreign_key_list(ch);" :rows ("id" "seq" "table" "from" "to" "on_update" "on_delete" "match")
  ((0 0 "p" "pname" "name" "NO ACTION" "SET NULL" "NONE")
   (1 0 "p" "pid" "id" "CASCADE" "CASCADE" "NONE")))
 ("UPDATE ch SET pid = 5 WHERE id = 12;" :error "FOREIGN KEY constraint failed")
 ("CREATE TABLE d(x REFERENCES p(id) DEFERRABLE INITIALLY DEFERRED);" :ok)
 ("BEGIN;" :ok)
 ("INSERT INTO d VALUES (99);" :ok)
 ("COMMIT;" :error "FOREIGN KEY constraint failed")
 ("INSERT INTO p(id) VALUES (99);" :ok)
 ("COMMIT;" :ok)
 ("SELECT count(*) FROM d;" :rows ("count(*)")
  ((1)))
 ("CREATE TABLE sn(a, b, FOREIGN KEY (a, b) REFERENCES p2(x, y) ON DELETE SET NULL);" :ok)
 ("CREATE TABLE p2(x, y, UNIQUE (x, y));" :ok)
 ("INSERT INTO p2 VALUES (1, 2);" :ok)
 ("INSERT INTO sn VALUES (1, 2), (NULL, 5);" :ok)
 ("INSERT INTO sn VALUES (1, 3);" :error "FOREIGN KEY constraint failed")
 ("DELETE FROM p2;" :ok)
 ("SELECT * FROM sn ORDER BY rowid;" :rows ("a" "b")
  ((:null :null)
   (:null 5)))
 ("PRAGMA foreign_keys = OFF;" :ok)
 ("INSERT INTO ch VALUES (50, 777, NULL);" :ok)
 ("SELECT count(*) FROM ch;" :rows ("count(*)")
  ((2)))
)
("explain.test:eqp-access-paths"
 ("CREATE TABLE t(a, b, c);" :ok)
 ("CREATE INDEX ta ON t(a);" :ok)
 ("CREATE INDEX tab ON t(a, b);" :ok)
 ("CREATE TABLE u(id INTEGER PRIMARY KEY, x, y UNIQUE);" :ok)
 ("CREATE TABLE w(k PRIMARY KEY, v) WITHOUT ROWID;" :ok)
 ("CREATE TABLE p(q, r);" :ok)
 ("EXPLAIN QUERY PLAN SELECT * FROM t;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE a = 1;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING INDEX tab (a=?)")))
 ("EXPLAIN QUERY PLAN SELECT a, b FROM t WHERE a = 1;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH t USING COVERING INDEX tab (a=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE a = 1 AND b = 2;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING INDEX tab (a=? AND b=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE b = 2 AND a = 7;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING INDEX tab (a=? AND b=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u WHERE id = 5;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u WHERE rowid = 5;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u WHERE id > 5 AND id < 9;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid>? AND rowid<?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u WHERE id >= 5;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid>?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u WHERE id <= 5;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH u USING INTEGER PRIMARY KEY (rowid<?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM u WHERE y = 3;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH u USING INDEX sqlite_autoindex_u_1 (y=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM w WHERE k = 1;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH w USING PRIMARY KEY (k=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM w;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN w")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t AS x WHERE x.a = 1;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH x USING INDEX tab (a=?)")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE b = 3;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE +a = 1;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t WHERE c IN (1, 2, 3);" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")))
 ("EXPLAIN QUERY PLAN SELECT * FROM t NOT INDEXED WHERE a = 1;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")))
 ("EXPLAIN QUERY PLAN SELECT * FROM p;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN p")))
 ("EXPLAIN QUERY PLAN SELECT q FROM p WHERE r = 1;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN p")))
)
("explain.test:eqp-order-group-distinct"
 ("CREATE TABLE t(a, b, c);" :ok)
 ("CREATE INDEX ta ON t(a);" :ok)
