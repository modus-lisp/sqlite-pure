("fts5.test:fts5-basics"
 ("CREATE VIRTUAL TABLE ft USING fts5(a, b);" :ok)
 ("SELECT type, name, tbl_name, rootpage, sql FROM sqlite_master ORDER BY rowid;" :rows ("type" "name" "tbl_name" "rootpage" "sql")
  (("table" "ft" "ft" 0 "CREATE VIRTUAL TABLE ft USING fts5(a, b)")
   ("table" "ft_data" "ft_data" 2 "CREATE TABLE 'ft_data'(id INTEGER PRIMARY KEY, block BLOB)")
   ("table" "ft_idx" "ft_idx" 3 "CREATE TABLE 'ft_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID")
   ("table" "ft_content" "ft_content" 4 "CREATE TABLE 'ft_content'(id INTEGER PRIMARY KEY, c0, c1)")
   ("table" "ft_docsize" "ft_docsize" 5 "CREATE TABLE 'ft_docsize'(id INTEGER PRIMARY KEY, sz BLOB)")
   ("table" "ft_config" "ft_config" 6 "CREATE TABLE 'ft_config'(k PRIMARY KEY, v) WITHOUT ROWID")))
 ("SELECT id, hex(block) FROM ft_data ORDER BY id;" :rows ("id" "hex(block)")
  ((1 "")
   (10 "00000000000000")))
 ("SELECT * FROM ft_config;" :rows ("k" "v")
  (("version" 4)))
 ("INSERT INTO ft VALUES ('hello world', 'the quick brown fox');" :ok)
 ("INSERT INTO ft VALUES ('Hello again', 'lazy dog hello');" :ok)
 ("INSERT INTO ft(rowid, a, b) VALUES (10, 'third', 'row');" :ok)
 ("SELECT id, hex(block) FROM ft_data ORDER BY id;" :rows ("id" "hex(block)")
  ((1 "030508")
   (10 "000000000103030003010101020101030101")
   (137438953473 "00000044063062726F776E01060101040103666F780106010105010568656C6C6F0102020105717569636B0106010103010374686501060101020105776F726C64010203040C0A0A0C0A")
   (274877906945 "000000300630616761696E0202030103646F670206010103010568656C6C6F02080201010401046C617A790206010102040A0A0D")
   (412316860417 "000000180430726F770A06010102010574686972640A0202040A")))
 ("SELECT segid, hex(term), pgno FROM ft_idx;" :rows ("segid" "hex(term)" "pgno")
  ((1 "" 2)
   (2 "" 2)
   (3 "" 2)))
 ("SELECT id, hex(sz) FROM ft_docsize;" :rows ("id" "hex(sz)")
  ((1 "0204")
   (2 "0203")
   (10 "0101")))
 ("SELECT rowid, * FROM ft;" :rows ("rowid" "a" "b")
  ((1 "hello world" "the quick brown fox")
   (2 "Hello again" "lazy dog hello")
   (10 "third" "row")))
