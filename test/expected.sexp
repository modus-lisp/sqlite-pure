("explain.test:planner-paths-results"
 ("CREATE TABLE t(a, b TEXT, c INT, d COLLATE NOCASE);" :ok)
 ("CREATE INDEX tb ON t(b);" :ok)
 ("CREATE INDEX tc ON t(c DESC);" :ok)
 ("CREATE INDEX td ON t(d);" :ok)
 ("CREATE TABLE e(x);" :ok)
 ("CREATE INDEX ex ON e(x);" :ok)
 ("INSERT INTO t VALUES (1, '1', 1, 'a'), (2, '2', NULL, 'B'), (3, 'x', 3, 'b'), (4, NULL, 2, NULL), (5, '01', 5, 'A'), (6, '1.0', 1, 'c'), (7, 'X', -1, 'C');" :ok)
 ("INSERT INTO e VALUES (NULL), (NULL);" :ok)
 ("SELECT a FROM t WHERE rowid IN (3, 1, 3, '2', 2.0, 2.5, NULL, 99) ORDER BY a;" :rows ("a")
  ((1)
   (2)
   (3)))
 ("SELECT a FROM t WHERE a IN (SELECT c FROM t) ORDER BY a;" :rows ("a")
  ((1)
   (2)
   (3)
   (5)))
 ("SELECT a FROM t WHERE rowid IN (SELECT c FROM t WHERE c > 2);" :rows ("a")
  ((3)
   (5)))
 ("SELECT a FROM t WHERE b IN (1, '2', 'x', 1.0, NULL) ORDER BY a;" :rows ("a")
  ((1)
   (2)
   (3)
   (6)))
 ("SELECT a FROM t WHERE b IN ('X', 'x') ORDER BY a;" :rows ("a")
  ((3)
   (7)))
 ("SELECT a FROM t WHERE c IN ('1', 3, 3.0, '5', NULL) ORDER BY a;" :rows ("a")
  ((1)
   (3)
   (5)
   (6)))
 ("SELECT a FROM t WHERE d IN ('A', 'b') ORDER BY a;" :rows ("a")
  ((1)
   (2)
   (3)
   (5)))
 ("SELECT a FROM t WHERE d IN ('A' COLLATE BINARY) ORDER BY a;" :rows ("a")
  ((5)))
 ("SELECT a FROM t WHERE b IN (SELECT b FROM t WHERE a > 5) ORDER BY a;" :rows ("a")
  ((6)
   (7)))
 ("SELECT a FROM t WHERE c IN (SELECT a FROM t WHERE a < 4) ORDER BY a;" :rows ("a")
  ((1)
   (3)
   (4)
   (6)))
 ("SELECT a FROM t WHERE c NOT IN (1, 2) ORDER BY a;" :rows ("a")
  ((3)
   (5)
   (7)))
 ("SELECT a FROM t WHERE c IN () ORDER BY a;" :rows ("a")
  ())
 ("SELECT a, b FROM t WHERE b IN ('1', '01') AND c > 0 ORDER BY a;" :rows ("a" "b")
  ((1 "1")
   (5 "01")))
 ("SELECT max(c), min(c), count(*) FROM t;" :rows ("max(c)" "min(c)" "count(*)")
  ((5 -1 7)))
 ("SELECT max(c) FROM t;" :rows ("max(c)")
  ((5)))
 ("SELECT min(c) FROM t;" :rows ("min(c)")
  ((-1)))
 ("SELECT min(c), a FROM t;" :rows ("min(c)" "a")
  ((-1 7)))
 ("SELECT max(c), a FROM t;" :rows ("max(c)" "a")
  ((5 5)))
 ("SELECT max(b), a FROM t;" :rows ("max(b)" "a")
  (("x" 3)))
 ("SELECT min(b), a FROM t;" :rows ("min(b)" "a")
  (("01" 5)))
 ("SELECT min(d), max(d) FROM t;" :rows ("min(d)" "max(d)")
  (("a" "c")))
 ("SELECT min(d), a FROM t;" :rows ("min(d)" "a")
  (("a" 1)))
 ("SELECT max(d), a FROM t;" :rows ("max(d)" "a")
  (("C" 7)))
 ("SELECT max(rowid), min(rowid) FROM t;" :rows ("max(rowid)" "min(rowid)")
  ((7 1)))
 ("SELECT max(rowid), a FROM t;" :rows ("max(rowid)" "a")
  ((7 7)))
 ("SELECT min(rowid) + 1 FROM t;" :rows ("min(rowid) + 1")
  ((2)))
 ("SELECT max(x), min(x) FROM e;" :rows ("max(x)" "min(x)")
  ((:null :null)))
 ("SELECT min(x) FROM e;" :rows ("min(x)")
  ((:null)))
 ("SELECT max(x) FROM e;" :rows ("max(x)")
  ((:null)))
 ("SELECT max(x) FROM (SELECT 1 AS x) WHERE 0;" :rows ("max(x)")
  ((:null)))
 ("DELETE FROM e;" :ok)
 ("SELECT min(x), max(x) FROM e;" :rows ("min(x)" "max(x)")
  ((:null :null)))
 ("SELECT max(c) FROM t WHERE a > 3;" :rows ("max(c)")
  ((5)))
 ("SELECT a FROM t WHERE c = (SELECT max(c) FROM t);" :rows ("a")
  ((5)))
 ("SELECT a FROM t WHERE b = (SELECT b FROM t WHERE a = 3);" :rows ("a")
  ((3)))
 ("SELECT a FROM t WHERE c = (SELECT 42);" :rows ("a")
  ())
 ("SELECT a FROM t NOT INDEXED WHERE c = 3;" :rows ("a")
  ((3)))
 ("SELECT a FROM t INDEXED BY tc WHERE c = 3;" :rows ("a")
  ((3)))
 ("SELECT a FROM t INDEXED BY tc ORDER BY a;" :rows ("a")
  ((1)
   (2)
   (3)
   (4)
   (5)
   (6)
   (7)))
 ("SELECT a FROM t INDEXED BY nosuch;" :error "no such index: nosuch")
 ("EXPLAIN QUERY PLAN SELECT a FROM t INDEXED BY tc WHERE a = 3;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SCAN t USING INDEX tc")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t NOT INDEXED WHERE c = 3;" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SCAN t")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t WHERE rowid IN (1, 2);" :rows ("id" "parent" "notused" "detail")
  ((2 0 0 "SEARCH t USING INTEGER PRIMARY KEY (rowid=?)")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t WHERE c IN (1, 2);" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING INDEX tc (c=?)")))
 ("EXPLAIN QUERY PLAN SELECT max(c) FROM t;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING COVERING INDEX tc")))
 ("EXPLAIN QUERY PLAN SELECT min(d) FROM t;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING COVERING INDEX td")))
 ("EXPLAIN QUERY PLAN SELECT max(rowid) FROM t;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t")))
 ("EXPLAIN QUERY PLAN SELECT max(a) FROM t;" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t")))
 ("EXPLAIN QUERY PLAN SELECT a FROM t WHERE c = (SELECT max(c) FROM t);" :rows ("id" "parent" "notused" "detail")
  ((3 0 0 "SEARCH t USING INDEX tc (c=?)")
   (6 0 0 "SCALAR SUBQUERY 1")
   (11 6 0 "SEARCH t USING COVERING INDEX tc")))
 ("SELECT count(DISTINCT d), group_concat(DISTINCT d) FROM t;" :rows ("count(DISTINCT d)" "group_concat(DISTINCT d)")
  ((3 "a,B,c")))
 ("SELECT min(d COLLATE BINARY), max(d COLLATE BINARY) FROM t;" :rows ("min(d COLLATE BINARY)" "max(d COLLATE BINARY)")
  (("A" "c")))
 ("SELECT max(d) OVER (), min(d) OVER () FROM t LIMIT 1;" :rows ("max(d) OVER ()" "min(d) OVER ()")
  (("c" "a")))
 ("SELECT min(b COLLATE NOCASE), max(b COLLATE NOCASE) FROM t;" :rows ("min(b COLLATE NOCASE)" "max(b COLLATE NOCASE)")
  (("01" "X")))
)
("expr.test:arithmetic"
 ("SELECT 1 + 2, 7 - 10, 6 * 7, 7 / 2, -7 / 2, 7 % 3, -7 % 3, 7 % -3;" :rows ("1 + 2" "7 - 10" "6 * 7" "7 / 2" "-7 / 2" "7 % 3" "-7 % 3" "7 % -3")
  ((3 -3 42 3 -3 1 -1 1)))
 ("SELECT 7.0 / 2, 1 / 0, 1 % 0, 1.0 / 0, 5.5 % 2, 10 % 3.5;" :rows ("7.0 / 2" "1 / 0" "1 % 0" "1.0 / 0" "5.5 % 2" "10 % 3.5")
  (((:f "3.5") :null :null :null (:f "1.0") (:f "1.0"))))
 ("SELECT 9223372036854775807 + 1, -9223372036854775808 - 1, 9223372036854775807 * 2;" :rows ("9223372036854775807 + 1" "-9223372036854775808 - 1" "9223372036854775807 * 2")
  (((:f "9.223372036854776e+18") (:f "-9.223372036854776e+18") (:f "1.8446744073709552e+19"))))
 ("SELECT -9223372036854775808 / -1, -9223372036854775808 % -1;" :rows ("-9223372036854775808 / -1" "-9223372036854775808 % -1")
  (((:f "9.223372036854776e+18") 0)))
 ("SELECT '3abc' + 1, 'abc' * 2, ' 1.5e2x' + 0, '0x10' + 0, x'3132' + 1;" :rows ("'3abc' + 1" "'abc' * 2" "' 1.5e2x' + 0" "'0x10' + 0" "x'3132' + 1")
  ((4 0 (:f "150.0") 0 13)))
 ("SELECT 0.1 + 0.2, 1e308 * 10, -(-9223372036854775808);" :rows ("0.1 + 0.2" "1e308 * 10" "-(-9223372036854775808)")
  (((:f "0.30000000000000004") :inf (:f "9.223372036854776e+18"))))
 ("SELECT 2 + 3 * 4, (2 + 3) * 4, 10 - 2 - 3, 100 / 10 / 5, 2 || 3 + 1;" :rows ("2 + 3 * 4" "(2 + 3) * 4" "10 - 2 - 3" "100 / 10 / 5" "2 || 3 + 1")
  ((14 20 5 2 24)))
)
("expr.test:bitwise"
 ("SELECT 5 & 3, 5 | 3, ~5, 1 << 4, 256 >> 4, -1 >> 1, 1 << 63, 1 << 64, -8 >> 100, 3 << -1;" :rows ("5 & 3" "5 | 3" "~5" "1 << 4" "256 >> 4" "-1 >> 1" "1 << 63" "1 << 64" "-8 >> 100" "3 << -1")
  ((1 7 -6 16 16 -1 -9223372036854775808 0 -1 1)))
)
