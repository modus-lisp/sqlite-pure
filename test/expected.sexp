  (("x" 2 5)))
 ("SELECT * FROM vr WHERE term > 'x';" :rows ("term" "doc" "cnt")
  (("y" 1 2)
   ("z" 1 1)))
 ("SELECT * FROM vr ORDER BY cnt DESC, term;" :rows ("term" "doc" "cnt")
  (("x" 2 5)
   ("y" 1 2)
   ("q" 1 1)
   ("z" 1 1)))
