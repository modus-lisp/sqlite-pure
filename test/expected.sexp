("rtree.test:rtree-queries"
 ("CREATE VIRTUAL TABLE box USING rtree(id, minx, maxx, miny, maxy);" :ok)
 ("WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 3000)
  INSERT INTO box SELECT i, (i * 7919) % 1000, (i * 7919) % 1000 + (i % 17), (i * 104729) % 1000, (i * 104729) % 1000 + (i % 13) FROM n;" :ok)
 ("SELECT count(*), sum(minx), sum(maxy), min(miny), max(maxx) FROM box;" :rows ("count(*)" "sum(minx)" "sum(maxy)" "min(miny)" "max(maxx)")
  ((3000 (:f "1498500.0") (:f "1516495.0") (:f "0.0") (:f "1014.0"))))
 ("SELECT rtreecheck('box');" :rows ("rtreecheck('box')")
  (("ok")))
 ("SELECT count(*) FROM box_rowid;" :rows ("count(*)")
  ((3000)))
 ("SELECT id FROM box WHERE minx >= 100 AND maxx <= 120 AND miny >= 500 AND maxy <= 560 ORDER BY id;" :rows ("id")
  ())
 ("SELECT count(*), sum(id) FROM box WHERE maxx >= 400 AND minx <= 410;" :rows ("count(*)" "sum(id)")
  ((57 88743)))
 ("SELECT count(*), sum(id) FROM box WHERE minx > 990 OR maxy < 3;" :rows ("count(*)" "sum(id)")
  ((27 43335)))
 ("SELECT count(*) FROM box WHERE minx = 500;" :rows ("count(*)")
  ((3)))
 ("SELECT id, minx FROM box WHERE minx = 500.0 ORDER BY id;" :rows ("id" "minx")
  ((500 (:f "500.0"))
   (1500 (:f "500.0"))
   (2500 (:f "500.0"))))
 ("SELECT count(*) FROM box WHERE minx > '995';" :rows ("count(*)")
  ((12)))
 ("SELECT count(*) FROM box WHERE minx < 'abc';" :rows ("count(*)")
  ((3000)))
 ("SELECT count(*) FROM box WHERE minx > NULL;" :rows ("count(*)")
  ((0)))
