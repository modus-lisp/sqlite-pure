("dml.test:autoincrement"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY AUTOINCREMENT, v);" :ok)
 ("INSERT INTO t(v) VALUES ('a'), ('b'), ('c');" :ok)
 ("DELETE FROM t WHERE id = 3;" :ok)
 ("INSERT INTO t(v) VALUES ('d');" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v")
  ((1 "a")
   (2 "b")
   (4 "d")))
 ("SELECT name, seq FROM sqlite_sequence;" :rows ("name" "seq")
  (("t" 4)))
 ("INSERT INTO t VALUES (100, 'e');" :ok)
 ("INSERT INTO t(v) VALUES ('f');" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v")
  ((1 "a")
   (2 "b")
   (4 "d")
   (100 "e")
   (101 "f")))
 ("SELECT seq FROM sqlite_sequence WHERE name = 't';" :rows ("seq")
  ((101)))
)
("dml.test:rowid-reuse-without-autoincrement"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, v);" :ok)
 ("INSERT INTO t(v) VALUES ('a'), ('b'), ('c');" :ok)
 ("DELETE FROM t WHERE id = 3;" :ok)
 ("INSERT INTO t(v) VALUES ('d');" :ok)
 ("SELECT * FROM t ORDER BY id;" :rows ("id" "v")
  ((1 "a")
   (2 "b")
   (3 "d")))
)
("dml.test:upsert"
 ("CREATE TABLE kv(k TEXT PRIMARY KEY, v INTEGER, n INTEGER DEFAULT 0);" :ok)
 ("INSERT INTO kv(k, v) VALUES ('a', 1);" :ok)
 ("INSERT INTO kv(k, v) VALUES ('a', 5) ON CONFLICT(k) DO UPDATE SET v = excluded.v, n = n + 1;" :ok)
 ("INSERT INTO kv(k, v) VALUES ('b', 2) ON CONFLICT(k) DO UPDATE SET v = excluded.v;" :ok)
 ("INSERT INTO kv(k, v) VALUES ('b', 9) ON CONFLICT DO NOTHING;" :ok)
 ("SELECT * FROM kv ORDER BY k;" :rows ("k" "v" "n")
  (("a" 5 1)
   ("b" 2 0)))
 ("INSERT INTO kv(k, v) VALUES ('a', 0) ON CONFLICT(k) DO UPDATE SET v = v + 100 WHERE excluded.v > 0;" :ok)
 ("SELECT * FROM kv ORDER BY k;" :rows ("k" "v" "n")
  (("a" 5 1)
   ("b" 2 0)))
)
("dml.test:returning"
 ("CREATE TABLE t(id INTEGER PRIMARY KEY, v);" :ok)
 ("INSERT INTO t(v) VALUES ('a'), ('b') RETURNING id, v;" :rows ("id" "v")
  ((1 "a")
   (2 "b")))
 ("UPDATE t SET v = v || '!' WHERE id = 2 RETURNING *;" :rows ("id" "v")
  ((2 "b!")))
 ("DELETE FROM t WHERE id = 1 RETURNING v, id * 10 AS ten;" :rows ("v" "ten")
  (("a" 10)))
 ("SELECT * FROM t;" :rows ("id" "v")
  ((2 "b!")))
)
("dml.test:insert-column-mismatch"
 ("CREATE TABLE t(a, b);" :ok)
 ("INSERT INTO t VALUES (1);" :error "table t has 2 columns but 1 values were supplied")
 ("INSERT INTO t(a) VALUES (1, 2);" :error "2 values for 1 columns")
 ("INSERT INTO t(nosuch) VALUES (1);" :error "table t has no column named nosuch")
 ("SELECT count(*) FROM t;" :rows ("count(*)")
  ((0)))
)
("dml.test:transactions"
 ("CREATE TABLE t(a);" :ok)
 ("BEGIN;" :ok)
 ("INSERT INTO t VALUES (1);" :ok)
 ("INSERT INTO t VALUES (2);" :ok)
 ("ROLLBACK;" :ok)
 ("SELECT count(*) FROM t;" :rows ("count(*)")
  ((0)))
 ("BEGIN;" :ok)
 ("INSERT INTO t VALUES (3);" :ok)
 ("COMMIT;" :ok)
 ("SELECT a FROM t;" :rows ("a")
  ((3)))
 ("COMMIT;" :error "cannot commit - no transaction is active")
 ("BEGIN;" :ok)
 ("BEGIN;" :error "cannot start a transaction within a transaction")
 ("ROLLBACK;" :ok)
)
("dml.test:statement-atomicity-in-transaction"
 ("CREATE TABLE t(a UNIQUE);" :ok)
 ("BEGIN;" :ok)
 ("INSERT INTO t VALUES (1);" :ok)
 ("INSERT INTO t VALUES (2), (1);" :error "UNIQUE constraint failed: t.a")
 ("INSERT INTO t VALUES (3);" :ok)
 ("COMMIT;" :ok)
 ("SELECT a FROM t ORDER BY a;" :rows ("a")
  ((1)
   (3)))
)
("dml.test:update-with-index"
 ("CREATE TABLE t(a, b);" :ok)
 ("CREATE INDEX tb ON t(b);" :ok)
 ("INSERT INTO t VALUES (1, 'x'), (2, 'y'), (3, 'x');" :ok)
 ("UPDATE t SET b = 'z' WHERE b = 'x';" :ok)
 ("SELECT a FROM t WHERE b = 'z' ORDER BY a;" :rows ("a")
  ((1)
   (3)))
 ("SELECT a FROM t WHERE b = 'x';" :rows ("a")
  ())
 ("DELETE FROM t WHERE b = 'z';" :ok)
 ("SELECT a, b FROM t;" :rows ("a" "b")
  ((2 "y")))
)
