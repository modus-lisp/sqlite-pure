== rtree-returning
CREATE VIRTUAL TABLE rt USING rtree(id, a, b);
INSERT INTO rt(a, b) VALUES (0.1, 2) RETURNING *;
INSERT INTO rt VALUES ('5x', 1, 2) RETURNING id, rowid, a;
SELECT last_insert_rowid();
DELETE FROM rt WHERE id = 1 RETURNING *;
UPDATE rt SET a = 0 RETURNING *;
SELECT * FROM rt ORDER BY id;
