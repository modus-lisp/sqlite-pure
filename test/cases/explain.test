== eqp-access-paths
CREATE TABLE t(a, b, c);
CREATE INDEX ta ON t(a);
CREATE INDEX tab ON t(a, b);
CREATE TABLE u(id INTEGER PRIMARY KEY, x, y UNIQUE);
CREATE TABLE w(k PRIMARY KEY, v) WITHOUT ROWID;
CREATE TABLE p(q, r);
EXPLAIN QUERY PLAN SELECT * FROM t;
EXPLAIN QUERY PLAN SELECT * FROM t WHERE a = 1;
EXPLAIN QUERY PLAN SELECT a, b FROM t WHERE a = 1;
EXPLAIN QUERY PLAN SELECT * FROM t WHERE a = 1 AND b = 2;
EXPLAIN QUERY PLAN SELECT * FROM t WHERE b = 2 AND a = 7;
EXPLAIN QUERY PLAN SELECT * FROM u WHERE id = 5;
EXPLAIN QUERY PLAN SELECT * FROM u WHERE rowid = 5;
EXPLAIN QUERY PLAN SELECT * FROM u WHERE id > 5 AND id < 9;
EXPLAIN QUERY PLAN SELECT * FROM u WHERE id >= 5;
EXPLAIN QUERY PLAN SELECT * FROM u WHERE id <= 5;
EXPLAIN QUERY PLAN SELECT * FROM u WHERE y = 3;
EXPLAIN QUERY PLAN SELECT * FROM w WHERE k = 1;
EXPLAIN QUERY PLAN SELECT * FROM w;
EXPLAIN QUERY PLAN SELECT * FROM t AS x WHERE x.a = 1;
EXPLAIN QUERY PLAN SELECT * FROM t WHERE b = 3;
EXPLAIN QUERY PLAN SELECT * FROM t WHERE +a = 1;
EXPLAIN QUERY PLAN SELECT * FROM t WHERE c IN (1, 2, 3);
EXPLAIN QUERY PLAN SELECT * FROM t NOT INDEXED WHERE a = 1;
EXPLAIN QUERY PLAN SELECT * FROM p;
EXPLAIN QUERY PLAN SELECT q FROM p WHERE r = 1;

== eqp-order-group-distinct
CREATE TABLE t(a, b, c);
CREATE INDEX ta ON t(a);
CREATE TABLE u(id INTEGER PRIMARY KEY, x, y UNIQUE);
EXPLAIN QUERY PLAN SELECT * FROM t ORDER BY a;
EXPLAIN QUERY PLAN SELECT * FROM t ORDER BY a DESC;
EXPLAIN QUERY PLAN SELECT * FROM t ORDER BY c;
EXPLAIN QUERY PLAN SELECT a FROM t ORDER BY a;
EXPLAIN QUERY PLAN SELECT * FROM t ORDER BY a LIMIT 5;
EXPLAIN QUERY PLAN SELECT * FROM u ORDER BY id;
EXPLAIN QUERY PLAN SELECT * FROM u ORDER BY id DESC;
EXPLAIN QUERY PLAN SELECT * FROM u ORDER BY x;
EXPLAIN QUERY PLAN SELECT count(*) FROM t;
EXPLAIN QUERY PLAN SELECT count(*) FROM u;
EXPLAIN QUERY PLAN SELECT a, count(*) FROM t GROUP BY a;
EXPLAIN QUERY PLAN SELECT c, count(*) FROM t GROUP BY c;
EXPLAIN QUERY PLAN SELECT sum(a) FROM t GROUP BY c HAVING count(*) > 1 ORDER BY 1;
EXPLAIN QUERY PLAN SELECT DISTINCT c FROM t;
EXPLAIN QUERY PLAN SELECT DISTINCT a FROM t;
EXPLAIN QUERY PLAN SELECT DISTINCT c FROM t ORDER BY c;
EXPLAIN QUERY PLAN SELECT * FROM t WHERE a = 1 AND b > 2 ORDER BY b;
EXPLAIN QUERY PLAN SELECT sum(b) FROM t;

== eqp-joins-subqueries
CREATE TABLE t(a, b, c);
CREATE INDEX ta ON t(a);
CREATE TABLE u(id INTEGER PRIMARY KEY, x, y UNIQUE);
EXPLAIN QUERY PLAN SELECT * FROM t, u WHERE t.a = u.id;
EXPLAIN QUERY PLAN SELECT * FROM t LEFT JOIN u ON u.id = t.b;
EXPLAIN QUERY PLAN SELECT * FROM t CROSS JOIN u;
EXPLAIN QUERY PLAN SELECT * FROM u JOIN t ON t.a = u.x;
EXPLAIN QUERY PLAN SELECT 1;
EXPLAIN QUERY PLAN VALUES (1), (2), (3);
EXPLAIN QUERY PLAN VALUES (1);
EXPLAIN QUERY PLAN SELECT * FROM (SELECT a, count(*) FROM t GROUP BY a);
EXPLAIN QUERY PLAN SELECT count(*) FROM (SELECT a FROM t GROUP BY a);
EXPLAIN QUERY PLAN SELECT * FROM (SELECT x FROM u GROUP BY x) AS s, t WHERE s.x = t.a;
EXPLAIN QUERY PLAN SELECT * FROM (SELECT 1) JOIN (SELECT 2);
EXPLAIN QUERY PLAN WITH q(n) AS (SELECT 1) SELECT * FROM q, q AS q2;
EXPLAIN QUERY PLAN WITH q(n) AS (SELECT a FROM t GROUP BY a) SELECT * FROM q;
EXPLAIN QUERY PLAN WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 5) SELECT * FROM n;
EXPLAIN QUERY PLAN SELECT (SELECT max(x) FROM u), a FROM t;
EXPLAIN QUERY PLAN SELECT (SELECT x FROM u WHERE u.id = t.a) FROM t;
EXPLAIN QUERY PLAN SELECT * FROM t WHERE a IN (SELECT x FROM u);
EXPLAIN QUERY PLAN SELECT * FROM t WHERE EXISTS (SELECT 1 FROM u WHERE u.x = t.c);
EXPLAIN QUERY PLAN SELECT a FROM t WHERE a IN (SELECT id FROM u WHERE x = t.b);
EXPLAIN QUERY PLAN SELECT * FROM t WHERE b IN (SELECT x FROM u) AND c = (SELECT max(id) FROM u);
EXPLAIN QUERY PLAN SELECT (SELECT 1), (SELECT 2 FROM u), (SELECT (SELECT 3));
EXPLAIN QUERY PLAN SELECT * FROM t WHERE a = (SELECT 1) AND b IN (SELECT x FROM (SELECT x FROM u GROUP BY x));
EXPLAIN QUERY PLAN SELECT (SELECT max(x) FROM u) AS m, a FROM t ORDER BY c;
EXPLAIN QUERY PLAN SELECT c, (SELECT 1) FROM t GROUP BY c ORDER BY 2;
EXPLAIN QUERY PLAN SELECT DISTINCT c, (SELECT x FROM u WHERE id = t.a) FROM t ORDER BY b;

== eqp-compound-dml-misc
CREATE TABLE t(a, b, c);
CREATE INDEX ta ON t(a);
CREATE TABLE u(id INTEGER PRIMARY KEY, x, y UNIQUE);
CREATE VIRTUAL TABLE r USING rtree(id, x0, x1, y0, y1);
CREATE VIEW v AS SELECT a, count(*) AS n FROM t GROUP BY a;
EXPLAIN QUERY PLAN SELECT a FROM t UNION SELECT x FROM u;
EXPLAIN QUERY PLAN SELECT a FROM t UNION ALL SELECT x FROM u;
EXPLAIN QUERY PLAN SELECT a FROM t EXCEPT SELECT x FROM u;
EXPLAIN QUERY PLAN SELECT a FROM t INTERSECT SELECT x FROM u;
EXPLAIN QUERY PLAN SELECT * FROM r;
EXPLAIN QUERY PLAN SELECT * FROM r WHERE x0 > 1;
EXPLAIN QUERY PLAN SELECT * FROM r WHERE x0 > 1 AND y1 < 5 AND x1 = 3;
EXPLAIN QUERY PLAN SELECT * FROM r WHERE id = 3;
EXPLAIN QUERY PLAN SELECT * FROM json_each('[1]');
EXPLAIN QUERY PLAN SELECT * FROM json_each('[1]', '$');
EXPLAIN QUERY PLAN SELECT * FROM json_tree('[1]');
EXPLAIN QUERY PLAN SELECT * FROM t, json_each(t.c);
EXPLAIN QUERY PLAN SELECT * FROM pragma_table_info('t');
EXPLAIN QUERY PLAN SELECT * FROM v;
EXPLAIN QUERY PLAN DELETE FROM u WHERE id = 3;
EXPLAIN QUERY PLAN DELETE FROM t;
EXPLAIN QUERY PLAN UPDATE u SET x = 1 WHERE id > 10;
EXPLAIN QUERY PLAN INSERT INTO t VALUES (1, 2, 3);
EXPLAIN QUERY PLAN INSERT INTO t VALUES (1, 2, 3), (4, 5, 6);
EXPLAIN QUERY PLAN INSERT INTO t SELECT 1, 2, 3;
EXPLAIN QUERY PLAN INSERT INTO t SELECT * FROM t WHERE a = 1;
EXPLAIN QUERY PLAN CREATE TABLE z AS SELECT * FROM t;
EXPLAIN QUERY PLAN CREATE TABLE z2(a);
EXPLAIN QUERY PLAN PRAGMA table_info(t);
EXPLAIN QUERY PLAN BEGIN;
SELECT name FROM sqlite_master WHERE name LIKE 'z%';
EXPLAIN QUERY PLAN SELECT * FROM nosuch;

== planner-paths-results
CREATE TABLE t(a, b TEXT, c INT, d COLLATE NOCASE);
CREATE INDEX tb ON t(b);
CREATE INDEX tc ON t(c DESC);
CREATE INDEX td ON t(d);
CREATE TABLE e(x);
CREATE INDEX ex ON e(x);
INSERT INTO t VALUES (1, '1', 1, 'a'), (2, '2', NULL, 'B'), (3, 'x', 3, 'b'), (4, NULL, 2, NULL), (5, '01', 5, 'A'), (6, '1.0', 1, 'c'), (7, 'X', -1, 'C');
INSERT INTO e VALUES (NULL), (NULL);
SELECT a FROM t WHERE rowid IN (3, 1, 3, '2', 2.0, 2.5, NULL, 99) ORDER BY a;
SELECT a FROM t WHERE a IN (SELECT c FROM t) ORDER BY a;
SELECT a FROM t WHERE rowid IN (SELECT c FROM t WHERE c > 2);
SELECT a FROM t WHERE b IN (1, '2', 'x', 1.0, NULL) ORDER BY a;
SELECT a FROM t WHERE b IN ('X', 'x') ORDER BY a;
SELECT a FROM t WHERE c IN ('1', 3, 3.0, '5', NULL) ORDER BY a;
SELECT a FROM t WHERE d IN ('A', 'b') ORDER BY a;
SELECT a FROM t WHERE d IN ('A' COLLATE BINARY) ORDER BY a;
SELECT a FROM t WHERE b IN (SELECT b FROM t WHERE a > 5) ORDER BY a;
SELECT a FROM t WHERE c IN (SELECT a FROM t WHERE a < 4) ORDER BY a;
SELECT a FROM t WHERE c NOT IN (1, 2) ORDER BY a;
SELECT a FROM t WHERE c IN () ORDER BY a;
SELECT a, b FROM t WHERE b IN ('1', '01') AND c > 0 ORDER BY a;
SELECT max(c), min(c), count(*) FROM t;
SELECT max(c) FROM t;
SELECT min(c) FROM t;
SELECT min(c), a FROM t;
SELECT max(c), a FROM t;
SELECT max(b), a FROM t;
SELECT min(b), a FROM t;
SELECT min(d), max(d) FROM t;
SELECT min(d), a FROM t;
SELECT max(d), a FROM t;
SELECT max(rowid), min(rowid) FROM t;
SELECT max(rowid), a FROM t;
SELECT min(rowid) + 1 FROM t;
SELECT max(x), min(x) FROM e;
SELECT min(x) FROM e;
SELECT max(x) FROM e;
SELECT max(x) FROM (SELECT 1 AS x) WHERE 0;
DELETE FROM e;
SELECT min(x), max(x) FROM e;
SELECT max(c) FROM t WHERE a > 3;
SELECT a FROM t WHERE c = (SELECT max(c) FROM t);
SELECT a FROM t WHERE b = (SELECT b FROM t WHERE a = 3);
SELECT a FROM t WHERE c = (SELECT 42);
SELECT a FROM t NOT INDEXED WHERE c = 3;
SELECT a FROM t INDEXED BY tc WHERE c = 3;
SELECT a FROM t INDEXED BY tc ORDER BY a;
SELECT a FROM t INDEXED BY nosuch;
EXPLAIN QUERY PLAN SELECT a FROM t INDEXED BY tc WHERE a = 3;
EXPLAIN QUERY PLAN SELECT a FROM t NOT INDEXED WHERE c = 3;
EXPLAIN QUERY PLAN SELECT a FROM t WHERE rowid IN (1, 2);
EXPLAIN QUERY PLAN SELECT a FROM t WHERE c IN (1, 2);
EXPLAIN QUERY PLAN SELECT max(c) FROM t;
EXPLAIN QUERY PLAN SELECT min(d) FROM t;
EXPLAIN QUERY PLAN SELECT max(rowid) FROM t;
EXPLAIN QUERY PLAN SELECT max(a) FROM t;
EXPLAIN QUERY PLAN SELECT a FROM t WHERE c = (SELECT max(c) FROM t);
SELECT count(DISTINCT d), group_concat(DISTINCT d) FROM t;
SELECT min(d COLLATE BINARY), max(d COLLATE BINARY) FROM t;
SELECT max(d) OVER (), min(d) OVER () FROM t LIMIT 1;
SELECT min(b COLLATE NOCASE), max(b COLLATE NOCASE) FROM t;
