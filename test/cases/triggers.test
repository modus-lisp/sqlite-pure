== trigger-order-and-new
CREATE TABLE t(a);
CREATE TABLE log(m);
CREATE TRIGGER t1 AFTER INSERT ON t BEGIN INSERT INTO log VALUES ('t1 ' || new.a); END;
CREATE TRIGGER t2 AFTER INSERT ON t BEGIN INSERT INTO log VALUES ('t2 ' || new.a); END;
CREATE TRIGGER t0 BEFORE INSERT ON t BEGIN INSERT INTO log VALUES ('b ' || new.a || ' ' || new.rowid); END;
INSERT INTO t VALUES (1), (2);
SELECT m FROM log ORDER BY rowid;

== trigger-update-delete
CREATE TABLE log(m);
CREATE TABLE u(x INTEGER PRIMARY KEY, y);
CREATE TRIGGER ub BEFORE UPDATE OF y ON u BEGIN INSERT INTO log VALUES ('ub ' || old.y || '->' || new.y); END;
CREATE TRIGGER ud AFTER DELETE ON u WHEN old.x > 1 BEGIN INSERT INTO log VALUES ('ud ' || old.x); END;
INSERT INTO u VALUES (1, 'a'), (2, 'b');
UPDATE u SET y = 'c';
UPDATE u SET x = x + 10 WHERE x = 1;
DELETE FROM u;
SELECT m FROM log ORDER BY rowid;

== trigger-raise
CREATE TABLE t(a);
CREATE TRIGGER ri BEFORE INSERT ON t WHEN new.a < 0 BEGIN SELECT RAISE(ABORT, 'negative!'); END;
CREATE TRIGGER rg BEFORE INSERT ON t WHEN new.a = 0 BEGIN SELECT RAISE(IGNORE); END;
INSERT INTO t VALUES (1);
INSERT INTO t VALUES (2), (-1), (3);
INSERT INTO t VALUES (0), (4);
SELECT a FROM t ORDER BY a;
SELECT RAISE(IGNORE);

== trigger-maintains-summary
CREATE TABLE item(id INTEGER PRIMARY KEY, cat TEXT, price REAL);
CREATE TABLE total(cat TEXT PRIMARY KEY, n INTEGER, sum REAL);
CREATE TRIGGER ins AFTER INSERT ON item BEGIN
  INSERT INTO total VALUES (new.cat, 0, 0) ON CONFLICT(cat) DO NOTHING;
  UPDATE total SET n = n + 1, sum = sum + new.price WHERE cat = new.cat;
END;
CREATE TRIGGER del AFTER DELETE ON item BEGIN
  UPDATE total SET n = n - 1, sum = sum - old.price WHERE cat = old.cat;
  DELETE FROM total WHERE cat = old.cat AND n = 0;
END;
INSERT INTO item(cat, price) VALUES ('a', 1.5), ('b', 2), ('a', 3), ('c', 10);
DELETE FROM item WHERE cat = 'c' OR price = 1.5;
SELECT * FROM total ORDER BY cat;

== instead-of-view
CREATE TABLE t(a);
CREATE VIEW v AS SELECT a FROM t;
CREATE TRIGGER vi INSTEAD OF INSERT ON v BEGIN INSERT INTO t VALUES (new.a * 100); END;
CREATE TRIGGER vd INSTEAD OF DELETE ON v BEGIN DELETE FROM t WHERE a = old.a; END;
CREATE TRIGGER vu INSTEAD OF UPDATE ON v BEGIN UPDATE t SET a = new.a WHERE a = old.a; END;
INSERT INTO v VALUES (7), (8);
UPDATE v SET a = a + 1 WHERE a = 700;
DELETE FROM v WHERE a = 800;
SELECT a FROM t ORDER BY a;
SELECT name, tbl_name FROM sqlite_schema WHERE type = 'trigger' ORDER BY name;
DROP TRIGGER vi;
INSERT INTO v VALUES (9);
DROP VIEW v;
SELECT count(*) FROM sqlite_schema WHERE type = 'trigger';

== partial-and-expression-index
CREATE TABLE t(a, b);
CREATE INDEX tp ON t(a) WHERE b > 0;
CREATE INDEX te ON t(lower(b), a + 1);
CREATE UNIQUE INDEX tu ON t(a) WHERE b = 'uniq';
INSERT INTO t VALUES (1, 5), (2, -1), (3, 'X'), (4, 'uniq');
INSERT INTO t VALUES (4, 'uniq');
INSERT INTO t VALUES (4, 'other');
UPDATE t SET b = 'Y' WHERE a = 3;
DELETE FROM t WHERE a = 1;
SELECT * FROM t ORDER BY rowid;
PRAGMA integrity_check;
