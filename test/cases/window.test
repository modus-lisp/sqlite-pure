== ranking
CREATE TABLE s(name, dept, pay);
INSERT INTO s VALUES ('a','x',10),('b','x',20),('c','x',20),('d','y',5),('e','y',7),('f','y',7),('g','z',1);
SELECT name, row_number() OVER (ORDER BY pay DESC, name) FROM s ORDER BY name;
SELECT name, rank() OVER (ORDER BY pay), dense_rank() OVER (ORDER BY pay) FROM s ORDER BY name;
SELECT name, rank() OVER (PARTITION BY dept ORDER BY pay DESC) AS r FROM s ORDER BY dept, r, name;
SELECT name, percent_rank() OVER (ORDER BY pay), cume_dist() OVER (ORDER BY pay) FROM s ORDER BY name;
SELECT name, ntile(3) OVER (ORDER BY name) FROM s ORDER BY name;
SELECT name, ntile(10) OVER (ORDER BY name) FROM s ORDER BY name;
SELECT dept, row_number() OVER (PARTITION BY dept) FROM s ORDER BY dept, 2;

== aggregates-over
CREATE TABLE t(g, v);
INSERT INTO t VALUES (1,1),(1,2),(1,3),(2,10),(2,20),(3,NULL);
SELECT g, v, sum(v) OVER (PARTITION BY g) FROM t ORDER BY g, v;
SELECT g, v, sum(v) OVER (ORDER BY g, v) FROM t ORDER BY g, v;
SELECT g, v, sum(v) OVER (ORDER BY g) FROM t ORDER BY g, v;
SELECT g, v, count(*) OVER (), count(v) OVER (PARTITION BY g) FROM t ORDER BY g, v;
SELECT g, v, avg(v) OVER (PARTITION BY g ORDER BY v ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) FROM t ORDER BY g, v;
SELECT v, sum(v) OVER (ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM t ORDER BY v;
SELECT v, max(v) OVER (ORDER BY v ROWS 2 PRECEDING), min(v) OVER (ORDER BY v ROWS BETWEEN CURRENT ROW AND 1 FOLLOWING) FROM t ORDER BY v;
SELECT v, group_concat(v, '-') OVER (ORDER BY v) FROM t ORDER BY v;
SELECT v, sum(v) OVER (ORDER BY v RANGE BETWEEN 5 PRECEDING AND 5 FOLLOWING) FROM t ORDER BY v;
SELECT v, count(*) OVER (ORDER BY g GROUPS BETWEEN 1 PRECEDING AND CURRENT ROW) FROM t ORDER BY g, v;

== value-functions
CREATE TABLE t(x);
INSERT INTO t VALUES (5),(3),(8),(1),(9);
SELECT x, lag(x) OVER (ORDER BY x), lead(x) OVER (ORDER BY x), lag(x, 2, -1) OVER (ORDER BY x), lead(x, 3) OVER (ORDER BY x) FROM t ORDER BY x;
SELECT x, first_value(x) OVER (ORDER BY x), last_value(x) OVER (ORDER BY x), nth_value(x, 2) OVER (ORDER BY x) FROM t ORDER BY x;
SELECT x, last_value(x) OVER (ORDER BY x ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) FROM t ORDER BY x;

== named-window-and-grouping
CREATE TABLE t(g, v);
INSERT INTO t VALUES ('a',1),('a',2),('b',3),('b',4),('b',5);
SELECT g, v, sum(v) OVER w, row_number() OVER w FROM t WINDOW w AS (PARTITION BY g ORDER BY v) ORDER BY g, v;
SELECT g, sum(v), sum(sum(v)) OVER (), rank() OVER (ORDER BY sum(v) DESC) FROM t GROUP BY g ORDER BY g;
SELECT g, v FROM (SELECT g, v, row_number() OVER (PARTITION BY g ORDER BY v DESC) AS rn FROM t) WHERE rn = 1 ORDER BY g;
SELECT v, sum(v) OVER (ORDER BY v) AS run FROM t ORDER BY run DESC LIMIT 2;
SELECT DISTINCT g, count(*) OVER (PARTITION BY g) FROM t ORDER BY g;
SELECT v FROM t WHERE row_number() OVER () > 1;
SELECT abs(v) OVER () FROM t;
