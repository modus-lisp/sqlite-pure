== fts5-basics
CREATE VIRTUAL TABLE ft USING fts5(a, b);
SELECT type, name, tbl_name, rootpage, sql FROM sqlite_master ORDER BY rowid;
SELECT id, hex(block) FROM ft_data ORDER BY id;
SELECT * FROM ft_config;
INSERT INTO ft VALUES ('hello world', 'the quick brown fox');
INSERT INTO ft VALUES ('Hello again', 'lazy dog hello');
INSERT INTO ft(rowid, a, b) VALUES (10, 'third', 'row');
SELECT id, hex(block) FROM ft_data ORDER BY id;
SELECT segid, hex(term), pgno FROM ft_idx;
SELECT id, hex(sz) FROM ft_docsize;
SELECT rowid, * FROM ft;
SELECT rowid, * FROM ft WHERE ft MATCH 'hello';
SELECT rowid FROM ft WHERE ft MATCH 'HELLO';
SELECT rowid FROM ft WHERE ft = 'hello';
SELECT rowid FROM ft WHERE a MATCH 'hello';
SELECT rowid FROM ft WHERE b MATCH 'hello';
SELECT rowid FROM ft('hello');
SELECT rowid FROM ft WHERE ft MATCH 'hello' AND rowid > 1;
SELECT rowid FROM ft WHERE rowid = 2;
DELETE FROM ft WHERE rowid = 1;
SELECT id, hex(block) FROM ft_data ORDER BY id;
UPDATE ft SET a = 'goodbye world' WHERE rowid = 2;
SELECT rowid, * FROM ft ORDER BY rowid;
SELECT rowid FROM ft WHERE ft MATCH 'world';
INSERT INTO ft(ft) VALUES ('integrity-check');
INSERT INTO ft(ft) VALUES ('optimize');
SELECT id, hex(block) FROM ft_data ORDER BY id;
SELECT rowid FROM ft WHERE ft MATCH 'row OR goodbye';
PRAGMA table_info(ft);
PRAGMA table_xinfo(ft);
SELECT count(*) FROM ft;

== fts5-queries
CREATE VIRTUAL TABLE t USING fts5(title, body);
INSERT INTO t VALUES ('SQLite Tutorial', 'SQLite is a small fast reliable database engine');
INSERT INTO t VALUES ('Full-text search', 'the fts5 module provides full text search over documents');
INSERT INTO t VALUES ('Database design', 'normal forms and indexes make a database fast');
INSERT INTO t VALUES ('Search engines', 'a search engine ranks documents by relevance');
INSERT INTO t VALUES ('Fast food', 'not about databases at all but quick meals');
INSERT INTO t VALUES ('Engine room', 'the engine of a ship; the fast engine');
SELECT rowid FROM t WHERE t MATCH 'database';
SELECT rowid FROM t WHERE t MATCH 'fast AND database';
SELECT rowid FROM t WHERE t MATCH 'fast database';
SELECT rowid FROM t WHERE t MATCH 'fast OR search';
SELECT rowid FROM t WHERE t MATCH 'fast NOT database';
SELECT rowid FROM t WHERE t MATCH 'fast OR search NOT engine';
SELECT rowid FROM t WHERE t MATCH '(fast OR search) NOT engine';
SELECT rowid FROM t WHERE t MATCH 'fast AND search OR engine';
SELECT rowid FROM t WHERE t MATCH 'fast AND (search OR engine)';
SELECT rowid FROM t WHERE t MATCH '"full text"';
SELECT rowid FROM t WHERE t MATCH '"text full"';
SELECT rowid FROM t WHERE t MATCH 'full + text';
SELECT rowid FROM t WHERE t MATCH '"the engine"';
SELECT rowid FROM t WHERE t MATCH 'data*';
SELECT rowid FROM t WHERE t MATCH 'eng*';
SELECT rowid FROM t WHERE t MATCH '"fast eng*"';
SELECT rowid FROM t WHERE t MATCH 'title:search';
SELECT rowid FROM t WHERE t MATCH 'body:search';
SELECT rowid FROM t WHERE t MATCH '{title body}:fast';
SELECT rowid FROM t WHERE t MATCH '- title:fast';
SELECT rowid FROM t WHERE t MATCH '-{body}:engine';
SELECT rowid FROM t WHERE t MATCH 'title:(fast OR search)';
SELECT rowid FROM t WHERE t MATCH 'title:fast OR body:quick';
SELECT rowid FROM t WHERE t MATCH '^fast';
SELECT rowid FROM t WHERE t MATCH '^engine';
SELECT rowid FROM t WHERE t MATCH 'body:^the';
SELECT rowid FROM t WHERE t MATCH 'NEAR(fast engine)';
SELECT rowid FROM t WHERE t MATCH 'NEAR(fast engine, 0)';
SELECT rowid FROM t WHERE t MATCH 'NEAR(the engine, 1)';
SELECT rowid FROM t WHERE t MATCH 'NEAR(search documents, 2)';
SELECT rowid FROM t WHERE t MATCH 'NEAR(search documents, 3)';
SELECT rowid FROM t WHERE t MATCH 'NEAR("full text" documents, 3)';
SELECT rowid FROM t WHERE t MATCH 'and';
SELECT rowid FROM t WHERE t MATCH 'nosuchword';
SELECT rowid FROM t WHERE t MATCH '"."';
SELECT rowid FROM t WHERE t MATCH '"." OR fast';
SELECT rowid FROM t WHERE t MATCH '"." AND fast';
SELECT rowid FROM t WHERE t MATCH 'fast "."';
SELECT rowid FROM t WHERE title MATCH 'fast OR engine';
SELECT rowid FROM t WHERE t MATCH 'fast' AND t MATCH 'engine';
SELECT rowid FROM t WHERE t MATCH 'fast' AND title MATCH 'engine';
SELECT rowid FROM t WHERE t MATCH 'a AND';
SELECT rowid FROM t WHERE t MATCH '';
SELECT rowid FROM t WHERE t MATCH NULL;
SELECT rowid FROM t WHERE t MATCH '(fast';
SELECT rowid FROM t WHERE t MATCH 'fast)';
SELECT rowid FROM t WHERE t MATCH 'nosuch:fast';
SELECT rowid FROM t WHERE t MATCH '"unterminated';
SELECT rowid FROM t WHERE t MATCH 'fast #';
SELECT rowid FROM t WHERE t MATCH 'NEAR(fast engine, x)';
SELECT rowid FROM t WHERE t MATCH 'NEAR fast';
SELECT rowid FROM t WHERE t MATCH 'near(fast engine)';
SELECT rowid FROM t WHERE t MATCH '(fast) engine';
SELECT rowid FROM t WHERE t MATCH 'fast (engine)';
SELECT rowid FROM t WHERE t MATCH '*';
SELECT rowid FROM t WHERE t MATCH 'fast OR';
SELECT rowid FROM t WHERE t MATCH 'NOT fast';
SELECT rowid FROM t WHERE t MATCH 'Fast';
SELECT rowid FROM t WHERE t MATCH 'fast' ORDER BY rowid DESC;
SELECT rowid FROM t WHERE t MATCH 'fast' LIMIT 1;

== fts5-ranking
CREATE VIRTUAL TABLE t USING fts5(title, body);
INSERT INTO t VALUES ('SQLite Tutorial', 'SQLite is a small fast reliable database engine');
INSERT INTO t VALUES ('Full-text search', 'the fts5 module provides full text search over documents');
INSERT INTO t VALUES ('Database design', 'normal forms and indexes make a database fast');
INSERT INTO t VALUES ('Search engines', 'a search engine ranks documents by relevance');
INSERT INTO t VALUES ('Fast food', 'not about databases at all but quick meals');
INSERT INTO t VALUES ('Engine room', 'the engine of a ship; the fast engine');
SELECT rowid, bm25(t) FROM t WHERE t MATCH 'fast';
SELECT rowid, rank FROM t WHERE t MATCH 'fast' ORDER BY rank;
SELECT rowid FROM t WHERE t MATCH 'engine' ORDER BY rank;
SELECT rowid, bm25(t, 10.0, 1.0) FROM t WHERE t MATCH 'fast OR search';
SELECT rowid, bm25(t, 0, 5) FROM t WHERE t MATCH 'engine';
SELECT rowid, bm25(t) FROM t WHERE t MATCH '"full text" OR database';
SELECT rowid, bm25(t) FROM t WHERE t MATCH 'NEAR(fast engine)';
SELECT rowid, bm25(t) FROM t WHERE t MATCH 'title:fast';
SELECT rowid, rank FROM t WHERE t MATCH 'fast' AND rank MATCH 'bm25(10.0, 5.0)' ORDER BY rank;
INSERT INTO t(t, rank) VALUES ('rank', 'bm25(1.0, 20.0)');
SELECT rowid, rank FROM t WHERE t MATCH 'fast' ORDER BY rank;
SELECT * FROM t_config;
SELECT rowid, rank FROM t('fast', 'bm25(2.0)') ORDER BY rank;
SELECT rowid, rank FROM t('fast', 'x');
SELECT rank FROM t;
SELECT bm25(t) FROM t WHERE rowid = 1;
SELECT bm25(title) FROM t WHERE t MATCH 'fast';

== fts5-highlight-snippet
CREATE VIRTUAL TABLE t USING fts5(title, body);
INSERT INTO t VALUES ('SQLite Tutorial', 'SQLite is a small fast reliable database engine. It is fast. Very fast indeed: really.');
INSERT INTO t VALUES ('Full-text search', 'The fts5 module provides full text search over documents. Search is fun.');
INSERT INTO t VALUES ('Engine room', 'the engine of a ship; the fast engine, the loud engine');
INSERT INTO t VALUES ('Unicode Café', 'Ünïcödé text: naïve café, résumé.  CAFÉ society.');
INSERT INTO t VALUES (NULL, 'engine without a title');
SELECT rowid, highlight(t, 0, '[', ']'), highlight(t, 1, '<b>', '</b>') FROM t WHERE t MATCH 'fast OR engine OR search';
SELECT highlight(t, 1, '[', ']') FROM t WHERE t MATCH '"fast engine"';
SELECT highlight(t, 1, '[', ']') FROM t WHERE t MATCH 'the engine';
SELECT highlight(t, 1, '[', ']') FROM t WHERE t MATCH '"the engine" engine';
SELECT highlight(t, 1, '[', ']') FROM t WHERE t MATCH 'NEAR(fast engine, 1)';
SELECT highlight(t, 1, '(', ')') FROM t WHERE t MATCH 'cafe';
SELECT highlight(t, 0, '(', ')') FROM t WHERE t MATCH 'cafe';
SELECT highlight(t, 1, NULL, NULL) FROM t WHERE t MATCH 'search';
SELECT highlight(t, 0, '[', ']') FROM t WHERE t MATCH 'engine';
SELECT highlight(t, 1, '[', ']') FROM t WHERE t MATCH 'sea*';
SELECT highlight(t, 1, '[', ']') FROM t;
SELECT snippet(t, 1, '[', ']', '...', 5) FROM t WHERE t MATCH 'fast';
SELECT snippet(t, 1, '[', ']', '...', 3) FROM t WHERE t MATCH 'engine';
SELECT snippet(t, -1, '[', ']', '...', 4) FROM t WHERE t MATCH 'search';
SELECT snippet(t, -1, '[', ']', '...', 10) FROM t WHERE t MATCH 'fast OR engine';
SELECT snippet(t, 1, '[', ']', '', 2) FROM t WHERE t MATCH 'really';
SELECT snippet(t, 1, '<', '>', '…', 6) FROM t WHERE t MATCH 'fun';
SELECT snippet(t, 0, '[', ']', '...', 1) FROM t WHERE t MATCH 'tutorial';
SELECT snippet(t, 1, '[', ']', '...', 64) FROM t WHERE t MATCH 'text';
SELECT highlight(t, 1, '[', ']', 'x') FROM t WHERE t MATCH 'fast';
SELECT snippet(t, 1) FROM t WHERE t MATCH 'fast';

== fts5-options
CREATE VIRTUAL TABLE p USING fts5(a, b UNINDEXED, prefix='2 3', tokenize='porter');
INSERT INTO p VALUES ('running runners run', 'unindexed words');
INSERT INTO p VALUES ('the relational connections', 'more words');
SELECT id, hex(block) FROM p_data ORDER BY id;
SELECT rowid FROM p WHERE p MATCH 'run';
SELECT rowid FROM p WHERE p MATCH 'runner';
SELECT rowid FROM p WHERE p MATCH 'relate';
SELECT rowid FROM p WHERE p MATCH 'unindexed';
SELECT rowid FROM p WHERE p MATCH 'b:words';
SELECT rowid FROM p WHERE p MATCH 'ru*';
SELECT rowid FROM p WHERE p MATCH 'rel*';
SELECT rowid FROM p WHERE p MATCH 'r*';
SELECT rowid, b FROM p WHERE p MATCH 'connect';
CREATE VIRTUAL TABLE tri USING fts5(x, tokenize='trigram');
INSERT INTO tri VALUES ('The Quick Brown fox');
INSERT INTO tri VALUES ('quicksand');
SELECT rowid FROM tri WHERE tri MATCH 'uic';
SELECT rowid FROM tri WHERE tri MATCH 'QUICK';
SELECT rowid FROM tri WHERE tri MATCH 'ck b';
SELECT rowid FROM tri WHERE tri MATCH 'qu';
SELECT highlight(tri, 0, '[', ']') FROM tri WHERE tri MATCH 'uick';
CREATE VIRTUAL TABLE asc USING fts5(x, tokenize="ascii separators '.' tokenchars '-'");
INSERT INTO asc VALUES ('a-b.c d_e Füß');
SELECT rowid FROM asc WHERE asc MATCH '"a-b"';
SELECT rowid FROM asc WHERE asc MATCH 'c';
SELECT rowid FROM asc WHERE asc MATCH 'füß';
SELECT rowid FROM asc WHERE asc MATCH 'FÜSS';
CREATE VIRTUAL TABLE ud USING fts5(x, tokenize='unicode61 remove_diacritics 0');
INSERT INTO ud VALUES ('café resume résumé');
SELECT rowid FROM ud WHERE ud MATCH 'cafe';
SELECT rowid FROM ud WHERE ud MATCH 'café';
SELECT rowid FROM ud WHERE ud MATCH 'RÉSUMÉ';
CREATE VIRTUAL TABLE bad USING fts5(a, nosuch=1);
CREATE VIRTUAL TABLE bad USING fts5(a, b nosuch);
CREATE VIRTUAL TABLE bad USING fts5(rank);
CREATE VIRTUAL TABLE bad USING fts5(rowid);
CREATE VIRTUAL TABLE bad USING fts5(a, detail=x);
CREATE VIRTUAL TABLE bad USING fts5(a, tokenize='nosuch');
CREATE VIRTUAL TABLE bad USING fts5(a, prefix='0');
CREATE VIRTUAL TABLE bad USING fts5(a, prefix='x');
CREATE VIRTUAL TABLE bad USING fts5(a, columnsize=2);
SELECT name FROM sqlite_master WHERE name LIKE 'bad%';

== fts5-detail-modes
CREATE VIRTUAL TABLE dn USING fts5(a, b, detail=none);
CREATE VIRTUAL TABLE dc USING fts5(a, b, detail=column);
INSERT INTO dn VALUES ('x y x', 'y z');
INSERT INTO dn VALUES ('z', 'x');
INSERT INTO dc VALUES ('x y x', 'y z');
INSERT INTO dc VALUES ('z', 'x');
DELETE FROM dn WHERE rowid = 1;
DELETE FROM dc WHERE rowid = 1;
SELECT id, hex(block) FROM dn_data ORDER BY id;
SELECT id, hex(block) FROM dc_data ORDER BY id;
INSERT INTO dn VALUES ('x y x', 'y z');
INSERT INTO dc VALUES ('x y x', 'y z');
SELECT rowid FROM dn WHERE dn MATCH 'x';
SELECT rowid FROM dc WHERE dc MATCH 'x';
SELECT rowid FROM dc WHERE dc MATCH 'b:x';
SELECT rowid FROM dn WHERE dn MATCH 'b:x';
SELECT rowid FROM dc WHERE dc MATCH '"x y"';
SELECT rowid FROM dc WHERE dc MATCH 'NEAR(x y)';
SELECT rowid FROM dn WHERE dn MATCH 'x y';
SELECT rowid, bm25(dc) FROM dc WHERE dc MATCH 'x';
SELECT rowid, bm25(dn) FROM dn WHERE dn MATCH 'x OR z';
INSERT INTO dn(dn) VALUES ('optimize');
INSERT INTO dc(dc) VALUES ('optimize');
SELECT id, hex(block) FROM dn_data ORDER BY id;
SELECT id, hex(block) FROM dc_data ORDER BY id;
INSERT INTO dn(dn) VALUES ('integrity-check');
INSERT INTO dc(dc) VALUES ('integrity-check');

== fts5-content-modes
CREATE VIRTUAL TABLE cl USING fts5(a, content='');
INSERT INTO cl VALUES ('abc def');
INSERT INTO cl(rowid, a) VALUES (7, 'def ghi');
SELECT *, rowid FROM cl;
SELECT *, rowid FROM cl WHERE cl MATCH 'def';
DELETE FROM cl WHERE rowid = 1;
UPDATE cl SET a = 'x';
INSERT INTO cl(cl, rowid, a) VALUES ('delete', 1, 'abc def');
SELECT rowid FROM cl WHERE cl MATCH 'def';
SELECT sql FROM sqlite_master WHERE name LIKE 'cl%';
INSERT INTO cl(cl) VALUES ('rebuild');
INSERT INTO cl(cl) VALUES ('delete-all');
SELECT rowid FROM cl WHERE cl MATCH 'def';
CREATE TABLE src(id INTEGER PRIMARY KEY, t, u);
INSERT INTO src VALUES (7, 'external text', 'more'), (9, 'other text', 'stuff');
CREATE VIRTUAL TABLE ex USING fts5(t, u, content='src', content_rowid='id');
INSERT INTO ex(ex) VALUES ('rebuild');
SELECT *, rowid FROM ex WHERE ex MATCH 'text';
SELECT * FROM ex;
SELECT highlight(ex, 0, '[', ']') FROM ex WHERE ex MATCH 'other';
INSERT INTO ex(ex, rowid, t, u) VALUES ('delete', 7, 'external text', 'more');
SELECT rowid FROM ex WHERE ex MATCH 'text';
INSERT INTO ex(ex) VALUES ('integrity-check');
DELETE FROM ex WHERE rowid = 9;
SELECT rowid FROM ex WHERE ex MATCH 'text';
CREATE VIRTUAL TABLE ft USING fts5(a);
INSERT INTO ft(ft) VALUES ('delete-all');
INSERT INTO ft(ft, rowid, a) VALUES ('delete', 1, 'x');
INSERT INTO ft(ft) VALUES ('nonsense');
INSERT INTO ft(ft, rank) VALUES ('automerge', 8);
INSERT INTO ft(ft, rank) VALUES ('automerge', 'x');
INSERT INTO ft(ft, rank) VALUES ('pgsz', 10);
INSERT INTO ft(ft, rank) VALUES ('crisismerge', 1);
INSERT INTO ft(ft, rank) VALUES ('usermerge', 3);
SELECT * FROM ft_config;
SELECT id, hex(block) FROM ft_data WHERE id = 10;
INSERT INTO ft VALUES ('dup');
INSERT INTO ft(rowid, a) VALUES (1, 'dup');
INSERT OR REPLACE INTO ft(rowid, a) VALUES (1, 'replaced');
INSERT OR IGNORE INTO ft(rowid, a) VALUES (1, 'ignored');
SELECT rowid, a FROM ft;
SELECT rowid FROM ft WHERE ft MATCH 'dup';
SELECT rowid FROM ft WHERE ft MATCH 'replaced';

== fts5-ddl
CREATE VIRTUAL TABLE ft USING fts5(a, b);
INSERT INTO ft VALUES ('one two', 'three');
ALTER TABLE ft RENAME TO f2;
SELECT type, name, tbl_name, sql FROM sqlite_master ORDER BY rowid;
SELECT rowid FROM f2 WHERE f2 MATCH 'two';
CREATE INDEX i ON f2(a);
CREATE TRIGGER tr AFTER INSERT ON f2 BEGIN SELECT 1; END;
ALTER TABLE f2 ADD COLUMN c;
PRAGMA table_list;
DROP TABLE f2;
SELECT name FROM sqlite_master;
CREATE VIRTUAL TABLE IF NOT EXISTS g USING fts5(x);
CREATE VIRTUAL TABLE IF NOT EXISTS g USING fts5(x);
CREATE VIRTUAL TABLE g USING fts5(x);
CREATE TABLE log(x);
CREATE TRIGGER tl AFTER INSERT ON log BEGIN INSERT INTO g VALUES (new.x); END;
INSERT INTO log VALUES ('from a trigger');
SELECT rowid FROM g WHERE g MATCH 'trigger';
BEGIN;
INSERT INTO g VALUES ('in a transaction');
INSERT INTO g VALUES ('another one');
SELECT rowid FROM g WHERE g MATCH 'another';
ROLLBACK;
SELECT rowid FROM g WHERE g MATCH 'another';
SELECT count(*) FROM g;
