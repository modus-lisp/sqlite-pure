INSERT INTO t(t) VALUES('rebuild');
SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir ORDER BY level, idx;
SELECT blockid, hex(block) FROM t_segments ORDER BY blockid;
SELECT id, hex(value) FROM t_stat;
SELECT docid, hex(size) FROM t_docsize;

== fts4-deferred
CREATE VIRTUAL TABLE t USING fts4(a);
WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<3000) INSERT INTO t SELECT 'common word' || CASE WHEN i % 100 = 0 THEN ' rare' ELSE '' END || ' filler' || (i % 13) || CASE WHEN i % 250 = 0 THEN ' rarer common' ELSE '' END || CASE WHEN i IN (1234, 2345) THEN ' unique word common' ELSE '' END FROM c;
SELECT level, idx, start_block, leaves_end_block, end_block FROM t_segdir;
SELECT docid, hex(matchinfo(t, 'pcnalxy')), offsets(t), snippet(t) FROM t WHERE t MATCH 'common rare';
SELECT docid, hex(matchinfo(t, 'pcx')) FROM t WHERE t MATCH 'rare common word';
SELECT docid, hex(matchinfo(t, 'pcx')) FROM t WHERE t MATCH '"common word" rare';
SELECT docid, hex(matchinfo(t, 'pcx')) FROM t WHERE t MATCH 'common NEAR rare';
SELECT docid, hex(matchinfo(t, 'pcx')) FROM t WHERE t MATCH 'rarer OR (common rare)';
SELECT docid, hex(matchinfo(t, 'pcx')), offsets(t) FROM t WHERE t MATCH 'common word filler7 rare';
SELECT count(*) FROM t WHERE t MATCH 'common word';
SELECT docid, hex(matchinfo(t, 'pcnalxy')), offsets(t), snippet(t) FROM t WHERE t MATCH 'common unique';
SELECT docid, hex(matchinfo(t, 'pcx')), offsets(t) FROM t WHERE t MATCH 'unique common word';
SELECT docid, hex(matchinfo(t, 'pcx')), offsets(t) FROM t WHERE t MATCH '"word common" unique';
SELECT docid, hex(matchinfo(t, 'pcx')), offsets(t) FROM t WHERE t MATCH 'common NEAR/2 unique';
SELECT docid, hex(matchinfo(t, 'pcx')), offsets(t) FROM t WHERE t MATCH 'unique OR (common unique)';
SELECT docid, hex(matchinfo(t, 'pcxs')), offsets(t) FROM t WHERE t MATCH 'unique word common filler';
SELECT docid, hex(matchinfo(t, 'x')) FROM t WHERE t MATCH 'unique -common';
SELECT docid, hex(matchinfo(t, 'x')) FROM t WHERE t MATCH 'unique NOT rare';


== fts4-aux-tables
CREATE VIRTUAL TABLE t USING fts4(a, b);
INSERT INTO t VALUES('alpha beta alpha', 'gamma');
INSERT INTO t VALUES('beta', 'alpha delta alpha');
INSERT INTO t VALUES('epsilon', NULL);
CREATE VIRTUAL TABLE v USING fts4aux(t);
SELECT * FROM v;
SELECT * FROM v WHERE term = 'alpha';
SELECT * FROM v WHERE term >= 'b' AND term <= 'd';
SELECT * FROM v WHERE term > 'beta';
SELECT term, col, documents, occurrences, languageid FROM v WHERE term < 'c';
DELETE FROM t WHERE docid = 2;
SELECT * FROM v;
CREATE VIRTUAL TABLE v2 USING fts4aux(main, t);
CREATE VIRTUAL TABLE v3 USING fts4aux(nosuch);
SELECT * FROM v3;
INSERT INTO v VALUES('x', 1, 2, 3);
CREATE VIRTUAL TABLE tk USING fts3tokenize(porter);
SELECT token, start, "end", position FROM tk WHERE input = 'Running connections quickly';
SELECT * FROM tk WHERE input = 'a b';
SELECT * FROM tk;
CREATE VIRTUAL TABLE tk2 USING fts3tokenize('unicode61', 'remove_diacritics=0');
SELECT token FROM tk2 WHERE input = 'Café Über';
CREATE VIRTUAL TABLE tk3 USING fts3tokenize(nosuch);
CREATE VIRTUAL TABLE tk4 USING fts3tokenize;
SELECT token FROM tk4 WHERE input = 'Hello, World';

== fts4-rename-drop
CREATE VIRTUAL TABLE t USING fts4(a);
INSERT INTO t VALUES('one two');
ALTER TABLE t RENAME TO u;
SELECT type, name, tbl_name, sql FROM sqlite_master ORDER BY name;
SELECT docid FROM u WHERE u MATCH 'two';
INSERT INTO u VALUES('three');
SELECT docid, snippet(u) FROM u WHERE u MATCH 'three';
DROP TABLE u;
SELECT name FROM sqlite_master;
CREATE VIRTUAL TABLE t3 USING fts3(a);
INSERT INTO t3(t3) VALUES('merge=4,2');
SELECT name FROM sqlite_master ORDER BY name;
ALTER TABLE t3 RENAME TO t4;
SELECT name FROM sqlite_master ORDER BY name;
DROP TABLE t4;
SELECT name FROM sqlite_master;

== fts4-eqp
CREATE VIRTUAL TABLE t USING fts4(a, b);
CREATE VIRTUAL TABLE l USING fts4(a, languageid=lid);
EXPLAIN QUERY PLAN SELECT * FROM t WHERE t MATCH 'x';
EXPLAIN QUERY PLAN SELECT * FROM t WHERE b MATCH 'x';
EXPLAIN QUERY PLAN SELECT * FROM t WHERE docid = 5;
EXPLAIN QUERY PLAN SELECT * FROM t WHERE rowid = 5;
EXPLAIN QUERY PLAN SELECT * FROM t;
EXPLAIN QUERY PLAN SELECT * FROM t WHERE docid > 5;
EXPLAIN QUERY PLAN SELECT * FROM t WHERE docid > 5 AND docid < 10;
EXPLAIN QUERY PLAN SELECT * FROM t WHERE t MATCH 'x' AND docid < 10;
EXPLAIN QUERY PLAN SELECT * FROM t WHERE t MATCH 'x' ORDER BY docid DESC;
EXPLAIN QUERY PLAN SELECT * FROM t ORDER BY docid;
EXPLAIN QUERY PLAN SELECT * FROM t ORDER BY a;
EXPLAIN QUERY PLAN SELECT * FROM l WHERE l MATCH 'x' AND lid = 2;

== fts4-misc
CREATE VIRTUAL TABLE t USING fts4(a);
INSERT INTO t VALUES('one');
SELECT last_insert_rowid(), changes();
INSERT INTO t(docid, a) VALUES(10, 'two');
SELECT last_insert_rowid(), changes();
INSERT INTO t(t) VALUES('optimize');
SELECT last_insert_rowid(), changes();
UPDATE t SET a = 'uno' WHERE docid = 1;
SELECT last_insert_rowid(), changes();
DELETE FROM t WHERE docid > 0;
SELECT last_insert_rowid(), changes();
INSERT INTO t VALUES('x y'), ('y z');
SELECT total_changes() > 0, changes();
INSERT INTO t(a) VALUES('ret') RETURNING docid, a;
SELECT docid, a FROM t WHERE docid IN (11, 13);
SELECT docid FROM t WHERE t MATCH 'y' LIMIT 1 OFFSET 1;
SELECT a, count(*) FROM t GROUP BY a;
SELECT (SELECT count(*) FROM t AS u WHERE u MATCH 'y') AS n;
SELECT docid FROM t WHERE t MATCH 'y' UNION SELECT docid FROM t WHERE t MATCH 'z';
SELECT x.docid, y.docid FROM t AS x, t AS y WHERE x MATCH 'x' AND y MATCH 'z';
CREATE TABLE q(w);
INSERT INTO q VALUES('x'), ('z'), ('nothing');
SELECT w, (SELECT group_concat(docid) FROM t WHERE t MATCH q.w) FROM q;
SELECT w, docid FROM q, t WHERE t MATCH q.w;
VACUUM;
SELECT docid, a FROM t WHERE t MATCH 'y';
INSERT INTO t(t) VALUES('integrity-check');
PRAGMA integrity_check;
INSERT INTO t(docid, a) VALUES(77, 'ret2') RETURNING rowid, docid, a, t, __langid;
INSERT INTO t(rowid, a) VALUES(78, 'ret3') RETURNING rowid, docid, a;
CREATE VIRTUAL TABLE f5 USING fts5(a);
INSERT INTO f5(a) VALUES('x') RETURNING rowid, a;
INSERT INTO f5(rowid, a) VALUES(5, 'x') RETURNING rowid, a;
