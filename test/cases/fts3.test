SELECT hex(matchinfo(t, 'l')) FROM t WHERE t MATCH 'x';

== fts4-transactions
CREATE VIRTUAL TABLE t USING fts4(a);
BEGIN;
INSERT INTO t VALUES('raspberry xi nectarine');
INSERT INTO t VALUES('omega honeydew kappa');
INSERT INTO t VALUES('apple zeta orange');
INSERT INTO t VALUES('honeydew lambda beta');
INSERT INTO t VALUES('kiwi lambda lambda');
INSERT INTO t VALUES('rho watermelon honeydew');
INSERT INTO t VALUES('quince gamma eta');
INSERT INTO t VALUES('mu nu papaya');
INSERT INTO t VALUES('delta iota orange');
INSERT INTO t VALUES('delta sigma kiwi');
SELECT docid FROM t WHERE t MATCH 'alpha';
INSERT INTO t VALUES('x'),('y');
INSERT INTO t VALUES('z');
COMMIT;
SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir ORDER BY level, idx;
SELECT blockid, hex(block) FROM t_segments ORDER BY blockid;
BEGIN;
INSERT INTO t VALUES('q');
ROLLBACK;
SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir ORDER BY level, idx;
SELECT blockid, hex(block) FROM t_segments ORDER BY blockid;
BEGIN;
INSERT INTO t VALUES('q r');
SAVEPOINT s;
INSERT INTO t VALUES('s');
ROLLBACK TO s;
INSERT INTO t VALUES('u');
RELEASE s;
COMMIT;
SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir ORDER BY level, idx;
SELECT blockid, hex(block) FROM t_segments ORDER BY blockid;
SELECT docid, a FROM t WHERE t MATCH 'q OR s OR u';

== fts4-external-content
CREATE TABLE c(x, y);
INSERT INTO c VALUES('red green', 'blue');
INSERT INTO c VALUES('yellow', 'green blue');
CREATE VIRTUAL TABLE t USING fts4(content=c, x, y);
INSERT INTO t(t) VALUES('rebuild');
SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir ORDER BY level, idx;
SELECT blockid, hex(block) FROM t_segments ORDER BY blockid;
SELECT docid, * FROM t WHERE t MATCH 'green';
SELECT docid, snippet(t) FROM t WHERE t MATCH 'blue';
SELECT * FROM t;
CREATE VIRTUAL TABLE t2 USING fts4(content=c);
SELECT sql FROM sqlite_master WHERE name='t2';
INSERT INTO t2(t2) VALUES('rebuild');
SELECT docid, * FROM t2 WHERE t2 MATCH 'yellow';
PRAGMA table_info(t2);
