== fts4-rebuild
CREATE VIRTUAL TABLE t USING fts4(a, b);
INSERT INTO t VALUES('delta zeta epsilon chi iota', 'alpha nu sigma');
INSERT INTO t VALUES('mango alpha phi beta xi', 'phi phi beta');
INSERT INTO t VALUES('honeydew banana chi mu delta', 'cherry gamma zeta');
INSERT INTO t VALUES('chi honeydew banana rho fig', 'alpha beta phi');
INSERT INTO t VALUES('phi delta cherry chi lambda', 'zeta beta kappa');
INSERT INTO t VALUES('xi kappa lemon zeta psi', 'omega date psi');
INSERT INTO t VALUES('mango kappa chi omicron rho', 'grape gamma upsilon');
INSERT INTO t VALUES('fig sigma omega lemon lemon', 'sigma iota rho');
INSERT INTO t VALUES('alpha grape eta omega kappa', 'omicron banana zeta');
INSERT INTO t VALUES('beta iota theta delta mango', 'kiwi xi mu');
