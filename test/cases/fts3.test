== fts3-basics
CREATE VIRTUAL TABLE t USING fts3(a, b);
SELECT type, name, tbl_name, rootpage, sql FROM sqlite_master ORDER BY rowid;
INSERT INTO t VALUES ('hello world', 'the quick brown fox');
INSERT INTO t VALUES ('Hello again', 'lazy dog hello');
INSERT INTO t(docid, a, b) VALUES (10, 'third', 'row');
SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir ORDER BY level, idx;
SELECT docid, * FROM t_content;
SELECT docid, rowid, * FROM t;
SELECT docid, * FROM t WHERE t MATCH 'hello';
SELECT docid FROM t WHERE t MATCH 'HELLO';
SELECT docid FROM t WHERE a MATCH 'hello';
SELECT docid FROM t WHERE b MATCH 'hello';
SELECT docid FROM t WHERE t MATCH 'hello' AND docid > 1;
SELECT docid FROM t WHERE docid = 2;
SELECT docid FROM t WHERE rowid = 10;
SELECT typeof(t), t, __langid FROM t;
DELETE FROM t WHERE docid = 1;
SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir ORDER BY level, idx;
UPDATE t SET a = 'goodbye world' WHERE docid = 2;
SELECT docid, * FROM t ORDER BY docid;
SELECT docid FROM t WHERE t MATCH 'world';
INSERT INTO t(t) VALUES ('integrity-check');
INSERT INTO t(t) VALUES ('optimize');
SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir ORDER BY level, idx;
SELECT docid FROM t WHERE t MATCH 'row OR goodbye';
PRAGMA table_info(t);
PRAGMA table_xinfo(t);
SELECT count(*) FROM t;

== fts4-basics
CREATE VIRTUAL TABLE t USING fts4(title, body);
SELECT type, name, tbl_name, rootpage, sql FROM sqlite_master ORDER BY rowid;
INSERT INTO t VALUES ('SQLite Tutorial', 'SQLite is a small fast reliable database engine');
INSERT INTO t VALUES ('Full-text search', 'the fts4 module provides full text search over documents');
INSERT INTO t VALUES ('Database design', 'normal forms and indexes make a database fast');
INSERT INTO t VALUES ('Search engines', 'a search engine ranks documents by relevance');
INSERT INTO t VALUES ('Fast food', 'not about databases at all but quick meals');
INSERT INTO t VALUES ('Engine room', 'the engine of a ship; the fast engine');
SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir ORDER BY level, idx;
SELECT id, hex(value) FROM t_stat;
SELECT docid, hex(size) FROM t_docsize;
SELECT docid FROM t WHERE t MATCH 'database';
SELECT docid FROM t WHERE t MATCH 'fast AND database';
SELECT docid FROM t WHERE t MATCH 'fast database';
SELECT docid FROM t WHERE t MATCH 'fast OR search';
SELECT docid FROM t WHERE t MATCH 'fast NOT database';
SELECT docid FROM t WHERE t MATCH 'fast OR search NOT engine';
SELECT docid FROM t WHERE t MATCH '(fast OR search) NOT engine';
SELECT docid FROM t WHERE t MATCH 'fast AND search OR engine';
SELECT docid FROM t WHERE t MATCH 'fast AND (search OR engine)';
SELECT docid FROM t WHERE t MATCH '"full text"';
SELECT docid FROM t WHERE t MATCH '"text full"';
SELECT docid FROM t WHERE t MATCH '"the engine"';
SELECT docid FROM t WHERE t MATCH 'data*';
SELECT docid FROM t WHERE t MATCH 'eng*';
SELECT docid FROM t WHERE t MATCH '"fast eng*"';
SELECT docid FROM t WHERE t MATCH 'title:search';
SELECT docid FROM t WHERE t MATCH 'body:search';
SELECT docid FROM t WHERE t MATCH 'title:fast database';
SELECT docid FROM t WHERE t MATCH 'fast NEAR engine';
SELECT docid FROM t WHERE t MATCH 'fast NEAR/2 engine';
SELECT docid FROM t WHERE t MATCH 'ship NEAR/1 engine';
SELECT docid FROM t WHERE t MATCH 'the NEAR/1 engine NEAR/1 fast';
SELECT docid FROM t WHERE t MATCH '^sqlite';
SELECT docid FROM t WHERE t MATCH '^search';
SELECT docid FROM t WHERE t MATCH 'fast -database';
SELECT docid FROM t WHERE t MATCH 'AND fast';
SELECT docid FROM t WHERE t MATCH 'fast OR';
SELECT docid FROM t WHERE t MATCH '"unterminated';
SELECT docid FROM t WHERE t MATCH '(fast';
SELECT docid FROM t WHERE t MATCH 'fast)';
SELECT docid FROM t WHERE t MATCH '';
SELECT docid FROM t WHERE t MATCH NULL;
SELECT docid, snippet(t), offsets(t) FROM t WHERE t MATCH 'fast';
SELECT docid, snippet(t, '[', ']', '...', 1, 4) FROM t WHERE t MATCH 'engine';
SELECT docid, snippet(t, '[', ']', '...', -1, -3) FROM t WHERE t MATCH 'engine';
SELECT docid, hex(matchinfo(t)) FROM t WHERE t MATCH 'fast engine';
SELECT docid, hex(matchinfo(t, 'pcnalsxyb')) FROM t WHERE t MATCH 'fast engine';
SELECT docid, hex(matchinfo(t, 'q')) FROM t WHERE t MATCH 'fast';
SELECT offsets(t) FROM t WHERE t MATCH 'the NEAR/2 engine';
SELECT snippet(t) FROM t;
SELECT optimize(t) FROM t LIMIT 1;
SELECT optimize(t) FROM t LIMIT 1;
SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir ORDER BY level, idx;

== fts4-many-autocommit
CREATE VIRTUAL TABLE t USING fts4(a, b);
INSERT INTO t VALUES ('rho psi watermelon tangerine lemon beta fig pi tangerine delta', 'theta omega');
INSERT INTO t VALUES ('pi apple mango eta orange pi alpha xi', 'sigma mu apple lambda epsilon iota');
INSERT INTO t VALUES ('raspberry elder iota iota alpha alpha xi xi lambda lambda', 'phi nu mango vanilla');
INSERT INTO t VALUES ('xi mu watermelon nu apple upsilon beta omega cherry lambda kappa', 'epsilon chi upsilon quince');
INSERT INTO t VALUES ('alpha quince vanilla chi epsilon upsilon psi upsilon grape watermelon', 'mu grape grape mu delta');
INSERT INTO t VALUES ('beta psi banana beta nectarine', 'omega apple papaya alpha elder gamma');
INSERT INTO t VALUES ('mu raspberry nu theta pi fig psi kiwi psi lemon rho fig', 'papaya');
INSERT INTO t VALUES ('omega tau gamma date zeta xi chi kiwi raspberry omega kappa chi', 'watermelon mango zeta upsilon');
INSERT INTO t VALUES ('phi upsilon mu zeta strawberry kappa watermelon upsilon grape lambda delta', 'quince');
INSERT INTO t VALUES ('banana gamma pi quince psi rho fig tangerine cherry', 'delta strawberry');
INSERT INTO t VALUES ('honeydew', 'xi iota orange iota strawberry');
INSERT INTO t VALUES ('eta lambda date omega kappa delta cherry', 'kappa fig raspberry lambda');
INSERT INTO t VALUES ('fig honeydew watermelon phi grape sigma tau grape banana', 'theta apple');
INSERT INTO t VALUES ('mu strawberry honeydew chi mu zeta honeydew sigma kiwi', 'kiwi omega epsilon psi watermelon papaya ugli gamma');
INSERT INTO t VALUES ('omega nectarine ugli sigma honeydew', 'watermelon tau chi tangerine');
INSERT INTO t VALUES ('papaya alpha grape', 'rho phi ugli sigma fig tau kiwi tangerine');
INSERT INTO t VALUES ('psi psi sigma tangerine psi cherry psi mu watermelon elder omega', 'lemon kappa lemon lambda nu');
INSERT INTO t VALUES ('grape tau watermelon zeta ugli cherry', 'raspberry papaya');
INSERT INTO t VALUES ('ugli cherry upsilon raspberry nectarine strawberry sigma beta nu', 'papaya elder');
INSERT INTO t VALUES ('tangerine mu omicron vanilla mu strawberry gamma grape omicron lambda', '');
INSERT INTO t VALUES ('theta phi mu', 'nu nectarine gamma cherry fig psi apple');
INSERT INTO t VALUES ('raspberry epsilon papaya xi pi omega alpha psi banana sigma cherry', 'watermelon');
INSERT INTO t VALUES ('omega gamma nectarine raspberry upsilon eta tau mango kiwi', 'papaya tau psi iota cherry');
INSERT INTO t VALUES ('orange tangerine mango omega fig kappa lambda', 'orange grape nu iota quince zeta');
INSERT INTO t VALUES ('ugli alpha apple eta phi orange', 'kappa phi strawberry orange apple date date omicron');
INSERT INTO t VALUES ('tau grape apple apple lambda quince quince rho', 'honeydew rho cherry beta');
INSERT INTO t VALUES ('upsilon honeydew tau kappa grape beta', 'ugli');
INSERT INTO t VALUES ('elder pi tau gamma iota banana alpha grape mango nectarine', 'pi grape gamma pi');
INSERT INTO t VALUES ('sigma kappa tau tau honeydew quince grape lemon', 'beta');
INSERT INTO t VALUES ('upsilon tau mango', 'raspberry tau lemon beta fig');
INSERT INTO t VALUES ('omega vanilla papaya iota gamma alpha', 'nectarine fig vanilla eta');
INSERT INTO t VALUES ('mango nu alpha date date quince orange watermelon strawberry tangerine grape', 'grape banana vanilla nu tau fig');
INSERT INTO t VALUES ('upsilon alpha', 'papaya tau tangerine grape upsilon kappa');
INSERT INTO t VALUES ('grape watermelon nectarine', 'chi mango kappa date papaya mango delta');
INSERT INTO t VALUES ('omicron sigma', 'epsilon');
INSERT INTO t VALUES ('beta chi date epsilon banana watermelon honeydew delta theta theta omicron', 'iota');
INSERT INTO t VALUES ('elder kappa mu raspberry mu', 'lambda epsilon raspberry xi gamma nectarine');
INSERT INTO t VALUES ('ugli apple', 'sigma');
INSERT INTO t VALUES ('orange', 'banana');
INSERT INTO t VALUES ('iota alpha date zeta phi vanilla quince honeydew honeydew psi', 'delta iota watermelon tau kappa');
SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir ORDER BY level, idx;
SELECT blockid, hex(block) FROM t_segments ORDER BY blockid;
SELECT id, hex(value) FROM t_stat;
SELECT docid FROM t WHERE t MATCH 'alpha OR omega';
SELECT docid, hex(matchinfo(t, 'pcnalx')) FROM t WHERE t MATCH 'apple beta';
INSERT INTO t(t) VALUES('integrity-check');

