== fts4-bulk-insert-select
CREATE VIRTUAL TABLE t USING fts4(a, b);
WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM c WHERE i<2000) INSERT INTO t SELECT 'w' || (i % 97) || ' x' || (i % 13) || ' common', 'y' || (i*7 % 101) FROM c;
SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir ORDER BY level, idx;
SELECT blockid, hex(block) FROM t_segments ORDER BY blockid;
SELECT count(*) FROM t WHERE t MATCH 'common';
SELECT count(*) FROM t WHERE t MATCH 'w5 x5';
SELECT docid FROM t WHERE t MATCH 'w5 x5' LIMIT 10;
SELECT docid, hex(matchinfo(t, 'x')) FROM t WHERE t MATCH 'w5 x5 common' LIMIT 3;
DELETE FROM t WHERE docid % 3 = 0;
SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir ORDER BY level, idx;
SELECT blockid, hex(block) FROM t_segments ORDER BY blockid;
SELECT count(*) FROM t WHERE t MATCH 'common';
INSERT INTO t(t) VALUES('integrity-check');
INSERT INTO t(t) VALUES('optimize');
SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir ORDER BY level, idx;
SELECT blockid, hex(block) FROM t_segments ORDER BY blockid;

