args: 
.mode quote
SELECT 1.0, 0.1, 1e300, -1e-300, 123456789012345678, 1.5e15, 2.0/3, 100.0, 1e16, 9.999999999999999e22;
.mode json
SELECT 1.0, 0.1, 1e300, 2.0/3, 9e999, -9e999, x'0a';
.mode list
SELECT 1.0, 0.1, 1e300, 2.0/3, 9e999, 1e16, 100.0;
.mode insert
SELECT 1.0, 100.0, 9e999, -9e999, 1e16, 1.5;
