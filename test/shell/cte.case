args: 
WITH i(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM i) SELECT x FROM i LIMIT 10;
WITH i(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM i LIMIT 10) SELECT x FROM i;
WITH RECURSIVE i(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM i WHERE x<5) SELECT a.x, b.x FROM i a, i b WHERE a.x+b.x=6;
WITH i(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM i WHERE x<5) SELECT x, (SELECT count(*) FROM i) FROM i;
WITH i(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM i) SELECT x FROM i WHERE x % 7 = 0 LIMIT 3;
WITH i(x) AS (VALUES(1) UNION ALL SELECT x+1 FROM i WHERE x<3) SELECT * FROM i UNION ALL SELECT * FROM i;
CREATE TABLE t1(a); INSERT INTO t1 VALUES(1);
WITH t1 AS (SELECT * FROM t1) SELECT * FROM t1;
WITH c AS (SELECT * FROM c) SELECT * FROM c;
WITH c(x) AS (SELECT 1 UNION SELECT x FROM c) SELECT * FROM c;
WITH c(x) AS (SELECT 1 UNION ALL SELECT (SELECT x FROM c)) SELECT * FROM c;
WITH c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x < (SELECT max(x) FROM c)) SELECT * FROM c;
WITH c(x) AS (SELECT 1 UNION ALL SELECT a.x+1 FROM c a, c b WHERE a.x<3) SELECT * FROM c;
WITH c(x) AS (SELECT * FROM c UNION ALL SELECT 1) SELECT * FROM c;
WITH c AS (SELECT * FROM c) SELECT 1;
WITH c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM main.c WHERE x<3) SELECT * FROM c;
WITH c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM (SELECT x FROM c) WHERE x<3) SELECT * FROM c;
WITH c(x) AS (SELECT 1 INTERSECT SELECT x+1 FROM c WHERE x<3) SELECT * FROM c;
WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x<3) SELECT * FROM c;
  WITH i(x, y) AS ( VALUES(1) )   SELECT * FROM i;
    WITH i(x) AS ( VALUES(1,2) )   SELECT * FROM i;
    CREATE TABLE t5(a, b);   WITH i(x) AS ( SELECT * FROM t5 )   SELECT * FROM i;
    WITH i(x) AS ( SELECT 1, 2 UNION ALL SELECT 1 )   SELECT * FROM i;
    WITH i(x) AS ( SELECT 1 UNION ALL SELECT 1, 2 )   SELECT * FROM i;
    WITH i(x) AS ( SELECT 1 UNION ALL SELECT x+1, x*2 FROM i )   SELECT * FROM i;
    WITH i(x) AS ( SELECT 1, 2 UNION SELECT x+1 FROM i )   SELECT * FROM i;
 
