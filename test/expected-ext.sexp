("geopoly.test:geopoly-many"
 ("CREATE VIRTUAL TABLE p USING geopoly(tag);" :ok)
 ("CREATE TABLE m(id INTEGER PRIMARY KEY, shape, tag);" :ok)
 ("WITH RECURSIVE r(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM r WHERE i<600) INSERT INTO m SELECT i, geopoly_regular((i * 37) % 100, (i * 53) % 100, 1 + i % 4, 3 + i % 6), 't' || i FROM r;" :ok)
 ("INSERT INTO p(rowid, _shape, tag) SELECT id, shape, tag FROM m;" :ok)
